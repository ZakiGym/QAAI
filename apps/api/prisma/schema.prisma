// QAAI data model.
//
// Tenancy rule (§1): every table that holds customer data carries `orgId` and is
// indexed on it. `apps/api/src/lib/prisma.ts` installs a Prisma extension that
// injects the org filter on every read and stamps it on every write — models are
// NOT trusted to scope themselves. The handful of genuinely global tables
// (User, Session, FeatureFlag, ...) are listed in GLOBAL_MODELS there.

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
// supplied to PrismaClient through a driver adapter (see src/lib/prisma.ts).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — mirror packages/shared/src/constants.ts. Keep in sync; `npm run
// check:enums -w @qaai/api` diffs them and fails CI on drift.
// ─────────────────────────────────────────────────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  TEAM
  BUSINESS
  ENTERPRISE
}

/// Dunning (§9). Mirrored as a union type in packages/shared/src/types.ts —
/// `check:enums` diffs them. PAST_DUE is set by `invoice.payment_failed` and
/// cleared by `invoice.paid`; deliberately, NOTHING gates on it yet. Whether a
/// past-due org keeps its paid limits is a policy decision (lib/plan.ts already
/// meters a `past_due` Stripe status at FREE limits), not a schema one.
enum BillingState {
  OK
  PAST_DUE
}

enum EnvironmentKind {
  LOCAL
  PREVIEW
  STAGING
  PRODUCTION
}

/// Which SSO protocol a connection speaks. No @qaai/shared twin on purpose —
/// the TypeScript union lives in `src/lib/sso.ts` next to the code that reads
/// it, so there is nothing for `check:enums` to drift against.
enum SsoProtocol {
  SAML
  OIDC
}

/// How QAAI signs in. Mirrors AUTH_PROFILE_KINDS in
/// packages/shared/src/constants.ts; `check:enums` diffs them.
///
/// The last three are this round's. Five existed and
/// `signInWithProfile` honoured THREE — MAGIC_LINK and TOTP_MFA were storable
/// and unperformable, and the endpoint answered "not built yet" — so an
/// application whose only way in is harder than a form had zero enumerable
/// authenticated surface. `AUTH_PROFILE_CONFIG_SCHEMAS`,
/// `AUTH_PROFILE_CAPABILITIES` and `AUTH_PROFILE_KIND_LABELS` in
/// packages/shared/src/auth-profiles.ts are each keyed on this union, so a
/// ninth member cannot ship storable-but-unperformable again.
///
/// TOTP_MFA is deliberately NOT renamed to TOTP: renaming a stored enum member
/// is a data migration over every profile row, bought for four characters.
enum AuthProfileKind {
  FORM_LOGIN
  MAGIC_LINK
  SSO_BYPASS_TOKEN
  COOKIE_INJECTION
  TOTP_MFA
  PASSKEY
  PHONE_OTP
  MOCK_IDP
}

/// MAY THIS IDENTITY BE DAMAGED? Mirrors PRINCIPAL_KINDS in
/// packages/shared/src/principals.ts.
///
/// ── Why this column exists ──────────────────────────────────────────────────
///
/// Logout, session expiry, password reset, email verification and lockout — the
/// highest-risk flows any application has — were skip-listed, and `/logout` was
/// on a literal skip list. The reason was sound: there is ONE shared account,
/// and driving any of those against it destroys the only way in. So the most
/// dangerous flows in the product were the only ones never tested.
///
/// This column is what makes them testable. A scenario may destroy a
/// DISPOSABLE principal and may never touch a PERSISTENT one, and
/// `proveDisposable` in principals.ts is the only way to obtain a value the
/// type system will let a destructive step accept.
///
/// ── Why three members and not a boolean ────────────────────────────────────
///
/// ANONYMOUS has no account to destroy, so both booleans are lies about it:
/// false reads as "the customer's precious account" and true as "go ahead".
/// Logging out an anonymous principal is not a refused destructive step, it is
/// not a destructive step, and collapsing that distinction puts an
/// unexercisable surface in the same bucket as an exercisable one.
enum PrincipalKind {
  PERSISTENT
  DISPOSABLE
  ANONYMOUS
}

/// WHERE A PRINCIPAL IS IN ITS LIFE. Mirrors PRINCIPAL_LIFECYCLES in
/// packages/shared/src/principals.ts.
///
/// Ten members, and three of them exist purely to stop a lie:
///
///   · PROVISION_FAILED is not DECLARED. A signup that could not complete is a
///     check that did not happen; a principal still waiting to be created is a
///     check that has not happened yet. Recording the first as the second makes
///     a broken signup flow look like a queue.
///   · DESTRUCTION_REFUSED is not ACTIVE. When disposability cannot be proved
///     the principal is intact — but the scenario did NOT RUN, and an intact
///     principal recorded as ACTIVE is a surface silently absent from the
///     report.
///   · UNAVAILABLE is not PROVISION_FAILED. Bot protection in front of the
///     signup form is neither the application's fault nor ours; it is a
///     configuration the customer can fix, and it carries a different remedy.
enum PrincipalLifecycle {
  DECLARED
  PROVISIONING
  PROVISION_FAILED
  ACTIVE
  SIGNED_OUT
  SESSION_EXPIRED
  LOCKED_OUT
  DESTROYED
  DESTRUCTION_REFUSED
  UNAVAILABLE
}

/// What one role got when it asked for one route. Mirrors
/// ROUTE_ACCESS_OUTCOMES in packages/shared/src/auth-profiles.ts.
///
/// A REFINEMENT of `ACCESS_OUTCOMES` in flow-map.ts and not a restatement of
/// it: four coarse outcomes are the right grain for walking a graph and the
/// wrong grain for a row somebody queries, because "which routes 403 for a
/// member" and "which routes 404 for a member" are both DENIED there and are
/// different facts here — a 404 hides a resource, a 403 confirms it exists.
/// `ACCESS_OUTCOME_TO_ROUTE_ACCESS` states the correspondence under the
/// compiler's supervision.
///
/// NOT_PROBED is the honesty value: nobody asked. The column carrying it has
/// NO DEFAULT for that reason — see RouteAccessCell.outcome.
enum RouteAccessOutcome {
  ALLOWED
  FORBIDDEN
  REDIRECTED_TO_LOGIN
  REDIRECTED_ELSEWHERE
  NOT_FOUND
  ERRORED
  NOT_PROBED
}

/// Whether we asked, or a source told us. Mirrors ROUTE_ACCESS_BASES, which is
/// in turn pinned to `RouteAccess['basis']` in flow-map.ts by a presence
/// record the compiler enforces.
///
/// Not interchangeable, and the difference is the product: a DECLARED
/// restriction the application does not actually enforce is the defect, and
/// counting a declaration as a measurement is how "we checked" gets said about
/// a check nobody ran.
enum RouteAccessBasis {
  OBSERVED
  DECLARED
}

/// What became of the attempt to enumerate as one role. Mirrors
/// ROLE_CRAWL_OUTCOMES in packages/shared/src/auth-profiles.ts.
///
/// This enum exists to stop one sentence: "the admin crawl found no routes a
/// member cannot see." That is a finding if the admin crawl RAN and a
/// fabrication if the admin login FAILED, and both produce zero rows. Zero
/// rows is the most dangerous output this product has, so the attempt is
/// stored and `roleHadNoExtraSurface` returns NULL unless it succeeded.
///
/// LOGIN_UNAVAILABLE is ours to fix (no adapter for the kind); LOGIN_FAILED is
/// theirs (wrong credential, stale success locator). Opposite facts.
enum RoleCrawlOutcome {
  NEVER_ATTEMPTED
  LOGIN_UNAVAILABLE
  LOGIN_FAILED
  UNREACHABLE_BEHIND_BOT_PROTECTION
  SKIPPED_BY_POLICY
  CRAWLED_PARTIAL
  CRAWLED
}

/// What is standing in front of the login form. Mirrors
/// BOT_PROTECTION_PROVIDERS in packages/shared/src/auth-profiles.ts.
///
/// Named providers and not a boolean, because the legitimate route in differs
/// per provider — reCAPTCHA and Turnstile publish a test-key mode, a WAF wants
/// an allowlist instead — and a customer who picks theirs gets the exact
/// remedy. UNKNOWN means a challenge was observed and not attributed, which is
/// emphatically NOT `NONE`: NONE is a claim that nothing is in the way.
enum BotProtectionProvider {
  NONE
  RECAPTCHA
  HCAPTCHA
  TURNSTILE
  WAF
  OTHER
  UNKNOWN
}

/// The three legitimate ways past a challenge, and the fourth state that is
/// not one. Mirrors BOT_BYPASS_MODES in packages/shared/src/auth-profiles.ts.
///
/// Every member is an action the OWNER of the environment took on their own
/// system: their test keys on their own non-production site, their signed
/// header accepted by their own edge, their allowlist. There is no solver and
/// there must never be a fifth member that is one.
///
/// NOT_CONFIGURED is the default and is what produces
/// UNREACHABLE_BEHIND_BOT_PROTECTION — a state rather than an absence, because
/// a null here would render as "no bot protection", which is the opposite of
/// true and leaves a customer staring at zero coverage with no reason beside
/// it.
enum BotBypassMode {
  NOT_CONFIGURED
  PROVIDER_TEST_KEYS
  SIGNED_BYPASS_HEADER
  ALLOWLISTED_BY_CUSTOMER
}

/// Whether an environment can be reached at all. Mirrors
/// ENVIRONMENT_REACHABILITIES in packages/shared/src/auth-profiles.ts.
///
/// NOT_PROBED must never render as REACHABLE: an environment presumed
/// reachable is an environment whose zero coverage looks like a testing failure
/// instead of an access problem. Deliberately narrow — a box that is simply
/// down is `ENVIRONMENT_UNAVAILABLE_PREFIX` on Run.errorMessage, and folding
/// the two would make "your WAF blocked us" and "your staging server is off"
/// the same sentence.
enum EnvironmentReachability {
  REACHABLE
  UNREACHABLE_BEHIND_BOT_PROTECTION
  NOT_PROBED
}

/// What can cause the surface to be enumerated again. Mirrors
/// RE_ENUMERATION_TRIGGER_KINDS in packages/shared/src/constants.ts.
///
/// The only trigger that exists today is a human clicking a button. Schedule
/// and Monitor can each only run a SUITE, so the denominator goes stale on its
/// own and the coverage percentage RISES when the application grows — the
/// numerator is unchanged and the denominator is the one we measured in March.
/// It fails silently and in the flattering direction, which is the worst
/// failure available to a product whose claim is the denominator.
enum ReEnumerationTriggerKind {
  SCHEDULE
  CI
  DEPLOY
  MANUAL
}

/// How a trigger's last run went. Mirrors RE_ENUMERATION_RUN_STATES in
/// packages/shared/src/constants.ts.
///
/// NEVER_RUN is the default on insert, and that is the whole reason this is an
/// enum and not a nullable timestamp: a trigger that has never fired must read
/// as NEVER_RUN and never as "no drift". A dashboard that renders a null
/// `lastRunAt` as a clean bill of health is the exact lie.
enum ReEnumerationRunState {
  NEVER_RUN
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// Whether two crawls could be compared at all. Mirrors
/// SURFACE_DRIFT_COMPARABILITIES in packages/shared/src/constants.ts.
///
/// `FlowMap.version` exists, the cockpit implies versions are diffed, and no
/// diff code exists anywhere in the repo — so four new routes with zero tests
/// produce no event at all. Three of these four members are ways for "no
/// drift" to be UNSAYABLE, and only COMPARABLE makes the counts mean anything
/// (`driftCountsAreMeaningful`). Everything else reports the reason instead of
/// a zero.
enum SurfaceDriftComparability {
  COMPARABLE
  UNCOMPARABLE_NO_BASELINE
  UNCOMPARABLE_BASELINE_NOT_ACCEPTED
  NOT_COMPARED
}

enum TestType {
  E2E
  SMOKE
  INTEGRATION
  API
  VISUAL
  ACCESSIBILITY
  LOAD
  SECURITY_SMOKE
  UNIT_GEN
  CROSS_BROWSER
  LOCALIZATION
  EMAIL_OTP
  DATABASE
  CLI
  PROTOCOL
  CONTRACT
  MUTATION
  MOBILE
  PERFORMANCE
}

enum Priority {
  CRITICAL_PATH
  IMPORTANT
  NICE_TO_HAVE
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
  ERRORED
}

enum RunTrigger {
  MANUAL
  SCHEDULE
  CI
  WEBHOOK
  MONITOR
}

/// Lifecycle of one shard of a sharded run. Deliberately not RunStatus: a shard
/// does not pass or fail — it either executed its slice or it did not, and the
/// pass/fail verdict belongs to the run that aggregates them.
///
/// ABANDONED is the one that matters: it means a worker died holding this slice
/// and the tests in it never ran. A run containing one can never report PASSED.
enum RunShardStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ABANDONED
}

/// Lifecycle of one unit of work offered to an on-prem runner agent (ENTERPRISE).
///
/// Deliberately not RunShardStatus even though the lease machinery underneath is
/// the same one: a shard is held by OUR worker and dies with our process, while
/// this is held by a process inside a customer's network that we cannot see,
/// cannot signal and cannot kill. The two extra members are the whole difference.
///
/// SKIPPED means nothing in the org's pool could serve the job — a browser, a
/// toolchain or the agent itself is missing. It is never FAILED: no part of the
/// customer's application was exercised, so red would be a lie and green would
/// be a worse one.
///
/// ABANDONED means a runner took the job and stopped breathing. The tests in it
/// did not run, so a run containing one can never report PASSED.
enum RunnerJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ABANDONED
  SKIPPED
}

enum TestResultStatus {
  PASSED
  FAILED
  SKIPPED
  FLAKY
  TIMED_OUT
}

enum StepStatus {
  PASSED
  FAILED
  SKIPPED
}

/// Why a result exists with nothing measured in it (NOT_RUN_KINDS in
/// packages/shared/src/constants.ts; `check:enums` diffs them).
///
/// There was one SKIPPED, and four completely different facts were filed under
/// it: a placeholder row nobody reached, a test this deployment has no tool to
/// execute, a test whose environment was broken, and a run somebody cancelled.
/// A reader could not tell "nobody has written this yet" from "this cannot run
/// here", so the skipped count answered no question at all.
///
/// NOT a widening of TestResultStatus, deliberately. The status column is read
/// by the gate, the five counters, the CLI's exit code, the GitHub check, the
/// JUnit writer and the coverage pass; a sixth member there would quietly
/// change what every one of them means by a skip. The status stays SKIPPED and
/// the REASON is its own nullable column, which is purely additive.
///
///   NOT_RUN        nothing was attempted and nothing says it could not be — a
///                  dead shard, a lost queue job, a worker killed mid-suite.
///                  The WEAKEST claim of the four, and still a claim.
///   BLOCKED_BY_ENV the ENVIRONMENT was not usable: the base URL did not
///                  answer, the configured login no longer works, there was no
///                  repository checkout. Not a verdict on the application.
///   UNSUPPORTED    this DEPLOYMENT cannot execute this test — no plugin for
///                  the type, or the tool it needs is not on this image.
///   CANCELLED      a person stopped the run. The only one of the four that is
///                  a decision rather than a fault.
enum NotRunKind {
  NOT_RUN
  BLOCKED_BY_ENV
  UNSUPPORTED
  CANCELLED
}

enum Verdict {
  REAL_BUG
  INTENDED_CHANGE
  FLAKE
  ENV_ISSUE
}

enum VerdictReviewState {
  PENDING
  ACCEPTED
  OVERRIDDEN
  MUTED
}

enum HealRisk {
  SELECTOR_ONLY
  ASSERTION_CHANGE
  STRUCTURAL
  /// "This test should stop existing." Not a patch: a RETIRE proposal carries no
  /// diff at all (see HealProposal.diff) and is applied by DISABLING the test,
  /// never by deleting the customer's code. It can only ever be reviewed by a
  /// person — `isAutoApprovable` in packages/agent/src/healer.ts refuses every
  /// risk level but SELECTOR_ONLY, and refuses this one by name as well, because
  /// the one mistake that is unrecoverable here is retiring a test that was
  /// merely unreached.
  RETIRE
}

enum HealState {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
  AUTO_APPLIED
  /// Replaced by a newer open proposal for the SAME TEST.
  ///
  /// The idempotence guard on healing used to be per TestResult, so a test that
  /// failed every run minted a fresh strong-model proposal every run and could
  /// fill the review queue by itself — fifty rows describing one broken test,
  /// forty-nine of them against code that had already moved on. Superseding is
  /// how the queue stays one-row-per-test: the newest proposal is the only open
  /// one, and the old rows keep their diffs and their reasons so the history of
  /// what was proposed is not rewritten.
  SUPERSEDED
}

