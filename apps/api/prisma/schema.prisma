// QAAI data model.
//
// Tenancy rule (§1): every table that holds customer data carries `orgId` and is
// indexed on it. `apps/api/src/lib/prisma.ts` installs a Prisma extension that
// injects the org filter on every read and stamps it on every write — models are
// NOT trusted to scope themselves. The handful of genuinely global tables
// (User, Session, FeatureFlag, ...) are listed in GLOBAL_MODELS there.

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
// supplied to PrismaClient through a driver adapter (see src/lib/prisma.ts).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — mirror packages/shared/src/constants.ts. Keep in sync; `npm run
// check:enums -w @qaai/api` diffs them and fails CI on drift.
// ─────────────────────────────────────────────────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  TEAM
  BUSINESS
  ENTERPRISE
}

/// Dunning (§9). Mirrored as a union type in packages/shared/src/types.ts —
/// `check:enums` diffs them. PAST_DUE is set by `invoice.payment_failed` and
/// cleared by `invoice.paid`; deliberately, NOTHING gates on it yet. Whether a
/// past-due org keeps its paid limits is a policy decision (lib/plan.ts already
/// meters a `past_due` Stripe status at FREE limits), not a schema one.
enum BillingState {
  OK
  PAST_DUE
}

enum EnvironmentKind {
  LOCAL
  PREVIEW
  STAGING
  PRODUCTION
}

/// Which SSO protocol a connection speaks. No @qaai/shared twin on purpose —
/// the TypeScript union lives in `src/lib/sso.ts` next to the code that reads
/// it, so there is nothing for `check:enums` to drift against.
enum SsoProtocol {
  SAML
  OIDC
}

enum AuthProfileKind {
  FORM_LOGIN
  MAGIC_LINK
  SSO_BYPASS_TOKEN
  COOKIE_INJECTION
  TOTP_MFA
}

enum TestType {
  E2E
  SMOKE
  INTEGRATION
  API
  VISUAL
  ACCESSIBILITY
  LOAD
  SECURITY_SMOKE
  UNIT_GEN
  CROSS_BROWSER
  LOCALIZATION
  EMAIL_OTP
  DATABASE
  CLI
  PROTOCOL
  CONTRACT
  MUTATION
  MOBILE
  PERFORMANCE
}

enum Priority {
  CRITICAL_PATH
  IMPORTANT
  NICE_TO_HAVE
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
  ERRORED
}

enum RunTrigger {
  MANUAL
  SCHEDULE
  CI
  WEBHOOK
  MONITOR
}

/// Lifecycle of one shard of a sharded run. Deliberately not RunStatus: a shard
/// does not pass or fail — it either executed its slice or it did not, and the
/// pass/fail verdict belongs to the run that aggregates them.
///
/// ABANDONED is the one that matters: it means a worker died holding this slice
/// and the tests in it never ran. A run containing one can never report PASSED.
enum RunShardStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ABANDONED
}

/// Lifecycle of one unit of work offered to an on-prem runner agent (ENTERPRISE).
///
/// Deliberately not RunShardStatus even though the lease machinery underneath is
/// the same one: a shard is held by OUR worker and dies with our process, while
/// this is held by a process inside a customer's network that we cannot see,
/// cannot signal and cannot kill. The two extra members are the whole difference.
///
/// SKIPPED means nothing in the org's pool could serve the job — a browser, a
/// toolchain or the agent itself is missing. It is never FAILED: no part of the
/// customer's application was exercised, so red would be a lie and green would
/// be a worse one.
///
/// ABANDONED means a runner took the job and stopped breathing. The tests in it
/// did not run, so a run containing one can never report PASSED.
enum RunnerJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ABANDONED
  SKIPPED
}

enum TestResultStatus {
  PASSED
  FAILED
  SKIPPED
  FLAKY
  TIMED_OUT
}

enum StepStatus {
  PASSED
  FAILED
  SKIPPED
}

enum Verdict {
  REAL_BUG
  INTENDED_CHANGE
  FLAKE
  ENV_ISSUE
}

enum VerdictReviewState {
  PENDING
  ACCEPTED
  OVERRIDDEN
  MUTED
}

enum HealRisk {
  SELECTOR_ONLY
  ASSERTION_CHANGE
  STRUCTURAL
}

enum HealState {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
  AUTO_APPLIED
}

enum Language {
  TYPESCRIPT
  JAVASCRIPT
  JAVA
  PYTHON
  CSHARP
  RUBY
  KOTLIN
  GO
  PHP
}

enum UiFramework {
  PLAYWRIGHT
  CYPRESS
  WEBDRIVERIO
  PUPPETEER
  NIGHTWATCH
  TESTCAFE
  SELENIUM
  CAPYBARA
  PANTHER
  CODECEPTION
  CHROMEDP
  APPIUM
  MAESTRO
  DETOX
  ESPRESSO
  XCUITEST
}

enum FindingKind {
  ACCESSIBILITY
  SECURITY
  PERFORMANCE
  LOCALIZATION
  VISUAL
}

enum FindingSeverity {
  CRITICAL
  SERIOUS
  MODERATE
  MINOR
}

enum AgentKind {
  EXPLORER
  GENERATOR
  TRIAGE
  HEALER
  CHAT
}

enum IntegrationKind {
  GITHUB
  GITLAB
  BITBUCKET
  // Cloud browser grids — where a run's browser actually executes (§6).
  BROWSERSTACK
  SAUCE_LABS
  LAMBDATEST
  PERFECTO
  // Managed visual-diff services, as an alternative to QAAI's own baselines.
  APPLITOOLS
  PERCY
  CHROMATIC
  SLACK
  MSTEAMS
  DISCORD
  JIRA
  LINEAR
  PAGERDUTY
  WEBHOOK
}

enum PlanItemState {
  PROPOSED
  APPROVED
  REJECTED
  GENERATED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity (§1)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String
  /// Null for users who only ever signed in with OAuth.
  passwordHash   String?
  avatarUrl      String?
  /// §11 — grants access to /admin. Never settable through the public API.
  isSuperuser    Boolean   @default(false)
  /// Encrypted TOTP seed (§1 2FA). Null until the user enrols.
  totpSecretEnc  String?
  totpEnabledAt  DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships    Membership[]
  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  auditLogs      AuditLog[]
  chatMessages   ChatMessage[]

  teamMemberships TeamMember[]
  ownedRules      OwnershipRule[]

  @@index([email])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google" | "github"
  providerAccountId String
  accessTokenEnc    String?
  refreshTokenEnc   String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash    String   @unique
  /// The org this session is currently acting in; switchable without re-login.
  activeOrgId  String?
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Email verification and password reset both use this table, discriminated by `purpose`.
model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  purpose   String // "EMAIL_VERIFY" | "PASSWORD_RESET" | "INVITE"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organizations (§1)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  /// Per-org overrides on top of PLAN_LIMITS; used for trials and enterprise deals.
  limitOverrides Json?
  /// Record-and-notify only (§9 dunning) — see the BillingState doc comment.
  billingState BillingState @default(OK)
  /// Stripe's clock (`event.created`) for the LAST invoice event applied. The
  /// ordering guard for dunning: an invoice.payment_failed that is older than
  /// the invoice.paid already applied must not mark a healthy org PAST_DUE.
  /// Same single-clock rule as Subscription.planSyncedAt, for the same reason.
  billingStateAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  invites       Invite[]
  projects      Project[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  usageRecords  UsageRecord[]
  agentCalls    AgentCall[]
  integrations  Integration[]
  featureFlags  FeatureFlagOverride[]
  ssoConnections SsoConnection[]
  runners       Runner[]

  @@index([slug])
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invite {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  role      OrgRole  @default(MEMBER)
  tokenHash String   @unique
  invitedBy String
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
}

/// API keys and personal access tokens (§1). `userId` set = PAT, null = org key.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  userId     String?
  name       String
  /// SHA-256 of the full key. Only the prefix is recoverable for display.
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([keyPrefix])
}

/// §1 — every mutating action. Append-only; there is no update or delete path.
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  /// "project.create", "secret.update", "verdict.override", ...
  action     String
  targetType String
  targetId   String?
  /// Diff or payload summary, already secret-masked.
  metadata   Json?
  ip         String?
  userAgent  String?
  requestId  String?
  /// Set when a superuser was impersonating (§11).
  impersonatedBy String?
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, action])
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects & environments (§2)
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id               String      @id @default(cuid())
  orgId            String
  name             String
  slug             String
  repoUrl          String?
  /// Owner/name, set when the GitHub App is installed on the repo.
  repoFullName     String?
  repoInstallationId String?
  defaultBranch    String      @default("main")
  primaryLanguage  Language    @default(TYPESCRIPT)
  primaryFramework UiFramework @default(PLAYWRIGHT)
  /// GateRule[] — see packages/shared types.
  gateRules        Json        @default("[]")
  /// Org-level opt-in to auto-approving SELECTOR_ONLY heals (§3.4).
  autoApproveSelectorHeals Boolean @default(false)
  archivedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  environments  Environment[]
  suites        Suite[]
  tests         Test[]
  runs          Run[]
  flowMaps      FlowMap[]
  testPlans     TestPlan[]
  schedules     Schedule[]
  monitors      Monitor[]
  conversations ChatConversation[]
  baselines     VisualBaseline[]

  ownershipRules OwnershipRule[]
  triageBatches  TriageBatch[]
  digest         DigestSubscription?

  @@unique([orgId, slug])
  @@index([orgId])
}

model Environment {
  id        String          @id @default(cuid())
  orgId     String
  projectId String
  name      String
  kind      EnvironmentKind
  baseUrl   String
  /// The on-prem runner pool this environment executes on, or null for the
  /// cloud worker (ENTERPRISE). This is THE switch: a staging environment that
  /// never faces the internet cannot be reached from our infrastructure at all,
  /// so a run against it must be handed to an agent inside the customer's
  /// network instead of being enqueued on our own queue. See Run.runnerPool.
  runnerPool String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets      Secret[]
  authProfiles AuthProfile[]
  runs         Run[]
  flowMaps     FlowMap[]
  schedules    Schedule[]
  monitors     Monitor[]

  @@unique([projectId, name])
  @@index([orgId])
}

/// §1 secrets vault. `valueEnc` is AES-256-GCM; see apps/api/src/lib/vault.ts.
model Secret {
  id            String   @id @default(cuid())
  orgId         String
  environmentId String
  name          String
  valueEnc      String
  /// Key version, so the master key can be rotated without a big-bang re-encrypt.
  keyVersion    Int      @default(1)
  /// Last 4 chars of the plaintext, for "is this the right value?" without decrypting.
  hint          String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, name])
  @@index([orgId])
}

model AuthProfile {
  id            String          @id @default(cuid())
  orgId         String
  environmentId String
  name          String
  kind          AuthProfileKind
  /// Non-secret config; secret-bearing fields reference Secret.name.
  config        Json
  /// Cached Playwright storageState, refreshed on expiry (§2).
  storageState  Json?
  storageStateExpiresAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, name])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Flow map & plan (§3.1)
// ─────────────────────────────────────────────────────────────────────────────

model FlowMap {
  id            String   @id @default(cuid())
  orgId         String
  projectId     String
  environmentId String
  version       Int
  /// Serialised FlowMap from packages/shared. Kept whole rather than normalised:
  /// it is written once per crawl, read as a unit, and diffed version-to-version.
  graph         Json
  nodeCount     Int      @default(0)
  edgeCount     Int      @default(0)
  journeyCount  Int      @default(0)
  truncatedReason String?
  createdAt     DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  testPlans   TestPlan[]

  @@unique([projectId, environmentId, version])
  @@index([orgId])
}

model TestPlan {
  id          String   @id @default(cuid())
  orgId       String
  projectId   String
  flowMapId   String?
  summary     String
  skipped     Json     @default("[]")
  createdAt   DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flowMap FlowMap?   @relation(fields: [flowMapId], references: [id], onDelete: SetNull)
  items   PlanItem[]

  @@index([orgId, projectId])
}

model PlanItem {
  id            String        @id @default(cuid())
  orgId         String
  testPlanId    String
  title         String
  rationale     String
  feature       String
  priority      Priority
  testType      TestType
  steps         Json // string[]
  assertions    Json // string[]
  journeyId     String?
  authProfileId String?
  state         PlanItemState @default(PROPOSED)
  decidedBy     String?
  decidedAt     DateTime?
  /// Set once the Generator turns this into a Test.
  generatedTestId String?
  createdAt     DateTime      @default(now())

  testPlan TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([testPlanId, state])
}

// ─────────────────────────────────────────────────────────────────────────────
// Suites & tests
// ─────────────────────────────────────────────────────────────────────────────

model Suite {
  id          String   @id @default(cuid())
  orgId       String
  projectId   String
  name        String
  description String?
  /// Tests are also selectable by tag; a suite is a saved selection.
  tagFilter   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tests     Test[]
  runs      Run[]
  schedules Schedule[]
  monitors  Monitor[]

  ownershipRules OwnershipRule[]

  @@unique([projectId, name])
  @@index([orgId])
}

model Test {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  suiteId   String?
  name      String
  type      TestType
  feature   String?
  priority  Priority @default(IMPORTANT)
  /// Current source. History lives in TestVersion.
  code      String
  filePath  String
  /// Type-specific config: the API request chain, the k6 thresholds, the viewports.
  spec      Json?
  tags      String[] @default([])
  timeoutMs Int      @default(60000)

  /// Flake radar (§5). Maintained by the run finaliser, not computed on read.
  quarantined      Boolean   @default(false)
  quarantinedAt    DateTime?
  quarantineReason String?
  flakeRate        Float     @default(0)
  lastRunAt        DateTime?
  consecutiveFailures Int    @default(0)

  /// Selectors the Generator was unsure about; the cockpit shows a review badge.
  reviewFlags String[] @default([])
  /// Which plan item produced this, when it came from the Explorer.
  planItemId  String?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite    Suite?        @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  versions TestVersion[]
  results  TestResult[]
  heals    HealProposal[]
  baselines VisualBaseline[]

  ownershipRules OwnershipRule[]

  @@index([orgId])
  @@index([projectId, type])
  @@index([suiteId])
}

/// Every code change to a test, whether from a human, the Generator, or a Heal.
model TestVersion {
  id        String   @id @default(cuid())
  orgId     String
  testId    String
  version   Int
  code      String
  /// "GENERATOR" | "HEAL" | "HUMAN" | "IMPORT"
  source    String
  authorId  String?
  message   String?
  createdAt DateTime @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, version])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Runs (§5)
// ─────────────────────────────────────────────────────────────────────────────

model Run {
  id            String     @id @default(cuid())
  orgId         String
  projectId     String
  suiteId       String?
  environmentId String
  status        RunStatus  @default(QUEUED)
  trigger       RunTrigger @default(MANUAL)
  triggeredBy   String?

  /// CI context, when the run came from a PR or a deploy.
  commitSha     String?
  branch        String?
  prNumber      Int?
  /// Preview-deploy runs override the environment's base URL (§6).
  baseUrlOverride String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  totalCount   Int @default(0)
  passedCount  Int @default(0)
  failedCount  Int @default(0)
  flakyCount   Int @default(0)
  skippedCount Int @default(0)

  /// GateResult from packages/shared. Null until the run finalises.
  gateResult Json?
  /// Set when the run itself blew up rather than tests failing.
  errorMessage String?

  /// How many shards the suite was split across (§5 build sharding). 1 means the
  /// run was not sharded, which is every run unless the caller asked for more.
  shardCount Int @default(1)
  /// The finalisation claim. Set by a conditional UPDATE, so exactly one shard
  /// can win it and write the run's terminal status; see apps/worker run.ts.
  /// Distinct from `finishedAt`, which the cancel endpoint also writes.
  finalizedAt DateTime?

  /// §5 fail-fast: stop at the first real failure. Written when the run is
  /// created, polled by the worker between tests.
  ///
  /// A column rather than a queue message or a Redis flag, because a sharded run
  /// must have exactly one source of truth about whether it should still be
  /// running. Five workers polling one row is how cancellation already works;
  /// inventing a second channel for the same idea is how two shards come to
  /// disagree about whether the run is over.
  failFast Boolean @default(false)
  /// Stamped the moment something decides this run should stop early: the worker
  /// on the first real failure of a fail-fast run, or a human pressing stop.
  ///
  /// Deliberately NOT `status = CANCELLED`. A fail-fast stop is a FAILED run
  /// that chose not to finish, and filing it as cancelled would hide a broken
  /// build behind a word that means "nobody wanted the answer".
  stopRequestedAt DateTime?
  /// Why it stopped, in a sentence the run page can show verbatim — which test
  /// tripped it, or who pressed stop.
  stopReason String?

  /// Copied from Environment.runnerPool when the run is created, and the reason
  /// this column exists rather than being read through the relation: it is the
  /// record of where this run was DISPATCHED, which must not change under it if
  /// someone edits the environment mid-run.
  ///
  /// Non-null means the run was handed to the customer's own agents and NO job
  /// was enqueued on our queue. Exactly one of the two dispatch paths runs a
  /// given run — that is what stops a suite executing twice, once in each place.
  runnerPool String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite?       @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  environment Environment  @relation(fields: [environmentId], references: [id])
  results     TestResult[]
  artifacts   Artifact[]
  shards      RunShard[]
  runnerJobs  RunnerJob[]

  @@index([orgId])
  @@index([projectId, queuedAt])
  @@index([status])
  @@index([commitSha])
}

/// One slice of a sharded run: its own queue job, its own worker, its own tests.
///
/// A sharded run finishes only when every one of these rows is terminal — the
/// row is the durable record of that, because the worker holding a shard can
/// die and nothing in Redis would tell the other shards whether it ever ran.
model RunShard {
  id     String         @id @default(cuid())
  orgId  String
  runId  String
  /// 0-based, and matches TestResult.shardIndex.
  index  Int
  /// Denormalised sibling count so a shard knows the split it belongs to.
  total  Int
  status RunShardStatus @default(QUEUED)

  /// What the duration-balanced packer put here, and what it predicted. Kept so
  /// "why did shard 3 take twice as long" is answerable after the fact.
  testCount   Int @default(0)
  estimatedMs Int @default(0)

  passedCount  Int @default(0)
  failedCount  Int @default(0)
  flakyCount   Int @default(0)
  skippedCount Int @default(0)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  /// Stamped on a timer while the shard executes. A worker that dies stops
  /// stamping, which is how the surviving shards notice and reap it instead of
  /// leaving the run open forever.
  heartbeatAt DateTime?

  errorMessage String?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([orgId])
  @@index([runId, status])
}

model TestResult {
  id         String           @id @default(cuid())
  orgId      String
  runId      String
  testId     String
  status     TestResultStatus
  durationMs Int              @default(0)
  errorMessage String?
  /// §5 — a retry that passes is not a pass. Recorded so the gate can see it.
  retriedAndPassed Boolean    @default(false)
  /// NetworkEntry[] and ConsoleEntry[], already secret-masked.
  network    Json?
  consoleLog Json?
  videoKey   String?
  traceKey   String?
  createdAt  DateTime         @default(now())
  /// Which shard of a sharded run owns this test. Null on an unsharded run,
  /// which is what makes sharding additive: every existing row and every
  /// existing code path reads null and behaves exactly as before.
  shardIndex Int?

  run      Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  test     Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  steps    Step[]
  findings Finding[]
  verdict  TriageVerdict?

  @@unique([runId, testId])
  @@index([orgId])
  @@index([testId, createdAt])
  /// The shard's own query: "give me my slice of this run".
  @@index([runId, shardIndex])
}

model Step {
  id            String     @id @default(cuid())
  orgId         String
  testResultId  String
  index         Int
  title         String
  status        StepStatus
  durationMs    Int        @default(0)
  screenshotKey String?
  errorMessage  String?
  errorStack    String?
  /// The locator that failed, when the failure was a locator failure.
  selector      String?
  expected      String?
  actual        String?
  startedAt     DateTime?

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@unique([testResultId, index])
  @@index([orgId])
}

/// a11y / security / perf / l10n / visual results — first-class, not pass-fail noise.
model Finding {
  id           String          @id @default(cuid())
  orgId        String
  testResultId String
  kind         FindingKind
  severity     FindingSeverity
  code         String
  message      String
  location     String
  helpUrl      String?
  /// Muted findings still record but never gate.
  mutedAt      DateTime?
  createdAt    DateTime        @default(now())

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([testResultId])
  @@index([code])
}

model Artifact {
  id          String   @id @default(cuid())
  orgId       String
  runId       String
  /// S3 object key, or a path under .artifacts when ARTIFACTS_LOCAL=true.
  key         String   @unique
  contentType String
  sizeBytes   Int      @default(0)
  /// Retention is by plan (§5); a sweeper deletes rows and objects past this.
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([runId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Triage & healing (§3.3, §3.4)
// ─────────────────────────────────────────────────────────────────────────────

model TriageVerdict {
  id           String             @id @default(cuid())
  orgId        String
  testResultId String             @unique
  verdict      Verdict
  confidence   Float
  explanation  String
  /// Evidence[] from packages/shared.
  evidence     Json
  suspectCommit Json?
  model        String
  /// A human can disagree; the override is what gates and what trains prompts.
  reviewState  VerdictReviewState @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  overriddenTo Verdict?
  /// Set when this verdict was filed as a bug (§7).
  issueUrl     String?
  createdAt    DateTime           @default(now())

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  batchItems TriageBatchItem[]

  @@index([orgId, verdict])
  @@index([orgId, reviewState])
}

model HealProposal {
  id          String    @id @default(cuid())
  orgId       String
  testId      String
  /// The verdict that triggered this heal.
  verdictId   String?
  diff        String
  explanation String
  riskLevel   HealRisk
  confidence  Float
  state       HealState @default(PROPOSED)
  decidedBy   String?
  decidedAt   DateTime?
  /// PR opened when the repo is connected.
  prUrl       String?
  createdAt   DateTime  @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([orgId, state])
  @@index([testId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Visual regression (§4)
// ─────────────────────────────────────────────────────────────────────────────

model VisualBaseline {
  id         String   @id @default(cuid())
  orgId      String
  projectId  String
  testId     String
  /// One baseline per (test, viewport, browser).
  viewport   String
  browser    String
  imageKey   String
  /// Rectangles to exclude from the diff, from the ignore-region editor.
  ignoreRegions Json  @default("[]")
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, viewport, browser])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduling & monitoring (§6)
// ─────────────────────────────────────────────────────────────────────────────

model Schedule {
  id            String   @id @default(cuid())
  orgId         String
  projectId     String
  suiteId       String
  environmentId String
  name          String
  cron          String
  timezone      String   @default("UTC")
  enabled       Boolean  @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([enabled, nextRunAt])
}

/// Synthetic monitoring (§6) — a smoke suite against prod every N minutes.
model Monitor {
  id             String   @id @default(cuid())
  orgId          String
  projectId      String
  suiteId        String
  environmentId  String
  name           String
  intervalMinutes Int     @default(15)
  enabled        Boolean  @default(true)
  /// Consecutive failures before alerting, to avoid paging on one blip.
  failureThreshold Int    @default(2)
  consecutiveFailures Int @default(0)
  lastStatus     RunStatus?
  lastCheckedAt  DateTime?
  /// Integration ids to notify.
  notifyVia      String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([enabled])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations (§7)
// ─────────────────────────────────────────────────────────────────────────────

model Integration {
  id         String          @id @default(cuid())
  orgId      String
  projectId  String?
  kind       IntegrationKind
  name       String
  /// Non-secret settings (channel, project key, repo). Tokens go in configEnc.
  config     Json            @default("{}")
  configEnc  String?
  enabled    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([orgId, kind])
}

/// Lifecycle of one outbound notification (§7). Mirrored as a union type in
/// packages/shared/src/types.ts — `check:enums` diffs them. PENDING while
/// retries remain, SENT on the 2xx that landed, FAILED once the last attempt is
/// spent. There is no separate dead-letter store: a FAILED row, holding its
/// final error, IS the dead letter.
enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  orgId         String
  integrationId String
  event         String
  payload       Json
  /// HMAC-SHA256 signature sent with the request (§7 "signed").
  signature     String
  status        WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  attempts      Int      @default(0)
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([integrationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat copilot (§3.5)
// ─────────────────────────────────────────────────────────────────────────────

model ChatConversation {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  title     String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([orgId, projectId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  role           String // "user" | "assistant" | "tool"
  content        String
  /// Tool calls the copilot made, so the UI can show its work (§3 "never a black box").
  toolCalls      Json?
  userId         String?
  /// Set while the assistant turn is still being produced.
  pending        Boolean  @default(false)
  /// Populated when a turn fails, so the UI can say why instead of hanging.
  error          String?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  proposals    AgentProposal[]

  @@index([orgId])
  @@index([conversationId, createdAt])
}

enum ProposalState {
  PENDING
  APPLIED
  REJECTED
}

enum ImportState {
  DETECTED
  CONVERTING
  DONE
  ERRORED
}

/// A suite migration (§7): upload existing tests → convert to Playwright.
///
/// The uploaded files and the conversion result live on the row so the whole
/// batch is one auditable, resumable unit. Detection runs synchronously in the
/// request; conversion is the worker's job because it calls the model.
model ImportBatch {
  id             String      @id @default(cuid())
  orgId          String
  projectId      String
  /// Detected source framework (a SourceFramework from packages/agent).
  framework      String
  detectionConfidence Float  @default(0)
  /// SourceFile[] — [{ path, content }]. The suite as uploaded.
  files          Json
  state          ImportState @default(DETECTED)
  /// Free-text conversion summary once the worker finishes.
  summary        String?
  /// How many tests were produced, for the coverage report.
  convertedCount Int         @default(0)
  error          String?
  requestedBy    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([orgId, projectId])
}

/// A file change the copilot wants to make, held for human approval (§3).
///
/// The copilot never writes a test directly. It proposes, the person reads the
/// diff, and only an explicit accept mutates anything — the same contract the
/// Healer works under, for the same reason: an agent that silently edits your
/// test suite is one that can silently stop testing something.
model AgentProposal {
  id             String        @id @default(cuid())
  orgId          String
  projectId      String
  conversationId String
  messageId      String?
  /// Null when the proposal creates a new test rather than editing one.
  testId         String?
  filePath       String
  /// Empty for a new file. Kept so the diff survives later edits to the test.
  oldCode        String
  newCode        String
  /// Why the copilot wants this change, in its own words.
  rationale      String
  testName       String
  testType       TestType      @default(E2E)
  state          ProposalState @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())

  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([orgId, state])
  @@index([conversationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing & metering (§9)
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                   String   @id @default(cuid())
  orgId                String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  plan                 Plan     @default(FREE)
  status               String   @default("active")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  /// Stripe's `event.created` for the last subscription state applied here.
  /// Stripe does not promise delivery order, so the webhook refuses to write a
  /// subscription event older than this — a redelivered `updated` from before a
  /// cancellation must not resurrect the plan. Null on rows that predate the
  /// column; the first event to arrive claims it.
  planSyncedAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Stripe webhook events already processed. Stripe redelivers on timeouts, on
/// any non-2xx, and occasionally even after a 2xx, and this endpoint moves orgs
/// between paid plans — so every event id is checked here before handling and
/// recorded after. Global on purpose (no orgId): the event arrives before we
/// know which org it is for. Same shape as SsoAssertionSeen, the other
/// replay-guard table.
model StripeEventSeen {
  /// The Stripe event id (`evt_…`) — stable across every redelivery.
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Metered regardless of plan (§9), so pricing can change without a data migration.
model UsageRecord {
  id       String   @id @default(cuid())
  orgId    String
  /// "runs" | "agent_tokens" | "storage_bytes" | "worker_minutes"
  metric   String
  /// First day of the billing month, UTC. One row per (org, metric, period).
  period   DateTime
  quantity BigInt   @default(0)
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, period])
  @@index([orgId])
}

/// One row per LLM call (§0 token accounting). Rolled up nightly into UsageRecord.
model AgentCall {
  id              String    @id @default(cuid())
  orgId           String
  projectId       String?
  agent           AgentKind
  model           String
  subjectId       String?
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  cacheReadTokens Int       @default(0)
  cacheWriteTokens Int      @default(0)
  costCents       Float     @default(0)
  durationMs      Int       @default(0)
  /// Set when the call failed after retries; kept so cost of failure is visible.
  error           String?
  createdAt       DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, agent])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ops (§11)
// ─────────────────────────────────────────────────────────────────────────────

model FeatureFlag {
  key         String   @id
  description String
  /// Default for orgs with no override row.
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  overrides FeatureFlagOverride[]
}

model FeatureFlagOverride {
  id        String   @id @default(cuid())
  orgId     String
  flagKey   String
  enabled   Boolean
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  flag FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([orgId, flagKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// SSO (§1, gated on PLAN_LIMITS.sso — see src/lib/plan.ts)
//
// These four tables are org-owned and therefore scoped by the Prisma tenancy
// extension like everything else. Note that the login path itself is
// ANONYMOUS — there is no tenant in scope when a browser hits /sso/start — so
// every read on the way in is an explicit `unscoped()` in routes/sso.ts, with
// the orgId supplied from the row rather than from the caller.
// ─────────────────────────────────────────────────────────────────────────────

/// An org's identity provider.
model SsoConnection {
  id          String      @id @default(cuid())
  orgId       String
  protocol    SsoProtocol
  name        String
  enabled     Boolean     @default(true)
  /// Role a JIT-provisioned member is created with. Clamped below OWNER in
  /// src/lib/sso.ts: an IdP assertion must never be able to mint someone who
  /// can change billing or delete the org.
  defaultRole OrgRole     @default(MEMBER)

  // ── OIDC ───────────────────────────────────────────────────────────────────
  /// The exact `iss` value we require in every ID token. It is also the ONLY
  /// source of the discovery host — see ISSUER_ALLOWED_HOSTS in lib/sso.ts.
  oidcIssuer          String?
  oidcClientId        String?
  /// Sealed by lib/vault.ts under the name `sso:<connectionId>:client_secret`.
  /// Never returned by the API and never logged.
  oidcClientSecretEnc String?
  oidcKeyVersion      Int?
  /// Extra scopes appended to the mandatory `openid email profile`.
  oidcScopes          String[] @default([])

  // ── SAML ───────────────────────────────────────────────────────────────────
  samlIdpEntityId String?
  samlSsoUrl      String?
  /// IdP signing certificates, PEM. A list because rotation means publishing
  /// the old and the new one at the same time.
  samlIdpCertsPem String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domains    SsoDomain[]
  requests   SsoLoginRequest[]
  assertions SsoAssertionSeen[]

  @@index([orgId])
}

/// An email domain routed to one connection.
///
/// `domain` is UNIQUE ACROSS THE WHOLE TABLE, not per org, and that is the
/// single most important constraint in this feature. Users are global (one row
/// per email) and a session can switch between every org the user belongs to,
/// so an org that could claim a domain it does not own could assert any address
/// in it, be handed that user's session, and switch straight into the victim's
/// org. DNS ownership is therefore proved before `verifiedAt` is set, and
/// nothing on the login path looks at an unverified row.
model SsoDomain {
  id           String @id @default(cuid())
  orgId        String
  connectionId String
  /// Lowercase, trailing dot stripped, no leading `@`.
  domain       String @unique
  /// Published by the customer as a TXT record at `_qaai-verify.<domain>`.
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([connectionId])
}

/// One in-flight login. Single-use: `consumedAt` is set by a conditional
/// update, so a replayed callback loses the race instead of minting a session.
model SsoLoginRequest {
  id           String @id @default(cuid())
  orgId        String
  connectionId String
  /// SHA-256 of the opaque `state`. The raw value exists only in the URL.
  stateHash    String @unique
  /// SHA-256 of the OIDC nonce, compared against the ID token's claim.
  nonceHash    String?
  /// PKCE verifier, sealed under `sso:<requestId>:pkce`. Sealed rather than
  /// stored raw so a database read alone cannot complete a stolen code.
  pkceVerifierEnc String?
  keyVersion      Int?
  /// SAML AuthnRequest ID, matched against the assertion's InResponseTo.
  samlRequestId   String?
  /// Where to land afterwards. Validated as a same-origin relative path before
  /// it is stored, so the callback cannot be turned into an open redirect.
  redirectTo      String?
  ip              String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([expiresAt])
}

/// SAML replay guard: an assertion ID may be consumed exactly once.
///
/// The unique index is the enforcement — a duplicate insert throws, which is
/// what makes this safe under concurrency. Rows are disposable once `expiresAt`
/// has passed, because an expired assertion is rejected on its NotOnOrAfter
/// anyway.
model SsoAssertionSeen {
  id           String   @id @default(cuid())
  orgId        String
  connectionId String
  assertionId  String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, assertionId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// On-prem runners (ENTERPRISE)
//
// The whole design decision, stated once: the agent POLLS OUT. An enterprise
// will not open an inbound port for us, and any protocol that needs one is dead
// on arrival, so nothing in this section is reachable from our side — we never
// dial a runner, we only answer one. Everything below is the durable state that
// makes that safe: who is allowed to ask, what they can run, and who currently
// holds a piece of work.
//
// The lease/heartbeat/reap machinery mirrors RunShard on purpose. A second
// liveness protocol is a second set of liveness bugs, and this one is harder
// than the shard case: the process holding the lease is inside a network we
// cannot see into, so a missing heartbeat is the ONLY signal we will ever get.
// ─────────────────────────────────────────────────────────────────────────────

/// One agent a customer runs inside their own network.
model Runner {
  id    String @id @default(cuid())
  orgId String
  name  String

  /// SHA-256 of the runner token, exactly like ApiKey.keyHash.
  ///
  /// Hashed rather than vault-sealed, and the distinction is the point: this
  /// credential is only ever VERIFIED, never replayed outbound, so there is no
  /// reason for the plaintext to be recoverable. Sealing it would mean a
  /// database read plus the master key hands out live runner tokens; a hash
  /// means it hands out nothing. Vault sealing is for secrets we have to send
  /// somewhere (see Integration.configEnc) — this is not one.
  tokenHash   String @unique
  /// `qaai_rt_a1b2c3d4` — enough to identify a token in the UI and in an audit
  /// row without storing anything that can authenticate.
  tokenPrefix String

  /// RunnerCapabilities as reported by the agent and re-validated on arrival;
  /// see parseCapabilities() in apps/api/src/lib/runners.ts. Agent-supplied and
  /// therefore never trusted for anything but matching — it can only ever cause
  /// LESS work to be sent to this runner, never more privilege.
  capabilities Json     @default("{}")
  /// Pool names this runner serves, matched against Run.runnerPool. Empty means
  /// the default pool only.
  pools        String[] @default([])

  agentVersion String?
  /// "linux-x64", "darwin-arm64" — reported, for support, never for routing.
  platform     String?

  /// Stamped on every authenticated call. Liveness is derived from this rather
  /// than stored: a status column would need something to write OFFLINE, and
  /// the thing that would write it is the process that just died.
  lastSeenAt   DateTime?
  lastClaimAt  DateTime?

  tokenRotatedAt DateTime?
  /// Revocation is a timestamp, not a delete, so the audit trail keeps pointing
  /// at a row that still exists.
  revokedAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs RunnerJob[]

  @@index([orgId])
  @@index([tokenPrefix])
}

/// One unit of work waiting for, or held by, an on-prem runner.
///
/// This row is the durable record that a shard's queue job is in Redis: an
/// agent inside a customer's network can vanish without a packet, and this is
/// the only place that remembers the work existed.
model RunnerJob {
  id     String          @id @default(cuid())
  orgId  String
  runId  String
  /// 0-based and matching TestResult.shardIndex, or null for the whole run —
  /// the same convention the cloud path uses.
  shardIndex Int?
  status     RunnerJobStatus @default(QUEUED)

  /// Idempotency key, `<runId>:<shardIndex ?? 'all'>`.
  ///
  /// A composite unique on (runId, shardIndex) would NOT do this job: Postgres
  /// treats NULLs as distinct, so the unsharded case — the common one — would
  /// accept the same job twice and a suite would execute twice. A generated
  /// string has no null to be clever about.
  dedupeKey String @unique

  /// JobRequirements: what a runner must have to be offered this. Derived from
  /// the tests in the slice, never from the agent.
  requirements Json   @default("{}")
  /// Run.runnerPool at dispatch, so routing survives an environment edit.
  pool         String?

  /// Who holds it. Kept after the job finishes: "which runner ran this" is the
  /// first question asked when an on-prem result looks wrong.
  runnerId String?
  /// The fencing token. Minted fresh on every claim and required on every
  /// subsequent call, so a runner that lost its lease — paused VM, partitioned
  /// network, a reap it never saw — cannot write results into work another
  /// runner is now executing. Without this, "reclaimable" and "never executes
  /// twice" are not both true.
  leaseId  String?
  /// The lease deadline. A job past it with a live status is reclaimable.
  leaseExpiresAt DateTime?
  /// Stamped by the agent while it works, exactly like RunShard.heartbeatAt.
  heartbeatAt    DateTime?

  /// Claims so far. A job that keeps being claimed and dropped is a runner that
  /// keeps dying, and re-offering it forever is how a run hangs for a day.
  attempt     Int @default(0)
  maxAttempts Int @default(3)

  queuedAt   DateTime  @default(now())
  claimedAt  DateTime?
  startedAt  DateTime?
  finishedAt DateTime?

  /// Always a sentence a customer can act on: which capability was missing,
  /// which runner went silent, how long it waited.
  errorMessage String?

  run    Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  runner Runner? @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([runId])
  @@index([runnerId])
  /// The claim query: oldest claimable job in this org's pool.
  @@index([orgId, status, queuedAt])
  /// The reaper's query: live leases that are past their deadline.
  @@index([status, leaseExpiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Team workflow (§8) — ownership, bulk triage, and the nightly digest
//
// Everything above answers "what happened". These four tables answer the three
// questions a team has once more than one person reads the answer: whose failure
// is this, can I decide forty of them at once, and what did the suite do while
// nobody was watching.
// ─────────────────────────────────────────────────────────────────────────────

/// A named group of people that failures can be routed to.
model Team {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  /// URL-safe handle, and the name a digest mentions: "@payments".
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMember[]
  rules   OwnershipRule[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model TeamMember {
  id        String   @id @default(cuid())
  orgId     String
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([orgId])
  @@index([userId])
}

/// Who hears about a failure.
///
/// Four subjects, exactly one set per row: a test, a suite, a feature, or a
/// CODEOWNERS-style path pattern. The pattern is what makes this survive contact
/// with a real suite — per-test ownership is a table nobody maintains by hand,
/// and a repo that already has a CODEOWNERS file has already answered this
/// question once.
///
/// Precedence and glob semantics live in apps/api/src/lib/ownership.ts, which is
/// pure and tested. This table only stores the rules.
///
/// An unowned test is a normal state. There is no default owner column and no
/// fallback: inventing one would page whoever happened to be listed first, and
/// the second time that happens the whole feature gets turned off.
model OwnershipRule {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// gitignore/CODEOWNERS-style glob, matched against Test.filePath.
  pathPattern String?
  testId      String?
  suiteId     String?
  /// Test.feature, matched case-insensitively.
  feature     String?

  /// Exactly one owner. Both null is not a rule, it is a routing hole that looks
  /// like a rule — which is worse than no row at all.
  ownerUserId String?
  ownerTeamId String?

  /// Order among path patterns. CODEOWNERS is last-match-wins and people expect
  /// that, so the highest position that matches is the one that owns the file.
  position Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  test      Test?   @relation(fields: [testId], references: [id], onDelete: Cascade)
  suite     Suite?  @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  ownerUser User?   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTeam Team?   @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId, position])
  @@index([testId])
  @@index([suiteId])
}

/// One human decision applied to many failures (§3.3 bulk triage).
///
/// The row exists for two reasons: so the decision can be undone, and so the
/// audit trail can be honest. The audit log gets N rows, one per verdict — a
/// single "bulk" row would claim a person reviewed forty failures when they
/// reviewed one cause, and the difference between those two sentences is the
/// entire feature. This table is what lets both be true at once: N decisions,
/// one act, reversible.
model TriageBatch {
  id        String @id @default(cuid())
  orgId     String
  projectId String?
  /// The run the selection came from, when it came from one.
  runId     String?
  /// The failure cluster (apps/api/src/lib/cluster.ts) the batch was expanded
  /// from, when the selection was "everything with this cause".
  clusterId String?
  /// "accept" | "override" | "mute" — applied to every member.
  action    String
  /// Set only when the action was an override.
  overriddenTo Verdict?
  /// The reviewer's note: why one verdict is right for all of them.
  note      String?
  appliedBy String
  createdAt DateTime  @default(now())
  undoneAt  DateTime?
  undoneBy  String?

  project Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   TriageBatchItem[]

  @@index([orgId, createdAt])
}

model TriageBatchItem {
  id           String @id @default(cuid())
  orgId        String
  batchId      String
  verdictId    String
  testResultId String

  /// What the verdict held before the batch touched it. Undo restores exactly
  /// this, and only while the verdict still holds what the batch wrote — a row
  /// someone has since re-reviewed is left alone and reported back, because
  /// silently reverting a colleague's decision is not an undo.
  previousReviewState  VerdictReviewState
  previousOverriddenTo Verdict?
  previousReviewedBy   String?
  previousReviewedAt   DateTime?

  batch   TriageBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  verdict TriageVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@unique([batchId, verdictId])
  @@index([orgId])
}

/// "Here is what your suite did overnight" (§7).
///
/// One per project. Schedules already say when to run and integrations already
/// say where to send; this row is the missing third thing — when to SUMMARISE,
/// and how far back the last summary actually got.
model DigestSubscription {
  id        String @id @default(cuid())
  orgId     String
  projectId String @unique

  cron     String  @default("0 8 * * *")
  timezone String  @default("UTC")
  enabled  Boolean @default(true)

  /// Integration ids to deliver to. Empty means every enabled chat integration
  /// on the org — the same destination set a failing run already reaches, so an
  /// empty list reads as "wherever the failures go", not "nowhere".
  notifyVia String[] @default([])

  lastRunAt DateTime?
  nextRunAt DateTime?
  /// The end of the window the last DELIVERED digest covered.
  ///
  /// Separate from `lastRunAt` on purpose. A digest that could not be delivered
  /// must not advance this, or the news it was carrying is lost for good and
  /// tomorrow's digest starts after it. `lastRunAt` says when we tried; this
  /// says how far the story has actually been told.
  lastCoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([enabled, nextRunAt])
}
