// ─────────────────────────────────────────────────────────────────────────────
// Identity (§1)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  /// Null for users who only ever signed in with OAuth.
  passwordHash  String?
  avatarUrl     String?
  /// §11 — grants access to /admin. Never settable through the public API.
  isSuperuser   Boolean   @default(false)
  /// Encrypted TOTP seed (§1 2FA). Null until the user enrols.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  sessions      Session[]
  oauthAccounts OAuthAccount[]
  auditLogs     AuditLog[]
  chatMessages  ChatMessage[]

  teamMemberships  TeamMember[]
  ownedRules       OwnershipRule[]
  coverageWaivers  CoverageWaiver[]
  /// Requirement→test links this person ASSERTED. The back-relation exists so
  /// `onDelete: SetNull` can fire: a link's author leaving must not delete the
  /// claim, and `RequirementLink.byEmail` is what survives.
  requirementLinks RequirementLink[]

  @@index([email])
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String // "google" | "github"
  providerAccountId String
  accessTokenEnc    String?
  refreshTokenEnc   String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash   String    @unique
  /// The org this session is currently acting in; switchable without re-login.
  activeOrgId String?
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Email verification and password reset both use this table, discriminated by `purpose`.
model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  purpose   String // "EMAIL_VERIFY" | "PASSWORD_RESET" | "INVITE"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organizations (§1)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  plan           Plan         @default(FREE)
  /// Per-org overrides on top of PLAN_LIMITS; used for trials and enterprise deals.
  limitOverrides Json?
  /// Record-and-notify only (§9 dunning) — see the BillingState doc comment.
  billingState   BillingState @default(OK)
  /// Stripe's clock (`event.created`) for the LAST invoice event applied. The
  /// ordering guard for dunning: an invoice.payment_failed that is older than
  /// the invoice.paid already applied must not mark a healthy org PAST_DUE.
  /// Same single-clock rule as Subscription.planSyncedAt, for the same reason.
  billingStateAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships    Membership[]
  invites        Invite[]
  projects       Project[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  subscription   Subscription?
  usageRecords   UsageRecord[]
  agentCalls     AgentCall[]
  integrations   Integration[]
  featureFlags   FeatureFlagOverride[]
  ssoConnections SsoConnection[]
  runners        Runner[]

  @@index([slug])
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       OrgRole   @default(MEMBER)
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
}

/// API keys and personal access tokens (§1). `userId` set = PAT, null = org key.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  userId     String?
  name       String
  /// SHA-256 of the full key. Only the prefix is recoverable for display.
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([keyPrefix])
}

/// §1 — every mutating action. Append-only; there is no update or delete path.
model AuditLog {
  id             String   @id @default(cuid())
  orgId          String
  userId         String?
  /// "project.create", "secret.update", "verdict.override", ...
  action         String
  targetType     String
  targetId       String?
  /// Diff or payload summary, already secret-masked.
  metadata       Json?
  ip             String?
  userAgent      String?
  requestId      String?
  /// Set when a superuser was impersonating (§11).
  impersonatedBy String?
  createdAt      DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, action])
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects & environments (§2)
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id                       String      @id @default(cuid())
  orgId                    String
  name                     String
  slug                     String
  repoUrl                  String?
  /// Owner/name, set when the GitHub App is installed on the repo.
  repoFullName             String?
  repoInstallationId       String?
  defaultBranch            String      @default("main")
  primaryLanguage          Language    @default(TYPESCRIPT)
  primaryFramework         UiFramework @default(PLAYWRIGHT)
  /// GateRule[] — see packages/shared types.
  gateRules                Json        @default("[]")
  /// Org-level opt-in to auto-approving SELECTOR_ONLY heals (§3.4).
  autoApproveSelectorHeals Boolean     @default(false)
  /// How much of this suite may be quarantined, as a percent, before
  /// quarantining is REFUSED. Null means the documented default in
  /// packages/runner/src/gates.ts (QUARANTINE_BUDGET_PERCENT_DEFAULT).
  ///
  /// A column rather than an environment variable, deliberately. Quarantine is
  /// the mechanism that switches a signal off, and the brake on it has to be
  /// something the person running this product can find, read and change — an
  /// env var nobody deploying this could discover is not a brake, which is why
  /// scripts/check-wiring.ts refuses one.
  ///
  /// Nullable rather than defaulted so "this project never thought about it" and
  /// "this project chose 5" stay distinguishable; the UI can say which.
  quarantineBudgetPercent  Int?
  /// The coverage percentage this project is trying to reach, and — because
  /// nothing else arms it — the ON SWITCH for the closure autopilot
  /// (apps/worker/src/processors/close-loop.ts). Null means no campaign is ever
  /// created for this project, which is every project until somebody sets one.
  ///
  /// A column and not an environment variable for the same reason as
  /// `quarantineBudgetPercent` above: this one spends model calls and browser
  /// time on its own at 3am, so the brake has to be something the person
  /// running this product can find, read and change per project. An env var
  /// would arm it for every project in the install at once, which is the
  /// opposite of a brake.
  ///
  /// Nullable rather than defaulted so "this project never asked for an
  /// autopilot" and "this project chose 80" stay distinguishable. A default
  /// here would switch the autopilot on for every existing customer in one
  /// migration.
  coverageTargetPercent    Int?
  /// Whether the autopilot's plan items land APPROVED (code is written without
  /// anyone ticking a box) or PROPOSED (a human approves first). Null means the
  /// documented default in close-loop.ts, which is the cautious one.
  ///
  /// Text and not an enum: apps/api/scripts/check-enums.ts enforces
  /// schema/TypeScript parity from a hand-maintained list, so a new Prisma enum
  /// added without an entry in it is an enum with no drift guard. The domain is
  /// enforced at the producer (`CLOSURE_APPROVAL_POLICIES` in close-loop.ts),
  /// exactly as `MutationSurvivor.reason` does.
  closureApprovalPolicy    String?
  /// How many plan items one night's campaign may ever propose for this
  /// project. Null means the documented default. This is the money cap: every
  /// item is a model call and, eventually, a browser.
  closureItemBudget        Int?
  /// `CoverageConfig` — route weights, declared criticality and out-of-scope
  /// globs, as validated configuration THE CUSTOMER OWNS.
  ///
  /// THE DEFECT: risk ranking is an English money-word regex and it is
  /// `\b`-bounded, so `/pay_now` and `/checkoutConfirm` — two of the
  /// highest-risk route spellings there are — both miss. No regex fixes that,
  /// because the question is not how a route is spelled but what it does, and
  /// the only party who knows is the team that wrote it. A code comment already
  /// invited them to "tell us so" with nowhere in the product to do it.
  ///
  /// NULLABLE WITH NO DEFAULT. `{}` would claim a customer had reviewed their
  /// scope and declared nothing out of it, which is a positive assertion; null
  /// is "nobody has configured this", and the UI can say which. Same judgement
  /// as `quarantineBudgetPercent` and `coverageTargetPercent` above.
  ///
  /// `outOfScope` removes items from the DENOMINATOR, which makes it the one
  /// knob here a customer could use to make their own number say anything — so
  /// `maxOutOfScopePercent` inside it is the brake, it is stored beside the
  /// rules it bounds, and a reader that hits it must report the cap AS A COUNT
  /// AND AS A REASON rather than applying half the configuration silently.
  coverageConfig           Json?
  /// `TypeObligationPolicy` — WHICH TEST TYPES EACH SURFACE AXIS OWES.
  ///
  /// NULLABLE WITH NO DEFAULT, and the default in code owes NOTHING. An
  /// obligation nobody declared is not owed: defaulting every route to owing an
  /// E2E and an ACCESSIBILITY test would mint 824 obligations for a 412-route
  /// project on the day of the migration, report every one of them as
  /// uncovered, and present QAAI's own opinion about what a team should test as
  /// the team's debt. The number would fall for a reason unconnected to their
  /// code, which is the one way a coverage product loses a customer in a week.
  ///
  /// Null means "this project never stated its obligations" and `{}` means
  /// "this project considered it and owes nothing" — the same distinction
  /// `coverageConfig` and `quarantineBudgetPercent` above record, and the UI can
  /// say which. The domain is `TypeObligationPolicy` /
  /// `typeObligationPolicySchema` in @qaai/shared, and `obligationsFor` is the
  /// one resolver, so there is no second place a default could be written down.
  typeObligationPolicy     Json?
  archivedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  environments  Environment[]
  suites        Suite[]
  tests         Test[]
  runs          Run[]
  flowMaps      FlowMap[]
  testPlans     TestPlan[]
  schedules     Schedule[]
  monitors      Monitor[]
  conversations ChatConversation[]
  baselines     VisualBaseline[]

  ownershipRules    OwnershipRule[]
  triageBatches     TriageBatch[]
  digest            DigestSubscription?
  pluginEnablements PluginEnablement[]
  coverageItems     CoverageItem[]
  surfaceDimensions SurfaceDimension[]
  coverageSnapshots CoverageSnapshot[]
  /// Suite health over time. `Test.flakeRate` is overwritten on every run and
  /// the score was recomputed per request, so rot had no direction at all.
  healthSnapshots   SuiteHealthSnapshot[]
  failureSignatures FailureSignature[]
  closureCampaigns  ClosureCampaign[]
  gapClosures       GapClosure[]

  /// The non-crawl enumeration sources. Each one is an inventory of what
  /// EXISTS, read independently of whether anything has ever reached it — which
  /// is the half of the denominator a crawl structurally cannot produce.
  /// `specRequirements` and not `requirements`, and the reason is a live
  /// collision rather than taste. `JobRequirements` already means something
  /// else in this repo — the browsers and toolchains an on-prem runner must
  /// have — and `RunShard.requirements` is that column. With this relation
  /// called `requirements`, the nested-read heuristic in
  /// scripts/check-wiring.ts matched `requirements: true` in
  /// apps/api/src/routes/runners.ts and reported THIS table as "read by
  /// runners.ts", which would have made the check go quiet about a Requirement
  /// write path with no read path at all.
  specRequirements      Requirement[]
  requirementLinks      RequirementLink[]
  manualTestCases       ManualTestCase[]
  apiOperations         ApiOperation[]
  componentItems        ComponentItem[]
  trafficIngests        TrafficIngest[]
  observedJourneys      ObservedJourney[]
  /// The authorization axis and the re-enumeration lifecycle.
  accessCells           RouteAccessCell[]
  roleCrawlAttempts     RoleCrawlAttempt[]
  reEnumerationTriggers ReEnumerationTrigger[]
  surfaceDrifts         SurfaceDriftRecord[]

  /// The number leaving the screen, and the three things that measure the
  /// measurer. `coverageAttestations` is the exported artefact a buyer is
  /// handed; `validityBacktests` asks whether "covered" tracks quality against
  /// this org's own defect history; `benchmarkRuns` records what share of
  /// SEEDED defects the suite actually caught, which is the ground truth every
  /// other number in this product rests on and which nothing has ever measured.
  coverageAttestations CoverageAttestation[]
  validityBacktests    ValidityBacktest[]
  benchmarkRuns        BenchmarkRun[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model Environment {
  id          String          @id @default(cuid())
  orgId       String
  projectId   String
  name        String
  kind        EnvironmentKind
  baseUrl     String
  /// The on-prem runner pool this environment executes on, or null for the
  /// cloud worker (ENTERPRISE). This is THE switch: a staging environment that
  /// never faces the internet cannot be reached from our infrastructure at all,
  /// so a run against it must be handed to an agent inside the customer's
  /// network instead of being enqueued on our own queue. See Run.runnerPool.
  runnerPool  String?
  /// CrawlPolicy — the auditable scope a crawl of this environment is permitted.
  ///
  /// ── THE DEFECT ──────────────────────────────────────────────────────────────
  ///
  /// `CrawlOptions.excludePatterns` has been declared in
  /// packages/agent/src/crawler.ts since the beginning and is passed by NO
  /// caller, so the scope of a PRODUCTION crawl is five regexes hard-coded in
  /// that file and there is nothing a customer can read, review or change. A
  /// production enumeration with no auditable scope is not something a security
  /// reviewer signs off, which makes this a commercial problem and not only an
  /// honesty one.
  ///
  /// ── WHY A COLUMN AND NOT AN ENVIRONMENT VARIABLE ───────────────────────────
  ///
  /// Same argument as `Project.quarantineBudgetPercent` and
  /// `Project.coverageTargetPercent`: this governs what a browser DOES to a
  /// customer's live application, so the brake has to be something the person
  /// running this product can find, read and change — per environment, because
  /// a seeded throwaway and a production site want opposite answers. An env var
  /// would arm one answer for every environment in the install at once, which
  /// is the opposite of a brake, and scripts/check-wiring.ts refuses one.
  ///
  /// ── WHY GLOBS AND NOT RegExp ────────────────────────────────────────────────
  ///
  /// A `RegExp` does not survive JSON — it serialises to `{}` — and this column
  /// is JSON. Globs are also what a human can review in a panel: `/admin/**` is
  /// readable and `^\/admin\/.*$` is not. The dialect's only implementation is
  /// `matchesGlob` in packages/shared/src/flow-map.ts, so the panel's preview
  /// and the crawler's decision cannot disagree.
  ///
  /// NULLABLE WITH NO DEFAULT: null means this environment never chose a
  /// policy and the build's `DEFAULT_CRAWL_POLICY` applies, which
  /// `resolveCrawlPolicy` reports as `defaulted: true`. An environment that
  /// stored `{}` has ACCEPTED every default, and that is a decision somebody
  /// made and can be held to. Defaulting the column would erase the difference.
  crawlPolicy Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets               Secret[]
  authProfiles          AuthProfile[]
  runs                  Run[]
  flowMaps              FlowMap[]
  schedules             Schedule[]
  monitors              Monitor[]
  /// What makes this environment reachable at all, and what each role saw.
  access                EnvironmentAccess?
  accessCells           RouteAccessCell[]
  roleCrawlAttempts     RoleCrawlAttempt[]
  reEnumerationTriggers ReEnumerationTrigger[]
  surfaceDrifts         SurfaceDriftRecord[]

  @@unique([projectId, name])
  @@index([orgId])
}

/// §1 secrets vault. `valueEnc` is AES-256-GCM; see apps/api/src/lib/vault.ts.
model Secret {
  id            String   @id @default(cuid())
  orgId         String
  environmentId String
  name          String
  valueEnc      String
  /// Key version, so the master key can be rotated without a big-bang re-encrypt.
  keyVersion    Int      @default(1)
  /// Last 4 chars of the plaintext, for "is this the right value?" without decrypting.
  hint          String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, name])
  @@index([orgId])
}

model AuthProfile {
  id                    String             @id @default(cuid())
  orgId                 String
  environmentId         String
  name                  String
  kind                  AuthProfileKind
  /// Non-secret config; secret-bearing fields reference Secret.name. Validated
  /// per kind by AUTH_PROFILE_CONFIG_SCHEMAS in
  /// packages/shared/src/auth-profiles.ts, which is the only complete map and
  /// the only thing a caller should index — a kind with no arm there breaks the
  /// compiler rather than storing an unvalidatable config.
  config                Json
  /// THE ROLE THIS IDENTITY IS, as the application spells it.
  ///
  /// ── The defect ───────────────────────────────────────────────────────────
  ///
  /// `authProfile.findFirst({ orderBy: { createdAt: 'asc' } })` picks ONE
  /// identity for an entire crawl and `FlowNode.requiresRoles` is set to `[]`
  /// unconditionally, so admin, member and viewer surfaces are structurally
  /// absent: there is no axis to enumerate along and "a member gets 403 on
  /// /admin" has never been expressible. This column is the axis. A crawl
  /// iterates the profiles that declare a role, and RouteAccessCell is the
  /// result.
  ///
  /// NULLABLE WITH NO DEFAULT, and the three states are the contract: null
  /// means this profile predates the column and nobody said what it is, which
  /// must NOT be read as anonymous — `roleKey(null)` returns the reserved
  /// `<anonymous>` spelling and that is a claim about a logged-OUT visitor,
  /// the opposite of an unlabelled logged-in one. A reader that needs the
  /// difference asks whether the column is null.
  role                  String?
  /// MAY A SCENARIO DESTROY THIS IDENTITY?
  ///
  /// DEFAULT PERSISTENT, AND THAT ASYMMETRY IS THE POINT. Every row that
  /// exists today is the customer's own account, so the default is the only
  /// correct back-fill — and the costs of the two mistakes are not comparable.
  /// Wrongly calling the customer's account disposable costs them their
  /// production login; wrongly calling a throwaway persistent costs one
  /// scenario reported as UNEXERCISABLE with a remedy printed beside it. The
  /// default is the one whose failure is cheap.
  ///
  /// Filtered on: "find me a disposable principal in this environment" is the
  /// read every destructive scenario makes before it will run at all, and
  /// `@@index([environmentId, principalKind])` below is that query's index.
  principalKind         PrincipalKind      @default(PERSISTENT)
  /// Where this identity is in its life. See the enum for why ten.
  ///
  /// DEFAULT ACTIVE, because a profile that exists and has a storageState is
  /// by definition one we have signed in as. A disposable profile moves through
  /// PROVISIONING → ACTIVE → DESTROYED under the scenario that owns it.
  principalLifecycle    PrincipalLifecycle @default(ACTIVE)
  /// THE SCENARIO THAT CREATED THIS IDENTITY, for a disposable one.
  ///
  /// Required for disposability in `proveDisposable`, and the reason is not
  /// bookkeeping: "disposable" with no creator is a claim nobody made. The only
  /// principal a scenario may destroy is one it brought into existence, and
  /// this column is what makes that CHECKABLE rather than asserted. The fastest
  /// way to delete the customer's account is to copy the shared session into a
  /// new profile and label it DISPOSABLE; an empty column here refuses that.
  ///
  /// Null on every PERSISTENT row, for ever. Nothing created them.
  createdByScenario     String?
  /// When a disposable identity was actually destroyed, or null.
  ///
  /// Kept beside `principalLifecycle` rather than derived from it because the
  /// pair (lifecycle DESTROYED, disposedAt null) is a state that can only arise
  /// from a bug in the teardown path, and a column that cannot express the
  /// inconsistency cannot reveal it.
  disposedAt            DateTime?
  /// THE TENANT THIS IDENTITY BELONGS TO, as the APPLICATION UNDER TEST spells
  /// it — never as QAAI spells it.
  ///
  /// The cross-tenant sweep needs tenant A's TOKEN and tenant B's IDS to be two
  /// separately addressable facts: hold a principal in tenant A, take the ids
  /// harvested while acting in tenant B, and ask A for each one. That is the bug
  /// class that ends a company, and with one session per run it was
  /// inexpressible — the IDOR check asked ANONYMOUSLY and tested whether an
  /// anonymous visitor is denied, which every application gets right.
  ///
  /// Null means the application has no tenancy, or nobody said. Null is NOT a
  /// tenant: `admitCrossTenantProbe` refuses the sweep with NO_TENANCY rather
  /// than comparing null against null and reporting no leakage found.
  tenantId              String?
  /// What a human calls the tenant. Shown in reports; never compared.
  tenantLabel           String?
  /// Cached Playwright storageState, refreshed on expiry (§2).
  storageState          Json?
  storageStateExpiresAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  environment   Environment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  /// Tests that execute AS this profile. See Test.authProfileId for why that
  /// foreign key is SetNull rather than Cascade or Restrict.
  tests         Test[]
  /// What happened when we tried to enumerate as this identity, and what each
  /// route gave it.
  crawlAttempts RoleCrawlAttempt[]
  accessCells   RouteAccessCell[]

  @@unique([environmentId, name])
  @@index([orgId])
  /// "Is there a disposable identity in this environment?" — asked before every
  /// destructive scenario, and the answer decides whether the scenario runs or
  /// is recorded as UNEXERCISABLE. Without this index that is a scan of every
  /// profile in the install on a read that happens once per scenario.
  @@index([environmentId, principalKind])
  /// "Which identities belong to the other tenant?" — the cross-tenant sweep's
  /// own query, run once per sweep per tenant pair.
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Flow map & plan (§3.1)
// ─────────────────────────────────────────────────────────────────────────────

/// Whether a crawl may be the denominator. Mirrors CRAWL_ACCEPTANCE_STATES in
/// packages/shared/src/flow-map.ts; `check:enums` diffs them.
///
/// The three are not a quality score. ACCEPTED means measure against it.
/// CANDIDATE means it is stored and visible and NOTHING measures against it,
/// because a degraded crawl that replaces the denominator makes the coverage
/// percentage go up. REJECTED means nothing usable was enumerated at all, so
/// the previous map stands.
enum CrawlAcceptanceState {
  ACCEPTED
  CANDIDATE
  REJECTED
}

model FlowMap {
  id              String  @id @default(cuid())
  orgId           String
  projectId       String
  environmentId   String
  version         Int
  /// Serialised FlowMap from packages/shared. Kept whole rather than normalised:
  /// it is written once per crawl, read as a unit, and diffed version-to-version.
  graph           Json
  nodeCount       Int     @default(0)
  edgeCount       Int     @default(0)
  journeyCount    Int     @default(0)
  /// Kept: twenty readers render it, and it is the only such sentence on every
  /// map already stored. Also not enough on its own — it can say "stopped
  /// early" and never "at least 240 more URLs existed", which is what
  /// `atLeastMoreUrls` below is for. A writer sets both.
  truncatedReason String?

  /// Which declarer produced this map. SurfaceSource, not a second vocabulary.
  ///
  /// ── THE DEFECT, AND IT IS THE WORST ONE IN THIS TABLE ───────────────────────
  ///
  /// `flowMapFromSource` in apps/worker/src/processors/analyze-source.ts writes
  /// a map DERIVED FROM THE REPOSITORY with its own version number, and 13 of
  /// the 16 readers select `findFirst({ where: { projectId }, orderBy: { version:
  /// 'desc' } })`. So a source-derived map at v9 displaces a real crawl at v8
  /// and the denominator silently becomes "whatever the route table says" —
  /// with no forms, no states and no affordances. There was nothing on the row
  /// to filter by; this is that something.
  ///
  /// `selectFlowMap` in packages/shared/src/flow-map.ts ranks an OBSERVED map
  /// (CRAWL, TRAFFIC) above a DECLARED one REGARDLESS OF VERSION, because a
  /// version is a sequence number and not evidence.
  derivedFrom      SurfaceSource?
  /// Whether this map may BE the denominator.
  ///
  /// A crawl run while the site was down, rate-limited or logged out returns a
  /// small graph, is written as the newest version, and every reader picks it
  /// up: the denominator collapses, the numerator does not, and the coverage
  /// percentage goes UP on the day the customer's environment fell over, with
  /// nobody told. A degraded crawl is therefore held as a CANDIDATE — stored,
  /// visible and diffable, and not measured against until a human or a later
  /// clean crawl resolves it.
  ///
  /// Null for every row written before adjudication existed. `selectFlowMap`
  /// ranks null BETWEEN accepted and candidate: it is not evidence of health,
  /// and it is not evidence of degradation either.
  acceptance       CrawlAcceptanceState?
  /// Why it is a CANDIDATE or was REJECTED, in the customer's words. Never set
  /// for ACCEPTED, and never null for the other two — "degraded" with no reason
  /// is a denominator nobody can audit.
  acceptanceReason String?
  /// ENUMERATION_OUTCOMES: CONVERGED, STOPPED or FAILED.
  ///
  /// Converged and stopped produce the same `nodeCount` and completely
  /// different denominators, and "enumeration converged" is the most tempting
  /// false sentence this feature has available — it is what every cap makes a
  /// crawl look like from the inside. CONVERGED requires an empty frontier AND
  /// no cap that bit; `enumerationOutcome` decides, deterministically.
  ///
  /// Text and not an enum, for the same reason as
  /// `CoverageItem.unexercisableReason`: the domain is enforced at the producer.
  convergence      String?
  /// AT LEAST this many more distinct in-scope URLs existed and were not
  /// enumerated.
  ///
  /// THE SINGLE MOST IMPORTANT COLUMN IN THE ENUMERATION SLICE. A truncated
  /// crawl makes the coverage percentage go UP, so every cap is a lever that
  /// silently flatters us; this is the number that makes the lever visible.
  /// `unvisitedQueued + beyondDepth` — URLs we actually held in a queue or
  /// actually saw past the depth limit, so it is a floor and not an estimate.
  /// Refused URLs are NOT in it (they are known by name, in the graph's
  /// exclusion ledger), off-origin URLs are not our surface, and unreachable
  /// URLs are unknown rather than absent.
  atLeastMoreUrls  Int?
  /// How many URLs a policy rule refused. The report line "your crawl policy
  /// refused 31 URLs", which today cannot be written at all: the crawler drops
  /// them with no record, so a refused route and a route the application does
  /// not serve are indistinguishable afterwards.
  excludedCount    Int?
  /// AppliedCrawlPolicy — the policy in force for THIS crawl, and which of its
  /// fields anybody actually chose.
  ///
  /// A copy and not a join to `Environment.crawlPolicy` on purpose: the policy
  /// moves, and the question a report answers is "what was this number measured
  /// under", which the current policy cannot answer for a crawl from last month.
  policyApplied    Json?
  createdAt        DateTime              @default(now())

  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment       Environment            @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  testPlans         TestPlan[]
  /// The per-role attempts that produced this map, the triggers whose last run
  /// produced it, and the diffs it is either side of.
  roleCrawlAttempts RoleCrawlAttempt[]
  triggerLastRuns   ReEnumerationTrigger[]
  driftBaselines    SurfaceDriftRecord[]   @relation("SurfaceDriftBaseline")
  driftCurrents     SurfaceDriftRecord[]   @relation("SurfaceDriftCurrent")

  @@unique([projectId, environmentId, version])
  @@index([orgId])
  /// THE CORRECT READ, which no reader can currently make.
  ///
  /// `(projectId, environmentId)` are equalities on every correct read — an
  /// environment filter is a MATCH and not a preference, because a staging
  /// crawl is not a weaker measurement of production but a measurement of
  /// something else. `acceptance` is the third equality (or a small IN list),
  /// and `version` last so the btree can supply the ORDER BY scanned backwards
  /// and the LIMIT stops early. The existing unique index cannot do this: it
  /// has no `acceptance`, so filtering on it would mean reading every version
  /// of the environment and sorting in memory.
  @@index([projectId, environmentId, acceptance, version])
}

model TestPlan {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  flowMapId String?
  summary   String
  skipped   Json     @default("[]")
  createdAt DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flowMap FlowMap?   @relation(fields: [flowMapId], references: [id], onDelete: SetNull)
  items   PlanItem[]

  @@index([orgId, projectId])
}

model PlanItem {
  id              String        @id @default(cuid())
  orgId           String
  testPlanId      String
  title           String
  rationale       String
  feature         String
  priority        Priority
  testType        TestType
  steps           Json // string[]
  assertions      Json // string[]
  journeyId       String?
  authProfileId   String?
  /// WHICH ACTORS THIS ITEM NEEDS, so a producer can say so.
  ///
  /// `authProfileId` above names at most one identity, which is why a producer
  /// that wanted two had nowhere to put the second. Same shape and same Json
  /// rationale as `Test.principals`; the Generator copies this across when it
  /// turns the item into a test, and a scenario that needs a disposable
  /// principal declares it HERE, where the approval step can see it before
  /// anything is created.
  principals      Json?
  /// THE BOUNDARY CLASS THIS ITEM ATTACKS, or null for a positive-path item.
  ///
  /// `BoundaryClass` in packages/shared/src/boundaries.ts — EMPTY,
  /// WHITESPACE_ONLY, TOO_LONG, CHECKSUM_INVALID, LEAP_DAY and the rest.
  ///
  /// Why it is on the item at all: one whole feature became ONE negative item
  /// derived from the FIRST required field, so there was no way to tell two
  /// negative items apart, no way to ask "which classes has this field been
  /// attacked at?", and therefore no way for the closure loop to notice that
  /// twenty-six of the twenty-seven classes had never been tried.
  ///
  /// TEXT AND NOT AN ENUM, on the same judgement as `gapKind` above and
  /// `MutationSurvivor.reason`: nothing FILTERS rows on it — the reads are
  /// "show me this item" and "group this project's items by class" — so an
  /// enum would be one more Postgres type whose only job is to need a drift
  /// guard. Its domain is enforced at the producer by `boundaryClassSchema`,
  /// and the run-time parity for it lives in
  /// packages/shared/src/boundaries.test.ts.
  boundaryClass   String?
  /// The coverage gap this item was minted to close — `CoverageGap.id` from
  /// packages/agent/src/coverage.ts, which is a stable hash of (kind, subject)
  /// and therefore the same id the next analysis will produce for the same gap.
  ///
  /// ── The defect this closes ─────────────────────────────────────────────────
  ///
  /// POST /coverage/:projectId/propose already knew the answer: it mints the row
  /// ids itself and returns `mapping: [{ gapId, planItemId }]` in the HTTP
  /// response. That mapping existed for the length of one request and was then
  /// thrown away. So QAAI could never afterwards say "this gap is closed by this
  /// test" — and, much worse, could never notice that it is NOT: a gap whose
  /// test was written, bound and passed, and which the next analysis reports
  /// again, was indistinguishable from a gap nobody had ever looked at. The loop
  /// the product is sold on had no memory, so it could only ever be hopeful.
  ///
  /// Nullable, and nullable forever: the Explorer proposes a cold plan from a
  /// crawl with no gap behind it, and back-filling an id onto those rows would
  /// invent a provenance that never existed.
  gapId           String?
  /// The gap's kind when it was proposed (`GapKind`), kept beside the id
  /// because the id is a hash and tells a reader nothing. Text, not an enum —
  /// see `Project.closureApprovalPolicy` for why.
  gapKind         String?
  /// THE MATRIX CELLS THIS ITEM ASKS FOR, and the cap that was applied.
  ///
  /// `TestMatrix` in packages/shared/src/schemas.ts — a cell list, the full
  /// product size it was taken from, and a nullable `capBite`. Json for the same
  /// reason `steps` and `assertions` are: it is a list of structured values with
  /// no read that filters on their contents, and a column per axis would be a
  /// migration per axis.
  ///
  /// NULL MEANS NOBODY DECLARED A MATRIX, which is NOT the same as an empty cell
  /// list. An empty list is the unvaried single run every test in this product
  /// has always been — a decision. Null is the absence of one, and it is what
  /// every row written before this column existed is. The distinction matters
  /// because the approval screen shows "runs in 12 cells" for one and nothing at
  /// all for the other, and defaulting null to `{ cells: [] }` would claim a
  /// decision the proposer never made.
  ///
  /// The cap travels INSIDE it on purpose. A cell list expanded under a limit
  /// that bit is a SAMPLE, and a reader handed the list alone cannot tell it
  /// from a matrix somebody chose — so any percentage over it would read as a
  /// percentage over the matrix.
  matrixCells     Json?
  /// THE BROWSER ENVIRONMENT BLOCK this item needs — geolocation, permissions,
  /// fake media, clipboard, throttling, offline, forced-colors, device scale and
  /// HTTP credential NAMES.
  ///
  /// `BrowserEnvironment` in packages/shared/src/browser-matrix.ts. Every field
  /// is optional and ABSENT MEANS THE BROWSER'S OWN DEFAULT, which is why the
  /// column is nullable with no default: a defaulted block would be a set of
  /// fabricated values, and a defaulted geolocation in particular would make
  /// every location-dependent test pass at 0,0 — Null Island, a real coordinate
  /// the browser accepts, somewhere nobody chose.
  ///
  /// NEVER A CREDENTIAL. `httpCredentials` carries secret NAMES only; the schema
  /// is `.strict()` and has no password property, so an extra one is refused
  /// rather than stored. Same guarantee, and same argument, as the provider
  /// catalogue's entry shape.
  browserEnv      Json?
  state           PlanItemState @default(PROPOSED)
  decidedBy       String?
  decidedAt       DateTime?
  /// Set once the Generator turns this into a Test.
  generatedTestId String?
  createdAt       DateTime      @default(now())

  testPlan TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([testPlanId, state])
  /// "Which item was minted for this gap?" — asked once per gap per close-loop
  /// tick while the ledger is reconciled. Without it that is a scan of every
  /// plan item the install has ever produced.
  @@index([gapId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Suites & tests
// ─────────────────────────────────────────────────────────────────────────────

model Suite {
  id          String   @id @default(cuid())
  orgId       String
  projectId   String
  name        String
  description String?
  /// Tests are also selectable by tag; a suite is a saved selection.
  tagFilter   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tests     Test[]
  runs      Run[]
  schedules Schedule[]
  monitors  Monitor[]

  ownershipRules OwnershipRule[]

  @@unique([projectId, name])
  @@index([orgId])
}

model Test {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  suiteId   String?
  name      String
  type      TestType
  feature   String?
  priority  Priority @default(IMPORTANT)
  /// Current source. History lives in TestVersion.
  code      String
  filePath  String
  /// Type-specific config: the API request chain, the k6 thresholds, the viewports.
  spec      Json?
  tags      String[] @default([])
  timeoutMs Int      @default(60000)

  /// Flake radar (§5). Maintained by the run finaliser, not computed on read.
  quarantined         Boolean   @default(false)
  quarantinedAt       DateTime?
  quarantineReason    String?
  /// When this quarantine stops suppressing. A quarantine with no end date is a
  /// deletion nobody signed, so every quarantine written from now on gets one
  /// (QUARANTINE_MAX_DAYS in packages/runner/src/gates.ts).
  ///
  /// Expiry does NOT clear `quarantined`. Once this date passes the test GATES
  /// AGAIN while the row keeps saying what was suppressed and why — see
  /// `quarantineSuppresses`. Clearing the flag instead would erase the reason
  /// and fight the measured auto-release in processors/flake.ts, which owns
  /// that column.
  ///
  /// Null is honoured as "never expires", which is what every row written
  /// before this column existed is. Back-filling an expiry onto quarantines a
  /// customer never agreed to would turn thousands of suppressed failures red
  /// in one deploy — a migration deciding to break a build. The gate WARNs
  /// about them instead.
  quarantineExpiresAt DateTime?
  /// Current value of the flake rate, kept for sorting and filtering the suite
  /// tree. OVERWRITTEN on every run: the HISTORY is TestFlakeHistory, and
  /// anything asking "is this getting worse?" must read that instead of this.
  flakeRate           Float     @default(0)
  lastRunAt           DateTime?
  consecutiveFailures Int       @default(0)

  /// Selectors the Generator was unsure about; the cockpit shows a review badge.
  reviewFlags String[]  @default([])
  /// Which plan item produced this, when it came from the Explorer.
  planItemId  String?
  /// The coverage gap this test was written to close, copied from
  /// `PlanItem.gapId` when the Generator's output lands.
  ///
  /// It is denormalised onto the test ON PURPOSE, and the reason is the whole
  /// point of the column: closure has to be checkable from the TEST side. The
  /// question the product must be able to answer is "this gap is open again —
  /// which test was supposed to have closed it, and does that test still
  /// exist, still run, and still assert what it was written to assert?".
  /// Walking Test → PlanItem → gap answers it only while the plan survives,
  /// and a TestPlan is deletable (`onDelete: Cascade` from the project, and the
  /// retention sweep prunes old plans), so the provenance would evaporate
  /// exactly when the loop needed it. A denormalised id is one more thing that
  /// can disagree with its source; a provenance trail that disappears is worse.
  ///
  /// Null is the ordinary case and always will be: hand-written tests, imported
  /// tests and the Explorer's cold plan close no particular gap. Null is never
  /// read as "closes nothing" — the closure ledger (`GapClosure`) is the
  /// authority on what is closed, and this column is what lets it name a test.
  gapId       String?
  /// WHAT THIS TEST IS FOR, SAID OUT LOUD — surface item keys the test claims
  /// to cover.
  ///
  /// THE DEFECT: the numerator was derived entirely by regex over test source.
  /// Many tests are unreadable to that extractor — a page object, a
  /// fixture-driven table test, a helper that builds its URL from a factory —
  /// and there was NO WAY, for a human or for our own generator, to state what
  /// a test is for. The product asked customers to believe a coverage number
  /// and gave them no way to correct it.
  ///
  /// A DECLARATION IS A CLAIM, NOT PROOF. It is authoritative against a regex's
  /// guess about INTENT and it is the weakest evidence there is about the
  /// NUMBER: it feeds a `SPEC` edge, whose ceiling is DECLARED
  /// (`COVERAGE_EDGE_SOURCE_CEILING`), so it can never reach PASSING without a
  /// run observing the test. If it could, `covers: ['ROUTE:/billing']` would be
  /// a one-line way to manufacture a green coverage report and this column
  /// would be the largest hole in the product rather than the fix for one.
  ///
  /// `String[]` with an EMPTY DEFAULT, which is honest here where it would not
  /// be on a count: `[]` means this test declares nothing, and that is the
  /// ordinary case for every hand-written and imported test — there is no
  /// fourth state between "declares nothing" and "declares an empty list".
  covers      String[]  @default([])
  /// THE MATRIX CELLS AND THE ENVIRONMENT BLOCK, copied across when the
  /// Generator turns a `PlanItem` into a test. Identical contract, identical
  /// null semantics and identical no-credential guarantee — see the long notes
  /// on `PlanItem.matrixCells` and `PlanItem.browserEnv`.
  ///
  /// Beside `spec` rather than inside it, and the reason is the only thing worth
  /// adding here: `spec` is TYPE-SPECIFIC and is parsed by exactly one plugin,
  /// while a matrix cell set and an environment block are read by the harness
  /// BEFORE any plugin is chosen — the browser is launched from them. Burying
  /// them in `spec` would mean the harness parsing nineteen different shapes to
  /// find out what browser to start.
  matrixCells Json?
  browserEnv  Json?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// The ROLE this test executes as (§2): the auth profile whose cached
  /// storageState the runner injects before the first navigation. Null means
  /// anonymous, which is a real answer and not a missing one — most tests have
  /// no business signing in.
  ///
  /// Its absence was the defect. The session was chosen per RUN and never per
  /// test, so an admin test and a member test could not sit in the same suite
  /// and role-differentiated testing was inexpressible. It also closed a loop
  /// in coverage: an UNREACHED_AUTH_ROUTE gap asks for a test that signs in,
  /// the only test that could be generated asserted anonymous denial, and so
  /// closing the gap re-created the gap, for ever.
  ///
  /// `onDelete: SetNull`, deliberately, and neither Cascade nor Restrict.
  /// Cascade would mean deleting a stale profile silently deletes the
  /// customer's tests — the code is the asset, the session is only a
  /// credential. Restrict would turn "delete this profile" into an error no
  /// customer can clear without hunting down every test by hand. But SetNull
  /// on its own makes the worse failure SILENT: the binding evaporates, the
  /// test runs anonymously, passes whatever an anonymous visitor can see, and
  /// is counted as coverage of a page it never reached. That is what
  /// `authProfileRequired` below exists to prevent.
  authProfileId       String?
  /// "This test is meaningless signed out." The INTENT, where authProfileId is
  /// the BINDING, and the two are stored separately on purpose: deleting a
  /// profile nulls the binding and must NOT clear the intent. The pair
  /// (required = true, id = null) is a state nothing else can produce, and it
  /// is the state coverage analysis reports out loud — a test with a broken
  /// auth binding does not count as authenticated coverage, so the gap it was
  /// written to close correctly re-opens with the reason attached.
  ///
  /// Set by whoever asked for the role: a plan item that named a profile, or a
  /// person in the editor. Never set by the runner.
  authProfileRequired Boolean @default(false)
  /// THE ACTORS THIS TEST NEEDS, when one identity is not enough.
  ///
  /// `authProfileId` above binds the test to ONE session and is the right
  /// answer for most tests. It cannot express a test that needs TWO — and the
  /// tests that need two are the authorization tests: a holder and a subject,
  /// an inviter and an invitee, a submitter and an approver, a tenant and
  /// another tenant. With one storageState per run, "user A can read user B's
  /// invoice" was inexpressible, so the IDOR check fetched ids anonymously and
  /// asked whether an anonymous visitor is denied.
  ///
  /// Json and not a join table, deliberately. A principal is SCENARIO-LOCAL: it
  /// is a NAME the test uses for an actor ("victim", "invitee", "memberA"),
  /// bound to an AuthProfile id, and it has no identity or lifetime outside the
  /// test that names it. A join table would invite rows to be shared between
  /// tests, and two tests sharing a disposable principal is a destructive
  /// scenario destroying another test's actor mid-run. Validated by
  /// `principalSchema` in packages/shared/src/schemas.ts, which is `.strict()`
  /// and has no field a credential could sit in.
  ///
  /// Null means "this test predates principals" and `[]` means "it declares
  /// none". Both behave as the single-identity case, which is what every
  /// existing test is.
  principals          Json?

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite?           @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  authProfile AuthProfile?     @relation(fields: [authProfileId], references: [id], onDelete: SetNull)
  versions    TestVersion[]
  results     TestResult[]
  heals       HealProposal[]
  baselines   VisualBaseline[]

  ownershipRules OwnershipRule[]
  flakeHistory   TestFlakeHistory[]

  /// "Which acceptance criteria does this test cover, and which manual case did
  /// it replace?" — the reverse of the traceability matrix, and the read the
  /// test detail page makes.
  requirementLinks RequirementLink[]
  manualTestCases  ManualTestCase[]
  /// The surface this test is believed to cover, per source of evidence. The
  /// read the deletion path makes before coverage is allowed to fall, and the
  /// reason coverage CAN fall at all.
  coverageEdges    TestCoverageEdge[]

  @@index([orgId])
  @@index([projectId, type])
  @@index([suiteId])
  /// The budget check's own query: "how many tests in this project are
  /// quarantined right now?", asked before every quarantine and once per run
  /// finalisation. Without it that is a full scan of the project's tests.
  @@index([projectId, quarantined])
  /// Read by the profile-deletion path and by "which tests run as this role?";
  /// without it both are a full scan of every test in the install.
  @@index([authProfileId])
  /// "Which test was written to close this gap?" — the read behind every
  /// re-opened-gap finding, and the one that has to be fast enough to run for
  /// every row in the ledger on one close-loop tick.
  @@index([gapId])
}

/// Flake rate over time: one row per test per UTC day.
///
/// ── The defect ──────────────────────────────────────────────────────────────
/// `Test.flakeRate` is a single Float, overwritten on every run, and the
/// suite-health score is recomputed per request from whatever is current. So
/// rot had no DIRECTION: "is this suite getting worse?" was unanswerable, a
/// test that had been degrading for three weeks looked exactly like one that
/// flaked once this morning, and there was nothing to diff a release against.
///
/// ── The retention rule, and what it loses ───────────────────────────────────
/// ONE ROW PER TEST PER UTC DAY, kept for `FLAKE_HISTORY_RETENTION_DAYS`
/// (90, in apps/worker/src/processors/flake.ts). The `(testId, day)` unique
/// constraint IS the aggregation: the day's row is upserted in place, so the
/// write volume is bounded by tests x days and not by runs. A 5,000-test suite
/// running hourly writes 120,000 measurements a day and stores 5,000 rows;
/// over the full window that is 450,000 rows, which is the point of the rule.
///
/// What it loses, stated plainly rather than discovered later:
///
///   1. INTRA-DAY RESOLUTION. A test that broke at 10:00 and was fixed by 14:00
///      shows one value for that day. `peakRatePercent` and `worstAt` keep the
///      WORST moment so a spike is not erased, but the shape of the day is
///      gone — you cannot tell one bad hour from a bad afternoon.
///   2. WHICH run was worst survives (`worstRunId`); the other twenty-three
///      runs' ids do not. Tracing a specific regression to a specific run needs
///      TestResult rows, which have their own retention.
///   3. ANYTHING OLDER THAN 90 DAYS. A year-over-year comparison is not
///      available from this table and is not meant to be. CoverageSnapshot is
///      the precedent for keeping a long trend; if a longer flake trend is
///      wanted it belongs in a monthly rollup, not in a bigger window here.
///   4. A DAY WITH NO RUNS HAS NO ROW. Absence means "not measured", never
///      "0% flaky" — a reader that fills gaps with zero will invent a recovery
///      that never happened.
model TestFlakeHistory {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  testId    String

  /// Midnight UTC of the day this row aggregates. The bucket key, and the
  /// reason the table cannot grow with the run rate.
  day DateTime

  /// The day's LAST measurement, 0-100. "Where it ended up."
  ratePercent     Float
  /// The day's WORST measurement. Kept so collapsing a day cannot hide a spike.
  peakRatePercent Float
  /// When the peak was measured, and the run that produced it.
  worstAt         DateTime
  worstRunId      String?

  /// Results the last measurement was computed from. A 100% rate over 2 samples
  /// is not the same claim as 100% over 50, and a trend drawn without the
  /// denominator cannot tell a regression from a small sample.
  sampleSize Int @default(0)
  /// Failures inside that window, so the rate is recomputable rather than taken
  /// on faith.
  failures   Int @default(0)
  /// How many measurements landed in this bucket. 1 means no aggregation
  /// happened and the row is a single reading.
  samples    Int @default(1)

  /// Whether a quarantine was in force when the day's last measurement was
  /// taken. Without it a flat 0% reads as a healthy test when it is actually a
  /// suppressed one nobody is gating on.
  quarantined Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  /// The aggregation, as a constraint. An upsert on this key is what turns N
  /// measurements a day into one row, and it is enforced by the database rather
  /// than by every writer remembering to.
  /// The aggregation, as a constraint — and ALSO the index for "show me this
  /// test's trend". There is deliberately no second index on
  /// (testId, day(sort: Desc)): this one already serves it, because a btree
  /// scans backwards and a single-direction sort needs no matching index
  /// direction (the same reasoning as the createdAt indexes in
  /// migrations/20260824000000_query_plan_indexes). A second index would be
  /// write amplification on a hot table for nothing.
  @@unique([testId, day])
  @@index([orgId])
  /// "Is this PROJECT getting worse?" — the suite-level trend, and the sweep's
  /// own retention delete, which scans by day.
  @@index([projectId, day])
}

/// Every code change to a test, whether from a human, the Generator, or a Heal.
model TestVersion {
  id        String   @id @default(cuid())
  orgId     String
  testId    String
  version   Int
  code      String
  /// "GENERATOR" | "HEAL" | "HUMAN" | "IMPORT"
  source    String
  authorId  String?
  message   String?
  createdAt DateTime @default(now())

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, version])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Runs (§5)
// ─────────────────────────────────────────────────────────────────────────────

model Run {
  id            String     @id @default(cuid())
  orgId         String
  projectId     String
  suiteId       String?
  environmentId String
  status        RunStatus  @default(QUEUED)
  trigger       RunTrigger @default(MANUAL)
  triggeredBy   String?

  /// CI context, when the run came from a PR or a deploy.
  commitSha       String?
  branch          String?
  prNumber        Int?
  /// Preview-deploy runs override the environment's base URL (§6).
  baseUrlOverride String?

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  totalCount             Int @default(0)
  /// Failures that GATE. A quarantined test's failure is NOT counted here —
  /// that is the whole fix; see packages/runner/src/gates.ts.
  passedCount            Int @default(0)
  failedCount            Int @default(0)
  flakyCount             Int @default(0)
  skippedCount           Int @default(0)
  /// Failures a quarantine in force suppressed.
  ///
  /// A column of its own, and NOT added to `skippedCount`, because a deliberate
  /// skip and a failure somebody switched off are different facts. Folding them
  /// together is how a suite with forty quarantined tests reports a clean green
  /// board; keeping them apart is what lets every surface say "0 failed, 3
  /// quarantined and failing" instead of "0 failed".
  quarantinedFailedCount Int @default(0)

  /// GateResult from packages/shared. Null until the run finalises.
  gateResult   Json?
  /// Set when the run itself blew up rather than tests failing.
  errorMessage String?

  /// How many shards the suite was split across (§5 build sharding). 1 means the
  /// run was not sharded, which is every run unless the caller asked for more.
  shardCount  Int       @default(1)
  /// The finalisation claim. Set by a conditional UPDATE, so exactly one shard
  /// can win it and write the run's terminal status; see apps/worker run.ts.
  /// Distinct from `finishedAt`, which the cancel endpoint also writes.
  finalizedAt DateTime?

  /// §5 fail-fast: stop at the first real failure. Written when the run is
  /// created, polled by the worker between tests.
  ///
  /// A column rather than a queue message or a Redis flag, because a sharded run
  /// must have exactly one source of truth about whether it should still be
  /// running. Five workers polling one row is how cancellation already works;
  /// inventing a second channel for the same idea is how two shards come to
  /// disagree about whether the run is over.
  failFast        Boolean   @default(false)
  /// Stamped the moment something decides this run should stop early: the worker
  /// on the first real failure of a fail-fast run, or a human pressing stop.
  ///
  /// Deliberately NOT `status = CANCELLED`. A fail-fast stop is a FAILED run
  /// that chose not to finish, and filing it as cancelled would hide a broken
  /// build behind a word that means "nobody wanted the answer".
  stopRequestedAt DateTime?
  /// Why it stopped, in a sentence the run page can show verbatim — which test
  /// tripped it, or who pressed stop.
  stopReason      String?

  /// Copied from Environment.runnerPool when the run is created, and the reason
  /// this column exists rather than being read through the relation: it is the
  /// record of where this run was DISPATCHED, which must not change under it if
  /// someone edits the environment mid-run.
  ///
  /// Non-null means the run was handed to the customer's own agents and NO job
  /// was enqueued on our queue. Exactly one of the two dispatch paths runs a
  /// given run — that is what stops a suite executing twice, once in each place.
  runnerPool String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite?       @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  environment Environment  @relation(fields: [environmentId], references: [id])
  results     TestResult[]
  artifacts   Artifact[]
  shards      RunShard[]
  runnerJobs  RunnerJob[]
  shares      RunShare[]

  @@index([orgId])
  @@index([projectId, queuedAt])
  @@index([status])
  @@index([commitSha])
  /// The flake sweep's own query, and the only prefix search in the product:
  /// "every confirmation run tagged `flake-radar:` queued in the last 24h",
  /// cross-org, every five minutes. `text_pattern_ops` is not decoration — this
  /// database collates en_US, and under a non-C collation a default btree
  /// CANNOT serve `LIKE 'prefix%'` at all, so the same index without the
  /// operator class would be ignored and the sweep would keep reading the whole
  /// table. `queuedAt` trails the prefix so the 24h bound is applied inside the
  /// index instead of by fetching every confirmation run ever made.
  @@index([triggeredBy(ops: raw("text_pattern_ops")), queuedAt])
}

/// One slice of a sharded run: its own queue job, its own worker, its own tests.
///
/// A sharded run finishes only when every one of these rows is terminal — the
/// row is the durable record of that, because the worker holding a shard can
/// die and nothing in Redis would tell the other shards whether it ever ran.
model RunShard {
  id     String         @id @default(cuid())
  orgId  String
  runId  String
  /// 0-based, and matches TestResult.shardIndex.
  index  Int
  /// Denormalised sibling count so a shard knows the split it belongs to.
  total  Int
  status RunShardStatus @default(QUEUED)

  /// What the duration-balanced packer put here, and what it predicted. Kept so
  /// "why did shard 3 take twice as long" is answerable after the fact.
  testCount   Int @default(0)
  estimatedMs Int @default(0)

  passedCount            Int @default(0)
  failedCount            Int @default(0)
  flakyCount             Int @default(0)
  skippedCount           Int @default(0)
  /// Mirrors Run.quarantinedFailedCount for this slice, so a shard's own report
  /// in the cockpit cannot say something the run's total contradicts.
  quarantinedFailedCount Int @default(0)

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Stamped on a timer while the shard executes. A worker that dies stops
  /// stamping, which is how the surviving shards notice and reap it instead of
  /// leaving the run open forever.
  heartbeatAt DateTime?

  errorMessage String?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([orgId])
  @@index([runId, status])
}

model TestResult {
  id               String           @id @default(cuid())
  orgId            String
  runId            String
  testId           String
  status           TestResultStatus
  durationMs       Int              @default(0)
  errorMessage     String?
  /// §5 — a retry that passes is not a pass. Recorded so the gate can see it.
  retriedAndPassed Boolean          @default(false)
  /// NetworkEntry[] and ConsoleEntry[], already secret-masked.
  network          Json?
  consoleLog       Json?
  videoKey         String?
  traceKey         String?
  createdAt        DateTime         @default(now())
  /// Which shard of a sharded run owns this test. Null on an unsharded run,
  /// which is what makes sharding additive: every existing row and every
  /// existing code path reads null and behaves exactly as before.
  shardIndex       Int?

  /// Why this result has nothing measured in it — the queryable half of the
  /// four reasons a SKIPPED row exists (see enum NotRunKind above).
  ///
  /// NULL MEANS NOT RECORDED, AND THAT IS A FIFTH STATE. It is NOT NOT_RUN.
  /// NOT_RUN is a claim — "nothing was attempted and nothing says it could not
  /// be" — and it is the one a dead shard or a lost queue job earns. NULL is
  /// the absence of any claim: every row written before this column existed,
  /// and every row written by a path that has not learned to classify yet
  /// (notably the plugins, which return SKIPPED with a plain sentence when
  /// their tool is missing). Scoring NULL as NOT_RUN would put a sentence in
  /// the database that nothing produced; defaulting it to NOT_RUN would do it
  /// to every historical row at once.
  ///
  /// NULLABLE WITH NO DEFAULT, and that is also why there is no `@default`:
  /// this is the largest table in the product, and a nullable column with no
  /// default is recorded in the catalogue without touching a row. See the
  /// migration.
  ///
  /// The tag at the head of `errorMessage` (`notRunMessage` / `parseNotRun` in
  /// @qaai/shared) stays, and is not redundant: it is what a surface renders,
  /// and it is all an old row has. A reader with both prefers this column.
  notRunKind NotRunKind?

  /// ── The mutation metric channel (§4 MUTATION) ─────────────────────────────
  ///
  /// THE DEFECT: the mutation score lived only inside a Step TITLE ("Mutation
  /// score 72.4% — 89 of 123 mutants killed"). It is the answer to "do these
  /// tests actually assert anything?" and the one metric no competitor ships,
  /// and the only way to read it back was a regex over a string column — so it
  /// could not be trended, gated on, or alerted on. Once per run it was
  /// rendered into a sentence and thrown away.
  ///
  /// FIVE SCALAR COLUMNS AND NOT ONE JSON BLOB. The entire point is the trend
  /// query, and `@@index([testId, createdAt])` below already serves "this
  /// test's last N results in order" — so `SELECT createdAt, mutationScore`
  /// over that index answers "is this suite's mutation score going up?" from
  /// the index alone. A `Json` column would make every such read a sequential
  /// scan plus a per-row document parse, and would let a writer put a string
  /// where the number goes.
  ///
  /// NULL MEANS NOT MEASURED. 0.0 means EVERY MUTANT SURVIVED — the worst
  /// result a suite can produce — and conflating the two inverts the signal
  /// completely: the project that has never run mutation testing would look
  /// identical to the project whose tests assert nothing. There are three
  /// states here, and they are all reachable and all distinguishable:
  ///
  ///   · every column NULL          — no mutation run reported anything.
  ///   · counts set, score NULL     — a run happened and produced no VALID
  ///                                  mutant (everything excluded), so there
  ///                                  was no denominator. `mutationExcluded`
  ///                                  says how many were thrown out.
  ///   · score 0.0                  — measured, and nothing was killed.
  ///
  /// `valid` is deliberately not a column: it is `mutationDetected +
  /// mutationUndetected` and a stored copy is one more thing that can disagree
  /// with its own inputs.
  mutationScore      Float?
  mutationDetected   Int?
  mutationUndetected Int?
  /// Not buildable, not runnable — excluded from both sides of the score.
  /// Non-null with a NULL score is the "nothing valid ran" state above.
  mutationExcluded   Int?
  /// The threshold this run was judged against, stored because a score means
  /// nothing without the bar it was held to, and the bar is editable: a trend
  /// read six months later cannot recover what the gate was at the time.
  mutationMinScore   Float?

  run               Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  test              Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  steps             Step[]
  findings          Finding[]
  verdict           TriageVerdict?
  mutationSurvivors MutationSurvivor[]
  /// Per-cell evidence underneath the worst-wins roll-up above. Relation fields
  /// produce NO SQL on this table — see the migration's TestResult section: the
  /// only thing this round does to the largest table in the product is let two
  /// new child tables point at it, and it adds NO COLUMN here.
  variants          TestResultVariant[]
  metricSamples     TestMetricSample[]

  @@unique([runId, testId])
  @@index([orgId])
  @@index([testId, createdAt])
  /// The shard's own query: "give me my slice of this run".
  @@index([runId, shardIndex])
}

model Step {
  id            String     @id @default(cuid())
  orgId         String
  testResultId  String
  index         Int
  title         String
  status        StepStatus
  durationMs    Int        @default(0)
  screenshotKey String?
  errorMessage  String?
  errorStack    String?
  /// The locator that failed, when the failure was a locator failure.
  selector      String?
  expected      String?
  actual        String?
  startedAt     DateTime?

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@unique([testResultId, index])
  @@index([orgId])
}

/// a11y / security / perf / l10n / visual results — first-class, not pass-fail noise.
model Finding {
  id           String          @id @default(cuid())
  orgId        String
  testResultId String
  kind         FindingKind
  severity     FindingSeverity
  code         String
  message      String
  location     String
  helpUrl      String?
  /// Muted findings still record but never gate.
  mutedAt      DateTime?
  createdAt    DateTime        @default(now())

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@index([testResultId])
  @@index([code])
  /// GET /projects/:id/findings: newest-first, capped, filtered to the project
  /// through TestResult -> Run. `createdAt` was the only unindexed part of it,
  /// so the planner had to materialise every finding the project had ever
  /// recorded and sort them to return a thousand.
  ///
  /// The column order is the whole optimisation. `orgId` first because the
  /// tenant extension makes it an equality on every read; `createdAt` second
  /// because that is the ORDER BY, and an equality-constrained prefix is what
  /// lets the index supply the sort (scanned backwards) so LIMIT can stop.
  /// `mutedAt` is deliberately NOT wedged in between: `mutedAt IS NULL` is not
  /// an equality in the planner's sense, it joins no equivalence class, and a
  /// column it cannot pin destroys the ordering of everything after it. That
  /// index was measured and the planner never used it once.
  @@index([orgId, createdAt])
}

/// A mutant the suite did not catch — the actionable half of a mutation run.
///
/// The score says the suite is weak; a row here says WHERE. "`>` became `>=`
/// at src/cart.ts:42 and every test still passed" names one missing assertion,
/// which is a task a person can finish. That detail used to exist only as a
/// FAILED Step with the location inside its title, so "which mutants keep
/// surviving across runs?" — the question that tells a team where its suite is
/// thinnest — had no answer.
///
/// ── Volume: why the rows are kept, and why only for a while ────────────────
///
/// A 200-mutant run on a 5,000-test suite is a lot of rows, and both obvious
/// policies are wrong in different directions. "Only the newest run's
/// survivors" throws away the one thing a survivor list is good for, which is
/// noticing that the same mutant has survived for six weeks. "Every survivor
/// forever" grows without bound with the RUN RATE — hourly CI on a big module
/// is millions of rows a year describing code that has since been rewritten.
///
/// So the two halves are kept on different clocks, deliberately:
///
///   · THE NUMBERS (the five columns on TestResult) are kept as long as the
///     result row itself, which nothing deletes. Five scalars on a row that
///     already exists cost nothing, so the TREND is permanent.
///   · THE DETAIL (these rows) is pruned at `MUTATION_SURVIVOR_RETENTION_DAYS`
///     (90, in apps/worker/src/processors/retention.ts) — the same window
///     `FLAKE_HISTORY_RETENTION_DAYS` uses, and the longest retention any plan
///     buys for the results it describes, so detail never outlives the
///     evidence behind it. A survivor list also goes stale the moment the
///     source moves: a mutant at line 42 of a file that was refactored in
///     March is not a task anybody can act on in June.
///
/// And one bound at WRITE time: at most `MAX_PERSISTED_SURVIVORS` rows per
/// result (apps/worker/src/processors/run.ts). The COUNTS stay exact — the cap
/// truncates the list, never the arithmetic — so a capped result still reports
/// its true `mutationUndetected` and says, honestly, that it is showing the
/// first N of them.
///
/// WHAT THIS LOSES, stated here rather than discovered later: after 90 days a
/// result keeps its score and loses its survivor names, and a result with no
/// rows is "detail aged out or never recorded", never "zero survivors" — the
/// count column is the only thing that may be read as a count.
model MutationSurvivor {
  id           String @id @default(cuid())
  orgId        String
  testResultId String

  /// Path or class exactly as the tool named it (`src/cart.ts`,
  /// `com.acme.Cart`). Never normalised: a path we rewrote is a path that no
  /// longer opens in an editor, and the tools disagree about shape.
  file    String
  /// Null when the tool reported no line. NOT 0 — line 0 does not exist, and a
  /// zero here would send a reader to the top of the file with confidence.
  line    Int?
  /// The mutation operator: `ArithmeticOperator`, `ConditionalsBoundary`, …
  mutator String
  /// What the tool says it changed, when it says.
  detail  String?
  /// `survived` | `no-coverage` — a survivor no test even executed.
  ///
  /// A String and not a Prisma enum on purpose. `apps/api/scripts/check-enums.ts`
  /// enforces schema/TypeScript parity from a HAND-MAINTAINED list (`PAIRS`),
  /// so a new enum added without an entry there is an enum with no drift guard
  /// at all — and the drift it would hide is a value the database accepts and
  /// TypeScript has never heard of. The producer is the typed union
  /// `SurvivingMutant['reason']` in packages/shared/src/types.ts and the worker
  /// is its only writer, so the column's domain is enforced where the value is
  /// made. Promote it to an enum in the same change that adds its PAIRS entry.
  reason  String

  /// Denormalised on purpose: the retention prune needs a time column it can
  /// filter and order on without joining TestResult for every row. Same
  /// reasoning as `Artifact.expiresAt`, which the artifact sweep reads the same
  /// way.
  createdAt DateTime @default(now())

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  /// "Show me this result's surviving mutants" — the read the run page makes.
  @@index([testResultId])
  /// "Which files in this org keep surviving?" — the heat map that turns a
  /// score into a work queue. `orgId` first because the tenant extension makes
  /// it an equality on every read, which is also what lets this index serve the
  /// plain org-scoped scan; a separate @@index([orgId]) would be an identical
  /// prefix and pure write amplification.
  @@index([orgId, file])
  /// The prune's own column, like `Artifact.expiresAt`. Without it the sweep's
  /// "oldest first, past the window" read is a full scan and a sort of every
  /// survivor the install has ever recorded.
  @@index([createdAt])
}

model Artifact {
  id          String    @id @default(cuid())
  orgId       String
  runId       String
  /// S3 object key, or a path under .artifacts when ARTIFACTS_LOCAL=true.
  key         String    @unique
  contentType String
  sizeBytes   Int       @default(0)
  /// Retention is by plan (§5); a sweeper deletes rows and objects past this.
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([runId])
  @@index([expiresAt])
}

/// A public, read-only link to ONE run — the bridge between "QA found a bug" and
/// "the dev fixed it" for a developer who has no QAAI login.
///
/// The row is a CREDENTIAL RECORD, and every column here exists to make that
/// credential accountable rather than merely functional:
///
///   · `tokenHash` and nothing else. The link is 256 bits from `generateToken`
///     and the database stores only `hashToken(raw)` — the same HMAC keyed on
///     SESSION_SECRET that sessions, API keys, invites and runner tokens use.
///     A database dump therefore hands out no working links, and there is
///     deliberately no way to show a link a second time: losing it means
///     minting a new one, which revokes the old.
///   · `revokedAt` is a timestamp, not a delete, so the audit row that says who
///     minted this link keeps pointing at a row that still exists.
///   · `viewCount` / `lastViewedAt` are the whole reason a minter can answer
///     "has anyone actually opened this?", which is the first question asked
///     about a link that was sent and not replied to. They are the only record
///     of a public read: an anonymous GET has no actor, so it cannot produce a
///     meaningful audit row.
///
/// Scope is the run and nothing above it. There is no projectId or suiteId here
/// on purpose — the reader resolves `runId` and stops, so a link can never grow
/// into a view of the project it belongs to.
model RunShare {
  id    String @id @default(cuid())
  orgId String
  runId String

  /// HMAC-SHA256 of the link token, exactly like ApiKey.keyHash and
  /// Runner.tokenHash. Unique so a lookup is a single indexed read on the
  /// digest — the raw token is never stored, compared or logged.
  tokenHash   String @unique
  /// `sh_a1b2c3d4` — enough to name a link in the UI and in an audit row,
  /// and far too little to authenticate with.
  tokenPrefix String

  /// Optional deadline. Null means the link works until it is revoked, which is
  /// a real choice a person can make and therefore has to be visible on the
  /// screen that made it.
  expiresAt DateTime?
  revokedAt DateTime?

  /// Who minted it. Null-able because an org-scoped API key has no user.
  createdBy String?
  createdAt DateTime @default(now())

  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId])
  /// "Is there a live link on this run?" — the read behind the run page's
  /// control, and the one the mint path uses to revoke whatever it replaces.
  @@index([runId, revokedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Triage & healing (§3.3, §3.4)
// ─────────────────────────────────────────────────────────────────────────────

model TriageVerdict {
  id            String             @id @default(cuid())
  orgId         String
  testResultId  String             @unique
  verdict       Verdict
  confidence    Float
  explanation   String
  /// Evidence[] from packages/shared.
  evidence      Json
  suspectCommit Json?
  model         String
  /// A human can disagree; the override is what gates and what trains prompts.
  reviewState   VerdictReviewState @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  overriddenTo  Verdict?
  /// Set when this verdict was filed as a bug (§7). Every member of a CAUSE
  /// carries the SAME url: forty tests downstream of one broken dependency are
  /// one ticket, and each of the forty verdicts links to it.
  issueUrl      String?
  /// The cause this verdict was filed under — `TrackerIssue.causeKey`. The
  /// idempotence key: a second file for the same cause finds the row through
  /// this and links, instead of minting a second ticket.
  issueCauseKey String?

  /// ─── Who owns this failure (§8) ────────────────────────────────────────
  ///
  /// Resolved from OwnershipRule at triage time. Exactly one of the two ids,
  /// or neither — and when it is neither, `ownerState` says WHY, because an
  /// unowned failure that looks owned is worse than one that is visibly
  /// unowned. States are OWNED / NO_RULES / NO_MATCH / RULES_UNUSABLE
  /// (OWNERSHIP_STATES in src/lib/ownership.ts); null means nothing has tried
  /// to route this verdict yet, which is a third thing again.
  assigneeUserId String?
  assigneeTeamId String?
  /// The rule that won, so "why does the payments team own this?" has an answer.
  ownerRuleId    String?
  ownerState     String?
  /// The reason sentence, shown verbatim. Carries the unusable-rule warning
  /// when routing may have stopped silently.
  ownerNote      String?
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())

  /// ─── A verdict is about a CAUSE, not about a result (§3.3) ──────────────
  ///
  /// THE DEFECT: triage ran once per RESULT. One dead dependency that takes
  /// out 200 tests spent 200 model calls and produced 200 independently-worded
  /// verdicts for ONE cause — and a reviewer then read the same sentence 200
  /// times in 200 slightly different wordings, which is worse than reading it
  /// once, because 200 agreeing verdicts look like 200 pieces of evidence. The
  /// clusterer that already knew they were one cause
  /// (apps/api/src/lib/cluster.ts) was read-only and ran in the cockpit, after
  /// the money had been spent.
  ///
  /// `clusterKey` is sha1(signature)[0,12) — BYTE-IDENTICAL to the id the
  /// cockpit already shows on a failure cluster, so the link in the UI and the
  /// key in this row are the same string. There is one implementation of that
  /// hash (`failureClusterKey`, packages/agent/src/triage.ts) and
  /// apps/api/src/routes/clusters.test.ts asserts it against the clusterer's
  /// own ids, so the two cannot drift apart silently.
  ///
  /// `runId` is DENORMALISED off testResult.run on purpose. "Does this run
  /// already have a verdict for this cause?" is the question every one of those
  /// 200 jobs asks, and through the relation it is a join no index serves.
  /// Here, @@index([runId, clusterKey]) answers it outright — and a result
  /// never moves between runs, so the copy cannot go stale.
  ///
  /// `derivedFromId` is the HONESTY column. A verdict copied onto a member from
  /// the cluster's single model call is not an independent judgement of that
  /// member, and a reader who cannot tell a copy from a first-hand call will
  /// over-trust the agreement. NULL means a model looked at this result itself.
  clusterKey    String?
  runId         String?
  derivedFromId String?

  /// ─── Re-triage: supersede, never overwrite ──────────────────────────────
  ///
  /// THE DEFECT: packages/agent/src/heal-apply.ts tells the reader to "Re-run
  /// triage to get a fresh proposal" and no mechanism existed — enqueueTriage
  /// dedupes on `triage-<testResultId>` forever, and processTriage returns the
  /// moment a verdict row exists.
  ///
  /// A REQUEST COLUMN rather than a job field, deliberately: TriageJob is
  /// shared with the run processor (packages/shared/src/jobs.ts), and a flag
  /// living only in a queue payload is lost when the worker is cycled. A
  /// re-triage asked for at 02:00 still happens if the worker restarts at 02:01.
  ///
  /// The verdict's current contents are COPIED INTO TriageVerdictRevision
  /// before they are replaced, and that is the whole point: `reviewState` and
  /// `overriddenTo` are the only record of the model having been wrong, and
  /// they are what trains the prompt (`summariseCorrections`,
  /// packages/agent/src/triage.ts). A re-triage that overwrote them in place
  /// would delete the training signal in order to produce a fresh guess.
  retriageRequestedAt DateTime?
  retriageRequestedBy String?
  retriageReason      String?
  /// 1 until something supersedes this verdict. The revision rows hold every
  /// number below the current one.
  revision            Int       @default(1)
  /// Set when a reviewer deliberately took this result OUT of its cluster
  /// because the cluster's one answer was wrong for this member specifically —
  /// the same stack from two tests really can be a real bug in one and a stale
  /// selector in the other. A split verdict is never overwritten by a later
  /// cluster attach; see apps/worker/src/processors/triage.ts.
  splitFromClusterKey String?

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  batchItems TriageBatchItem[]
  revisions  TriageVerdictRevision[]

  @@index([orgId, verdict])
  @@index([orgId, reviewState])
  /// "Has this run already answered this cause?" — asked once per failing
  /// result, which on a 200-test outage is 200 times.
  @@index([runId, clusterKey])
  /// "Every verdict ever reached about this cause", for the cause page and for
  /// the accuracy scorecard's per-cause breakdown.
  @@index([orgId, clusterKey])
}

/// One ticket on the customer's board, keyed by the CAUSE it was filed for (§7).
///
/// WHY THIS TABLE EXISTS
///
/// The only place a filed issue was recorded was `TriageVerdict.issueUrl`, one
/// column on one result. That shape can only express "this result has a
/// ticket", so POST /issues filed one per failing result: a shared dependency
/// dying meant forty tests failing, forty presses of a one-click button and
/// forty tickets for one bug. There was also nowhere at all to record an issue
/// filed for something that is not a result — an untested surface has no
/// TestResult row, so a coverage gap could not be filed.
///
/// `causeKey` is the idempotence key and the reason the table is worth having:
/// sha256 of the project plus the cause's identity (a cluster signature for a
/// failure, the project/feature/owner triple for a coverage gap). Unique per
/// org, so a second file for the same cause FINDS this row and links to the
/// ticket already on the board. A customer whose board filled up with forty
/// tickets will not forgive a second occurrence.
///
/// NO FOREIGN KEY TO Integration OR Project, deliberately. The url points at a
/// ticket on someone else's system, which exists whether or not the
/// integration that filed it is still connected; cascading this row away when
/// an admin disconnects a tracker would delete the only record that the bug was
/// already reported and the next run would file it again.
model TrackerIssue {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// FAILURE | COVERAGE_GAP. A string, not an enum: apps/api/scripts/check-enums.ts
  /// enforces schema/TypeScript parity from a hand-maintained list, so a new
  /// enum with no entry in it is an enum with no drift guard. The domain is
  /// enforced at the producer (ISSUE_SUBJECTS in src/lib/ownership.ts).
  subject  String
  /// sha256(subject | projectId | cause identity), hex. See the header.
  causeKey String
  /// The cause in readable form: the cluster signature, or the gap filter.
  cause    String

  provider      IntegrationKind
  /// Which integration filed it. Not a relation — see the header.
  integrationId String?
  url           String
  /// The provider's own identifier: `owner/repo#12`, `QA-12`, `ENG-12`.
  key           String?
  title         String

  /// Who the ticket was filed for, resolved from OwnershipRule. `ownerState`
  /// also admits SPLIT, which only an issue can be: one cause whose members
  /// are owned by different people has no single true assignee, and claiming
  /// one would route the whole ticket to someone who owns a third of it.
  ownerUserId String?
  ownerTeamId String?
  ownerState  String

  /// What the ticket covered when it was last filed or re-filed: the count, and
  /// the names themselves (test result ids, or surface keys). The names are the
  /// whole argument of a coverage ticket — "coverage is 61%" is not actionable.
  affectedCount Int  @default(0)
  subjectKeys   Json @default("[]")

  filedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, causeKey])
  @@index([projectId, subject])
}

model HealProposal {
  id          String    @id @default(cuid())
  orgId       String
  testId      String
  /// The verdict that triggered this heal.
  verdictId   String?
  /// Unified diff against the test's current code — EXCEPT on a RETIRE
  /// proposal, which is empty: retirement is not a patch, and a diff that
  /// deleted the test would be refused by `applyHealDiff` anyway ("a heal may
  /// fix a test, not delete one"). Readers must branch on `riskLevel` before
  /// trying to apply this.
  diff        String
  explanation String
  riskLevel   HealRisk
  confidence  Float
  state       HealState @default(PROPOSED)
  decidedBy   String?
  decidedAt   DateTime?
  /// PR opened when the repo is connected.
  prUrl       String?
  createdAt   DateTime  @default(now())

  /// The proposal that replaced this one, when `state` is SUPERSEDED. Kept as a
  /// plain id and not a self-relation: it is read to render "replaced by" and
  /// never joined through, and a self-relation on this table would make every
  /// delete path think about a cycle that does not exist.
  supersededById String?

  // ─── Verification (§3.4) ───────────────────────────────────────────────────
  //
  // A heal recorded APPLIED while the test is still red is worse than no heal:
  // it tells a human the problem is handled. Both apply paths therefore start a
  // single-test run against the heal and record its outcome here, and the sweep
  // in apps/worker/src/processors/flake.ts reads it back.
  //
  // Every column is nullable with NO DEFAULT, which is the honest encoding: a
  // proposal nobody applied has nothing to verify, and NULL says "no claim" in
  // a way `false` or `'PENDING'` could not.

  /// TestVersion.version this heal wrote. The revert path's only way back —
  /// without it, an auto-applied heal that fails verification cannot be undone
  /// except by guessing which version came before it.
  appliedVersion Int?
  /// The single-test Run started to check the applied heal.
  verifyRunId    String?
  /// One of HEAL_VERIFY_STATES in packages/agent/src/healer.ts: PENDING,
  /// VERIFIED, STILL_FAILING, UNVERIFIABLE.
  ///
  /// TEXT and not a Prisma enum, for the reason spelled out in
  /// 20261024010000_mutation_metric_and_survivors: apps/api/scripts/check-enums.ts
  /// enforces schema/TypeScript enum parity from a hand-maintained list, so a
  /// new enum with no entry in that list is an enum with no drift guard. The
  /// domain is enforced at the producer instead — healer.ts is the only writer.
  /// Promote it in the same change that adds its parity entry.
  verifyState    String?
  verifiedAt     DateTime?
  /// What the verification found, in a sentence a human can act on. Carries the
  /// reason a verification could not run at all, which is the case that must
  /// never read as a pass.
  verifyNote     String?

  /// Machine-readable evidence for a proposal no model wrote: the deflake
  /// findings, or the routes and locators behind a retirement. Json because the
  /// shape differs per `riskLevel` and nothing queries inside it — the prose a
  /// reviewer reads is in `explanation`.
  evidence Json?

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([orgId, state])
  @@index([testId])
  /// The verification sweep's own query: "which applied heals are still waiting
  /// on a verdict?", asked once per tick across every org. Without it that is a
  /// scan of every heal the install has ever proposed.
  @@index([verifyState])
}

/// What a verdict USED to say — kept because a re-triage must not erase the
/// correction a human already made.
///
/// TriageVerdict.testResultId is `@unique`, so there is exactly one live
/// verdict per result and a fresh one has nowhere to go but on top of the old
/// one. Overwriting in place would destroy `reviewState` / `overriddenTo`,
/// which are the only evidence the model was ever overruled — and overrides
/// are what the triage prompt now reads back as a prior
/// (`summariseCorrections`, packages/agent/src/triage.ts). A re-triage that
/// silently replaced them would erase the thing that makes re-triage worth
/// doing.
///
/// Append-only. Nothing updates or deletes a revision row, and the
/// `(verdictId, revision)` unique key is what makes a redelivered supersede
/// idempotent instead of doubling the history.
model TriageVerdictRevision {
  id        String @id @default(cuid())
  orgId     String
  verdictId String
  /// The revision number these contents HELD, so revision 1 is the original.
  revision  Int

  verdict     Verdict
  confidence  Float
  explanation String
  /// Evidence[] from packages/shared, exactly as the superseded verdict held it.
  evidence    Json
  model       String

  /// The human half, which is the half worth keeping.
  reviewState  VerdictReviewState
  overriddenTo Verdict?
  reviewedBy   String?
  reviewedAt   DateTime?

  supersededAt DateTime @default(now())
  /// Who asked for the re-triage, and why they said the old answer was wrong.
  supersededBy String?
  reason       String?

  parent TriageVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@unique([verdictId, revision])
  @@index([orgId, verdictId])
  /// The accuracy scorecard counts superseded corrections too: a model answer a
  /// human fixed is evidence whether or not a later re-triage replaced it.
  /// Without this the scorecard reads the live rows only and quietly
  /// under-counts every project that uses re-triage.
  @@index([orgId, reviewState])
}

/// A failure CAUSE, with an identity that outlives the run it appeared in.
///
/// THE DEFECT: `signatureOf()` (apps/api/src/lib/cluster.ts) produced a stable
/// key for a cause and the key was stored nowhere. So the two questions a
/// reviewer actually has on a red build —
///
///   · "is this the same thing as yesterday?"
///   · "which of these is NEW in this build?"
///
/// — had no answer at all. The second is the single most useful sentence you
/// can put in front of a reviewer: a cause that has been failing for three
/// weeks is somebody's known problem, and a cause that appeared ninety seconds
/// ago belongs to whoever just merged.
///
/// ── Why the mute lives HERE and not on the test ───────────────────────────
///
/// `VerdictReviewState.MUTED` was written by two endpoints and read by nothing,
/// so the next run of a known issue minted a fresh verdict and paged somebody
/// again. Making the mute durable means keying it on the SIGNATURE, not the
/// test: quarantine keys suppression on a test and therefore swallows every
/// FUTURE failure of that test including ones nobody has seen, which is why
/// `Test.quarantineExpiresAt` had to exist. A mute keyed on the signature stops
/// only the cause that was actually inspected — if the cause changes, the
/// signature changes, and the new cause is loud again with no human action.
/// That property is the reason this model exists rather than a `mutedAt`
/// column on TriageVerdict.
///
/// `mutedUntil` is never "forever". A mute with no end date is the quarantine
/// mistake again, so the writer clamps it to MUTE_MAX_DAYS
/// (packages/agent/src/triage.ts); null here means not muted at all.
///
/// The counters exist because a suppressed failure must stay COUNTABLE. "It
/// went quiet" and "it stopped happening" are different facts, and a muted
/// cause that recorded nothing would make them indistinguishable — which is
/// how a mute turns into a blind spot.
model FailureSignature {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// sha1(signature)[0,12) — the same string the cockpit shows as a cluster id.
  clusterKey String
  /// The full signature verbatim, so a reviewer can audit the grouping that
  /// produced this identity, plus `labelFor()`'s sentence denormalised: the
  /// label is derived from the signature, but recomputing it needs the
  /// clusterer and the cause page must be readable from this row alone.
  signature  String
  label      String

  /// ── The identity ───────────────────────────────────────────────────────
  ///
  /// `firstSeenRunId` is what turns "new in this build" into an EQUALITY
  /// instead of a search: a cause is new in run R exactly when
  /// firstSeenRunId = R. No window, no "have we seen it in the last N runs"
  /// scan over TestResult, and the answer does not change as history grows.
  firstSeenAt     DateTime @default(now())
  firstSeenRunId  String
  lastSeenAt      DateTime
  lastSeenRunId   String
  /// Distinct RUNS it appeared in, and failing results across all of them.
  /// RunFailureCluster holds the authoritative list of runs; these two are the
  /// summary the cause page reads without touching it.
  runCount        Int      @default(0)
  occurrenceCount Int      @default(0)

  /// ── Suppression ────────────────────────────────────────────────────────
  mutedUntil      DateTime?
  mutedAt         DateTime?
  mutedBy         String?
  /// Required by the endpoint that sets it. A mute with no stated reason is an
  /// unexplained silence somebody else will inherit.
  mutedReason     String?
  /// Failing results seen while a mute was IN FORCE. Separate from
  /// occurrenceCount so "muted and gone" and "muted and still firing forty
  /// times a day" stay distinguishable — that is the fact that decides whether
  /// a mute should be renewed.
  suppressedCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occurrences RunFailureCluster[]

  @@unique([orgId, projectId, clusterKey])
  /// "Everything new in this build", straight off the index, for a caller that
  /// has the run id and not the cluster keys.
  @@index([orgId, projectId, firstSeenRunId])
  /// The cause list: most recently seen first.
  @@index([orgId, projectId, lastSeenAt])
  /// The mute roster — and the one read that wants EXPIRED mutes too, which is
  /// why it indexes `mutedUntil` rather than a partial "still muted".
  @@index([orgId, mutedUntil])
}

/// ONE verdict per cause per run — and the row that makes it one.
///
/// THE DEFECT this closes is the 200-model-call outage, and the fix needs a
/// CLAIM rather than a check: the triage queue runs at `concurrency * 2`
/// (apps/worker/src/index.ts), so two jobs for two members of one cluster
/// genuinely do look for an existing verdict at the same moment, both find
/// none, and both call the model. `@@unique([runId, clusterKey])` IS the lock —
/// the INSERT is the claim, exactly like SsoAssertionSeen — and the loser waits
/// for the winner's verdict instead of paying for a second one.
///
/// It is also the per-run OCCURRENCE record, which is why there is no separate
/// join table: "the runs this cause appeared in" is this table filtered by
/// clusterKey, and the row has to exist anyway for the claim.
///
/// `firstSeenInProject` is written from the SAME signature row the claim path
/// just minted or read (`claimCause`, apps/worker/src/processors/triage.ts), so
/// it cannot disagree with `firstSeenRunId` — not a shared transaction, which
/// a path that catches a unique violation cannot use on PostgreSQL. It exists
/// so the run page answers "what is new in this build?" from one index read on
/// (orgId, runId), with no second query and no join. It is also the value AS OF
/// this run, which is the correct thing for an old run's page to show after the
/// cause has recurred.
///
/// `modelCalls` and `attachments` are the accounting, stored rather than
/// inferred: "we collapsed 200 failures into one call" is a claim about money,
/// and a claim about money should be a number somebody can read back.
/// `modelCalls` is normally 1 and is 2+ only when a waiter timed out and
/// triaged itself — which has to be VISIBLE, not rounded down to the number we
/// were hoping for.
model RunFailureCluster {
  id        String @id @default(cuid())
  orgId     String
  runId     String
  projectId String

  clusterKey String
  signature  String
  label      String

  /// The result whose triage job won the claim and paid for the model call.
  ownerResultId String
  /// The verdict that call produced. Null while the owner is still in flight,
  /// which is exactly the state a waiter polls on.
  verdictId     String?

  /// Failing results in this run carrying this signature.
  members            Int     @default(0)
  /// Model calls actually spent on this cause in this run.
  modelCalls         Int     @default(0)
  /// Members that took the owner's verdict instead of making their own call.
  attachments        Int     @default(0)
  /// True when a mute was in force for this cause while this run executed, so
  /// the run page shows a suppressed cause as suppressed rather than as absent.
  suppressed         Boolean @default(false)
  /// Set in the transaction that minted the signature. See above.
  firstSeenInProject Boolean @default(false)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  /// Nullable, and the relation is a convenience rather than the identity: the
  /// durable join between a run and a cause is `clusterKey`, which survives a
  /// signature row being pruned. Cascade so a deleted project's causes take
  /// their occurrences with them.
  signatureId  String?
  signatureRow FailureSignature? @relation(fields: [signatureId], references: [id], onDelete: Cascade)

  @@unique([runId, clusterKey])
  /// The run page: every cause in this run, one index read.
  @@index([orgId, runId])
  /// The cause page: "which runs did this appear in", newest first.
  @@index([orgId, clusterKey, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Visual regression (§4)
// ─────────────────────────────────────────────────────────────────────────────

/// One approved reference image.
///
/// ── THE DEFECT THIS MODEL CARRIED UNTIL `environmentId` EXISTED ─────────────
///
/// The unique key was (test, viewport, browser), so STAGING AND PRODUCTION
/// SHARED A BASELINE. Whichever environment ran first captured the reference,
/// and every later diff on the other one was measured against it — so a staging
/// capture silently becomes the production reference, and the red it produces is
/// permanently false: nobody can fix it by changing the application, because the
/// application is not what differs. A visual suite that cannot be made green is
/// a visual suite that gets switched off.
///
/// ── WHY THE COLUMN IS TEXT AND NOT A RELATION ───────────────────────────────
///
/// Because an environment is deletable and the record of what was measured
/// where must outlive it — the same argument `TestResultVariant.environment` and
/// `CoverageItem.environmentId` already record. It also lets the migration
/// attribute pre-existing rows to `<unattributed>`
/// (`UNATTRIBUTED_ENVIRONMENT` in @qaai/shared) rather than guessing an
/// environment for them: attributing a possibly-staging baseline to production
/// would be inventing the exact fact this column exists to record. A reader must
/// treat an unattributed baseline as "no reference for any environment,
/// re-capture required" — the safe failure (one re-approval per test on deploy)
/// rather than the false-red one.
model VisualBaseline {
  id            String   @id @default(cuid())
  orgId         String
  projectId     String
  testId        String
  /// One baseline per (test, viewport, browser, environment). The fourth member
  /// is the whole point — see the note above.
  viewport      String
  browser       String
  /// The environment this image was captured against, or `<unattributed>` for a
  /// row that predates the column. NO DEFAULT: a new baseline must name the
  /// environment it was captured in, because a defaulted sentinel is how the
  /// shared-reference defect comes back one writer at a time.
  environmentId String
  imageKey      String
  /// Rectangles to exclude from the diff, from the ignore-region editor.
  ignoreRegions Json     @default("[]")
  approvedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  /// FOUR MEMBERS AND NOT SIX, DELIBERATELY, NOW THAT A VISUAL TEST HAS A MATRIX.
  ///
  /// This round lets one VISUAL test declare viewports, colour schemes, reduced
  /// motion and the interaction STATES to reach first, and the obvious reading is
  /// that this key needs two more columns — otherwise a light and a dark capture
  /// of one test upsert onto ONE row, whichever ran last becomes the other's
  /// reference, and every later diff is measured against the wrong rendering.
  /// That is the shared-baseline defect `environmentId` was added to kill,
  /// multiplied by the number of cells.
  ///
  /// It does not, because `viewport` and `browser` ARE the cell. Every writer
  /// goes through `baselineViewportKey(cell, state)` and `variantBrowserKey(cell)`
  /// in packages/shared/src/browser-matrix.ts, which pack the device, the colour
  /// scheme, the motion preference, the forced-colors mode and the state into the
  /// first and the engine, channel and version pin into the second — so
  /// `1280x800+dark` and `1280x800+light` are already different rows under this
  /// key, with no column and no index change.
  ///
  /// Two properties make that the better trade rather than a dodge. An unvaried
  /// DEFAULT-state cell produces `1280x800` byte for byte, which is exactly what
  /// the pre-matrix writer wrote — so no existing baseline stops matching and
  /// nobody is forced into a re-approval sweep by a migration. And a six-column
  /// unique here would have derived the name
  /// "VisualBaseline_testId_viewport_browser_environmentId_cellKey_state_key" at
  /// 69 bytes, which PostgreSQL TRUNCATES AT 63 SILENTLY — permanent phantom
  /// drift on every `migrate dev`, which an earlier round already paid for once.
  @@unique([testId, viewport, browser, environmentId])
  @@index([orgId])
  /// "every baseline for this environment" — the read a per-environment
  /// re-approval sweep makes, and the one that was impossible before.
  @@index([projectId, environmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduling & monitoring (§6)
// ─────────────────────────────────────────────────────────────────────────────

model Schedule {
  id            String    @id @default(cuid())
  orgId         String
  projectId     String
  suiteId       String
  environmentId String
  name          String
  cron          String
  timezone      String    @default("UTC")
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([enabled, nextRunAt])
}

/// Synthetic monitoring (§6) — a smoke suite against prod every N minutes.
model Monitor {
  id                  String     @id @default(cuid())
  orgId               String
  projectId           String
  suiteId             String
  environmentId       String
  name                String
  intervalMinutes     Int        @default(15)
  enabled             Boolean    @default(true)
  /// Consecutive failures before alerting, to avoid paging on one blip.
  failureThreshold    Int        @default(2)
  consecutiveFailures Int        @default(0)
  lastStatus          RunStatus?
  lastCheckedAt       DateTime?
  /// Integration ids to notify.
  notifyVia           String[]   @default([])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite       Suite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([enabled])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations (§7)
// ─────────────────────────────────────────────────────────────────────────────

model Integration {
  id        String          @id @default(cuid())
  orgId     String
  projectId String?
  kind      IntegrationKind
  name      String
  /// Non-secret settings (channel, project key, repo). Tokens go in configEnc.
  config    Json            @default("{}")
  configEnc String?
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([orgId, kind])
}

/// Lifecycle of one outbound notification (§7). Mirrored as a union type in
/// packages/shared/src/types.ts — `check:enums` diffs them. PENDING while
/// retries remain, SENT on the 2xx that landed, FAILED once the last attempt is
/// spent. There is no separate dead-letter store: a FAILED row, holding its
/// final error, IS the dead letter.
enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  orgId          String
  integrationId  String
  event          String
  payload        Json
  /// HMAC-SHA256 signature sent with the request (§7 "signed").
  signature      String
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  attempts       Int                   @default(0)
  deliveredAt    DateTime?
  lastError      String?
  createdAt      DateTime              @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([integrationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat copilot (§3.5)
// ─────────────────────────────────────────────────────────────────────────────

model ChatConversation {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  title     String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([orgId, projectId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  orgId          String
  conversationId String
  role           String // "user" | "assistant" | "tool"
  content        String
  /// Tool calls the copilot made, so the UI can show its work (§3 "never a black box").
  toolCalls      Json?
  userId         String?
  /// Set while the assistant turn is still being produced.
  pending        Boolean  @default(false)
  /// Populated when a turn fails, so the UI can say why instead of hanging.
  error          String?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  proposals    AgentProposal[]

  @@index([orgId])
  @@index([conversationId, createdAt])
}

enum ProposalState {
  PENDING
  APPLIED
  REJECTED
}

enum ImportState {
  DETECTED
  CONVERTING
  DONE
  ERRORED
}

/// A suite migration (§7): upload existing tests → convert to Playwright.
///
/// The uploaded files and the conversion result live on the row so the whole
/// batch is one auditable, resumable unit. Detection runs synchronously in the
/// request; conversion is the worker's job because it calls the model.
model ImportBatch {
  id                  String      @id @default(cuid())
  orgId               String
  projectId           String
  /// Detected source framework (a SourceFramework from packages/agent).
  framework           String
  detectionConfidence Float       @default(0)
  /// SourceFile[] — [{ path, content }]. The suite as uploaded.
  files               Json
  state               ImportState @default(DETECTED)
  /// Free-text conversion summary once the worker finishes.
  summary             String?
  /// How many tests were produced, for the coverage report.
  convertedCount      Int         @default(0)
  error               String?
  requestedBy         String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([orgId, projectId])
}

/// What QAAI learned from an application's SOURCE (§7).
///
/// The sibling of ImportBatch, and deliberately not the same table. An
/// ImportBatch's subject is an existing TEST SUITE and its verb is "convert";
/// this row's subject is the APPLICATION and its verb is "understand". Nothing
/// here is converted into anything — it is read, and what was read becomes the
/// material a plan is written from when no crawlable environment exists yet.
///
/// THE FILE BODIES ARE NOT STORED, and that is a decision rather than an
/// omission. ImportBatch keeps its uploads because the worker has to read them
/// again to convert them; nothing re-reads an application's source, so keeping
/// a copy of a customer's entire codebase in our database would be a liability
/// with no consumer — the kind of data you can only lose. Paths are kept
/// because they are small, they are what the file-convention detectors ran on,
/// and they let a user see exactly which files we looked at. Re-ingesting is one
/// request away.
model CodebaseSnapshot {
  id          String   @id @default(cuid())
  orgId       String
  projectId   String
  /// string[] — the repo-relative paths that were analysed. No file contents.
  paths       Json
  /// How many files the upload carried, before ignores and caps.
  fileCount   Int      @default(0)
  /// How many arrived with a body. The rest contributed only their path, which
  /// bounds what the analysis below could possibly have seen.
  withContent Int      @default(0)
  /// Bytes of source received, for the audit trail and the rate story.
  totalBytes  Int      @default(0)
  /// ProjectDetection — packages/shared/src/detect.ts. Runners, languages,
  /// package managers: how you would RUN this repo's tests.
  detection   Json
  /// CodebaseAnalysis — packages/shared/src/codebase.ts. Routes, endpoints,
  /// forms, auth surfaces: what the application EXPOSES.
  analysis    Json
  requestedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, projectId])
}

/// A file change the copilot wants to make, held for human approval (§3).
///
/// The copilot never writes a test directly. It proposes, the person reads the
/// diff, and only an explicit accept mutates anything — the same contract the
/// Healer works under, for the same reason: an agent that silently edits your
/// test suite is one that can silently stop testing something.
model AgentProposal {
  id             String        @id @default(cuid())
  orgId          String
  projectId      String
  conversationId String
  messageId      String?
  /// Null when the proposal creates a new test rather than editing one.
  testId         String?
  filePath       String
  /// Empty for a new file. Kept so the diff survives later edits to the test.
  oldCode        String
  newCode        String
  /// Why the copilot wants this change, in its own words.
  rationale      String
  testName       String
  testType       TestType      @default(E2E)
  state          ProposalState @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())

  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([orgId, state])
  @@index([conversationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing & metering (§9)
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  orgId                String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 Plan      @default(FREE)
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Stripe's `event.created` for the last subscription state applied here.
  /// Stripe does not promise delivery order, so the webhook refuses to write a
  /// subscription event older than this — a redelivered `updated` from before a
  /// cancellation must not resurrect the plan. Null on rows that predate the
  /// column; the first event to arrive claims it.
  planSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Stripe webhook events already processed. Stripe redelivers on timeouts, on
/// any non-2xx, and occasionally even after a 2xx, and this endpoint moves orgs
/// between paid plans — so every event id is checked here before handling and
/// recorded after. Global on purpose (no orgId): the event arrives before we
/// know which org it is for. Same shape as SsoAssertionSeen, the other
/// replay-guard table.
model StripeEventSeen {
  /// The Stripe event id (`evt_…`) — stable across every redelivery.
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Metered regardless of plan (§9), so pricing can change without a data migration.
model UsageRecord {
  id        String   @id @default(cuid())
  orgId     String
  /// "runs" | "agent_tokens" | "storage_bytes" | "worker_minutes"
  metric    String
  /// First day of the billing month, UTC. One row per (org, metric, period).
  period    DateTime
  quantity  BigInt   @default(0)
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, metric, period])
  @@index([orgId])
}

/// One row per LLM call (§0 token accounting). Rolled up nightly into UsageRecord.
model AgentCall {
  id               String    @id @default(cuid())
  orgId            String
  projectId        String?
  agent            AgentKind
  model            String
  subjectId        String?
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  costCents        Float     @default(0)
  durationMs       Int       @default(0)
  /// Set when the call failed after retries; kept so cost of failure is visible.
  error            String?
  createdAt        DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, agent])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ops (§11)
// ─────────────────────────────────────────────────────────────────────────────

/// QAAI'S OWN FEATURE FLAGS. NOT THE CUSTOMER'S.
///
/// Four rows written by prisma/seed.ts and read by nothing — one of the four
/// gaps `scripts/check-wiring.ts` records, kept as a recorded gap rather than
/// silently wired, because all four seeded rows are `enabled: false` and
/// switching them on as-is would turn four working features off.
///
/// The flags of the APPLICATION UNDER TEST are a different thing entirely and
/// live nowhere near this table: they are `SurfaceDimension` rows with
/// `kind: 'FLAG'`, read out of the customer's LaunchDarkly project, their
/// Unleash instance or their `NEXT_PUBLIC_FEATURE_*` env gates, with the
/// provider recorded from `FLAG_PROVIDERS` in
/// packages/shared/src/api-surface.ts.
///
/// Reusing this table for them would make a row ambiguous: the same primary key
/// would mean both "QAAI's visual-regression feature is off" and "the
/// customer's checkout-v2 flag exists", and no reader could tell which. The
/// same note is at the other site.
model FeatureFlag {
  key         String   @id
  description String
  /// Default for orgs with no override row.
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  overrides FeatureFlagOverride[]
}

model FeatureFlagOverride {
  id        String   @id @default(cuid())
  orgId     String
  flagKey   String
  enabled   Boolean
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  flag FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([orgId, flagKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// SSO (§1, gated on PLAN_LIMITS.sso — see src/lib/plan.ts)
//
// These four tables are org-owned and therefore scoped by the Prisma tenancy
// extension like everything else. Note that the login path itself is
// ANONYMOUS — there is no tenant in scope when a browser hits /sso/start — so
// every read on the way in is an explicit `unscoped()` in routes/sso.ts, with
// the orgId supplied from the row rather than from the caller.
// ─────────────────────────────────────────────────────────────────────────────

/// An org's identity provider.
model SsoConnection {
  id          String      @id @default(cuid())
  orgId       String
  protocol    SsoProtocol
  name        String
  enabled     Boolean     @default(true)
  /// Role a JIT-provisioned member is created with. Clamped below OWNER in
  /// src/lib/sso.ts: an IdP assertion must never be able to mint someone who
  /// can change billing or delete the org.
  defaultRole OrgRole     @default(MEMBER)

  // ── OIDC ───────────────────────────────────────────────────────────────────
  /// The exact `iss` value we require in every ID token. It is also the ONLY
  /// source of the discovery host — see ISSUER_ALLOWED_HOSTS in lib/sso.ts.
  oidcIssuer          String?
  oidcClientId        String?
  /// Sealed by lib/vault.ts under the name `sso:<connectionId>:client_secret`.
  /// Never returned by the API and never logged.
  oidcClientSecretEnc String?
  oidcKeyVersion      Int?
  /// Extra scopes appended to the mandatory `openid email profile`.
  oidcScopes          String[] @default([])

  // ── SAML ───────────────────────────────────────────────────────────────────
  samlIdpEntityId String?
  samlSsoUrl      String?
  /// IdP signing certificates, PEM. A list because rotation means publishing
  /// the old and the new one at the same time.
  samlIdpCertsPem String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domains    SsoDomain[]
  requests   SsoLoginRequest[]
  assertions SsoAssertionSeen[]

  @@index([orgId])
}

/// An email domain routed to one connection.
///
/// `domain` is UNIQUE ACROSS THE WHOLE TABLE, not per org, and that is the
/// single most important constraint in this feature. Users are global (one row
/// per email) and a session can switch between every org the user belongs to,
/// so an org that could claim a domain it does not own could assert any address
/// in it, be handed that user's session, and switch straight into the victim's
/// org. DNS ownership is therefore proved before `verifiedAt` is set, and
/// nothing on the login path looks at an unverified row.
model SsoDomain {
  id                String    @id @default(cuid())
  orgId             String
  connectionId      String
  /// Lowercase, trailing dot stripped, no leading `@`.
  domain            String    @unique
  /// Published by the customer as a TXT record at `_qaai-verify.<domain>`.
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([connectionId])
}

/// One in-flight login. Single-use: `consumedAt` is set by a conditional
/// update, so a replayed callback loses the race instead of minting a session.
model SsoLoginRequest {
  id              String    @id @default(cuid())
  orgId           String
  connectionId    String
  /// SHA-256 of the opaque `state`. The raw value exists only in the URL.
  stateHash       String    @unique
  /// SHA-256 of the OIDC nonce, compared against the ID token's claim.
  nonceHash       String?
  /// PKCE verifier, sealed under `sso:<requestId>:pkce`. Sealed rather than
  /// stored raw so a database read alone cannot complete a stolen code.
  pkceVerifierEnc String?
  keyVersion      Int?
  /// SAML AuthnRequest ID, matched against the assertion's InResponseTo.
  samlRequestId   String?
  /// Where to land afterwards. Validated as a same-origin relative path before
  /// it is stored, so the callback cannot be turned into an open redirect.
  redirectTo      String?
  ip              String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([expiresAt])
}

/// SAML replay guard: an assertion ID may be consumed exactly once.
///
/// The unique index is the enforcement — a duplicate insert throws, which is
/// what makes this safe under concurrency. Rows are disposable once `expiresAt`
/// has passed, because an expired assertion is rejected on its NotOnOrAfter
/// anyway.
model SsoAssertionSeen {
  id           String   @id @default(cuid())
  orgId        String
  connectionId String
  assertionId  String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, assertionId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// On-prem runners (ENTERPRISE)
//
// The whole design decision, stated once: the agent POLLS OUT. An enterprise
// will not open an inbound port for us, and any protocol that needs one is dead
// on arrival, so nothing in this section is reachable from our side — we never
// dial a runner, we only answer one. Everything below is the durable state that
// makes that safe: who is allowed to ask, what they can run, and who currently
// holds a piece of work.
//
// The lease/heartbeat/reap machinery mirrors RunShard on purpose. A second
// liveness protocol is a second set of liveness bugs, and this one is harder
// than the shard case: the process holding the lease is inside a network we
// cannot see into, so a missing heartbeat is the ONLY signal we will ever get.
// ─────────────────────────────────────────────────────────────────────────────

/// One agent a customer runs inside their own network.
model Runner {
  id    String @id @default(cuid())
  orgId String
  name  String

  /// SHA-256 of the runner token, exactly like ApiKey.keyHash.
  ///
  /// Hashed rather than vault-sealed, and the distinction is the point: this
  /// credential is only ever VERIFIED, never replayed outbound, so there is no
  /// reason for the plaintext to be recoverable. Sealing it would mean a
  /// database read plus the master key hands out live runner tokens; a hash
  /// means it hands out nothing. Vault sealing is for secrets we have to send
  /// somewhere (see Integration.configEnc) — this is not one.
  tokenHash   String @unique
  /// `qaai_rt_a1b2c3d4` — enough to identify a token in the UI and in an audit
  /// row without storing anything that can authenticate.
  tokenPrefix String

  /// RunnerCapabilities as reported by the agent and re-validated on arrival;
  /// see parseCapabilities() in apps/api/src/lib/runners.ts. Agent-supplied and
  /// therefore never trusted for anything but matching — it can only ever cause
  /// LESS work to be sent to this runner, never more privilege.
  capabilities Json     @default("{}")
  /// Pool names this runner serves, matched against Run.runnerPool. Empty means
  /// the default pool only.
  pools        String[] @default([])

  agentVersion String?
  /// "linux-x64", "darwin-arm64" — reported, for support, never for routing.
  platform     String?

  /// Stamped on every authenticated call. Liveness is derived from this rather
  /// than stored: a status column would need something to write OFFLINE, and
  /// the thing that would write it is the process that just died.
  lastSeenAt  DateTime?
  lastClaimAt DateTime?

  tokenRotatedAt DateTime?
  /// Revocation is a timestamp, not a delete, so the audit trail keeps pointing
  /// at a row that still exists.
  revokedAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs RunnerJob[]

  @@index([orgId])
  @@index([tokenPrefix])
}

/// One unit of work waiting for, or held by, an on-prem runner.
///
/// This row is the durable record that a shard's queue job is in Redis: an
/// agent inside a customer's network can vanish without a packet, and this is
/// the only place that remembers the work existed.
model RunnerJob {
  id         String          @id @default(cuid())
  orgId      String
  runId      String
  /// 0-based and matching TestResult.shardIndex, or null for the whole run —
  /// the same convention the cloud path uses.
  shardIndex Int?
  status     RunnerJobStatus @default(QUEUED)

  /// Idempotency key, `<runId>:<shardIndex ?? 'all'>`.
  ///
  /// A composite unique on (runId, shardIndex) would NOT do this job: Postgres
  /// treats NULLs as distinct, so the unsharded case — the common one — would
  /// accept the same job twice and a suite would execute twice. A generated
  /// string has no null to be clever about.
  dedupeKey String @unique

  /// JobRequirements: what a runner must have to be offered this. Derived from
  /// the tests in the slice, never from the agent.
  requirements Json    @default("{}")
  /// Run.runnerPool at dispatch, so routing survives an environment edit.
  pool         String?

  /// Who holds it. Kept after the job finishes: "which runner ran this" is the
  /// first question asked when an on-prem result looks wrong.
  runnerId       String?
  /// The fencing token. Minted fresh on every claim and required on every
  /// subsequent call, so a runner that lost its lease — paused VM, partitioned
  /// network, a reap it never saw — cannot write results into work another
  /// runner is now executing. Without this, "reclaimable" and "never executes
  /// twice" are not both true.
  leaseId        String?
  /// The lease deadline. A job past it with a live status is reclaimable.
  leaseExpiresAt DateTime?
  /// Stamped by the agent while it works, exactly like RunShard.heartbeatAt.
  heartbeatAt    DateTime?

  /// Claims so far. A job that keeps being claimed and dropped is a runner that
  /// keeps dying, and re-offering it forever is how a run hangs for a day.
  attempt     Int @default(0)
  maxAttempts Int @default(3)

  queuedAt   DateTime  @default(now())
  claimedAt  DateTime?
  startedAt  DateTime?
  finishedAt DateTime?

  /// Always a sentence a customer can act on: which capability was missing,
  /// which runner went silent, how long it waited.
  errorMessage String?

  run    Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  runner Runner? @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([runId])
  @@index([runnerId])
  /// The claim query: oldest claimable job in this org's pool.
  @@index([orgId, status, queuedAt])
  /// The reaper's query: live leases that are past their deadline.
  @@index([status, leaseExpiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Team workflow (§8) — ownership, bulk triage, and the nightly digest
//
// Everything above answers "what happened". These four tables answer the three
// questions a team has once more than one person reads the answer: whose failure
// is this, can I decide forty of them at once, and what did the suite do while
// nobody was watching.
// ─────────────────────────────────────────────────────────────────────────────

/// A named group of people that failures can be routed to.
model Team {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  /// URL-safe handle, and the name a digest mentions: "@payments".
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMember[]
  rules   OwnershipRule[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model TeamMember {
  id        String   @id @default(cuid())
  orgId     String
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([orgId])
  @@index([userId])
}

/// Who hears about a failure.
///
/// Four subjects, exactly one set per row: a test, a suite, a feature, or a
/// CODEOWNERS-style path pattern. The pattern is what makes this survive contact
/// with a real suite — per-test ownership is a table nobody maintains by hand,
/// and a repo that already has a CODEOWNERS file has already answered this
/// question once.
///
/// Precedence and glob semantics live in apps/api/src/lib/ownership.ts, which is
/// pure and tested. This table only stores the rules.
///
/// An unowned test is a normal state. There is no default owner column and no
/// fallback: inventing one would page whoever happened to be listed first, and
/// the second time that happens the whole feature gets turned off.
model OwnershipRule {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// gitignore/CODEOWNERS-style glob, matched against Test.filePath.
  pathPattern String?
  testId      String?
  suiteId     String?
  /// Test.feature, matched case-insensitively.
  feature     String?

  /// Exactly one owner. Both null is not a rule, it is a routing hole that looks
  /// like a rule — which is worse than no row at all.
  ownerUserId String?
  ownerTeamId String?

  /// Order among path patterns. CODEOWNERS is last-match-wins and people expect
  /// that, so the highest position that matches is the one that owns the file.
  position Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  test      Test?   @relation(fields: [testId], references: [id], onDelete: Cascade)
  suite     Suite?  @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  ownerUser User?   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTeam Team?   @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId, position])
  @@index([testId])
  @@index([suiteId])
}

/// One human decision applied to many failures (§3.3 bulk triage).
///
/// The row exists for two reasons: so the decision can be undone, and so the
/// audit trail can be honest. The audit log gets N rows, one per verdict — a
/// single "bulk" row would claim a person reviewed forty failures when they
/// reviewed one cause, and the difference between those two sentences is the
/// entire feature. This table is what lets both be true at once: N decisions,
/// one act, reversible.
model TriageBatch {
  id           String    @id @default(cuid())
  orgId        String
  projectId    String?
  /// The run the selection came from, when it came from one.
  runId        String?
  /// The failure cluster (apps/api/src/lib/cluster.ts) the batch was expanded
  /// from, when the selection was "everything with this cause".
  clusterId    String?
  /// "accept" | "override" | "mute" — applied to every member.
  action       String
  /// Set only when the action was an override.
  overriddenTo Verdict?
  /// The reviewer's note: why one verdict is right for all of them.
  note         String?
  appliedBy    String
  createdAt    DateTime  @default(now())
  undoneAt     DateTime?
  undoneBy     String?

  project Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   TriageBatchItem[]

  @@index([orgId, createdAt])
}

model TriageBatchItem {
  id           String @id @default(cuid())
  orgId        String
  batchId      String
  verdictId    String
  testResultId String

  /// What the verdict held before the batch touched it. Undo restores exactly
  /// this, and only while the verdict still holds what the batch wrote — a row
  /// someone has since re-reviewed is left alone and reported back, because
  /// silently reverting a colleague's decision is not an undo.
  previousReviewState  VerdictReviewState
  previousOverriddenTo Verdict?
  previousReviewedBy   String?
  previousReviewedAt   DateTime?

  batch   TriageBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  verdict TriageVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)

  @@unique([batchId, verdictId])
  @@index([orgId])
}

/// "Here is what your suite did overnight" (§7).
///
/// One per project. Schedules already say when to run and integrations already
/// say where to send; this row is the missing third thing — when to SUMMARISE,
/// and how far back the last summary actually got.
model DigestSubscription {
  id        String @id @default(cuid())
  orgId     String
  projectId String @unique

  cron     String  @default("0 8 * * *")
  timezone String  @default("UTC")
  enabled  Boolean @default(true)

  /// Integration ids to deliver to. Empty means every enabled chat integration
  /// on the org — the same destination set a failing run already reaches, so an
  /// empty list reads as "wherever the failures go", not "nowhere".
  notifyVia String[] @default([])

  lastRunAt     DateTime?
  nextRunAt     DateTime?
  /// The end of the window the last DELIVERED digest covered.
  ///
  /// Separate from `lastRunAt` on purpose. A digest that could not be delivered
  /// must not advance this, or the news it was carrying is lost for good and
  /// tomorrow's digest starts after it. `lastRunAt` says when we tried; this
  /// says how far the story has actually been told.
  lastCoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([enabled, nextRunAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Plugin registry (§4) — code QAAI did not write
//
// Three tables and the reason there are three:
//
//   PluginPublisher  WHO an org has decided to trust. Trust is a property of
//                    the organisation, not of the plugin, and not of this
//                    build: no key ships in the binary, so "unknown publisher"
//                    is a real refusal rather than a formality.
//   Plugin           WHAT is installed, org-wide, exactly as it was verified.
//   PluginEnablement WHERE it is allowed to run. Installing is not running.
//
// The last split is the one worth defending. Merging install and enablement
// would make "install" mean "start executing this against every project I
// have", which is a far larger act than the word describes, and would leave no
// way to take a plugin off production while leaving it on staging.
// ─────────────────────────────────────────────────────────────────────────────

/// A signing key this organisation trusts, and therefore a set of plugins it
/// will accept.
///
/// Adding one is the security decision in this whole feature. It is separate
/// from installing so that the trust and the artifact are approved at different
/// moments by different sentences: "we believe this key belongs to Acme" is a
/// claim about the world that somebody has to check against Acme's own site,
/// and it is not answerable by looking at the plugin.
model PluginPublisher {
  id    String @id @default(cuid())
  orgId String

  /// The `publisher` field manifests are signed under — lowercase kebab.
  publisherId String
  /// What to call them on screen. Free text, from whoever added the key.
  displayName String

  /// Base64 of the RAW 32-byte Ed25519 public key.
  ///
  /// Normalised on the way in (packages/shared/src/plugin-manifest.ts accepts
  /// the SPKI DER too) so that this column has exactly one representation.
  /// Storing whatever the operator pasted would mean the same key could sit
  /// here twice under two encodings, and a revocation would only cut off one
  /// of them.
  publicKey   String
  /// SHA-256 of the key, grouped in fours. Derived, and stored anyway: it is
  /// what a person compares against the publisher's website, and recomputing it
  /// for a list means the UI can only show it after a round trip.
  fingerprint String

  /// Revocation is a timestamp, not a delete, for the same reason it is on
  /// Runner: the plugins installed under this key still point at it, and an
  /// audit trail that dangles cannot answer "what did we trust in July".
  revokedAt DateTime?
  revokedBy String?

  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plugins Plugin[]

  /// One key per publisher name per org. Two rows for "acme" would make
  /// "is this signature from acme" a question with two answers, and a
  /// verification loop that tries them all is a verification that succeeds if
  /// ANY key matches — which is how a revoked key keeps working.
  @@unique([orgId, publisherId])
  @@index([orgId])
}

/// One installed plugin, org-wide.
model Plugin {
  id    String @id @default(cuid())
  orgId String

  /// From the manifest. Unique per org, and refused outright when it collides
  /// with a first-party plugin name — see RESERVED_PLUGIN_NAMES.
  name    String
  version String

  publisherRowId String
  /// Denormalised from the publisher row so a listing can name the publisher
  /// without a join, and so the audit trail still says who signed it after the
  /// publisher row is renamed.
  publisher      String

  displayName String
  description String
  homepage    String?

  /// The runner contract this build was accepted against. Stored rather than
  /// re-derived: when QAAI's protocol moves, this column is what says which
  /// installs need attention, and re-reading it from the manifest JSON would
  /// mean a scan.
  protocol Int

  /// PluginCapability[] — the vocabulary in @qaai/shared. Held as a column and
  /// not only inside `manifest` because it is queried ("what can reach our
  /// secrets?"), rendered on every row, and enforced by the runner, and a
  /// question asked that often should not require parsing a JSON blob.
  capabilities         String[] @default([])
  /// The subset that needed the org's plan to permit it. Recorded at install
  /// time so a later downgrade is answerable — it says what was granted under
  /// which plan, rather than leaving it to be recomputed from today's.
  governedCapabilities String[] @default([])

  /// SHA-256 of the code bundle, from inside the signed manifest. THE integrity
  /// anchor: the runner must refuse to load bytes that do not hash to this.
  codeSha256 String
  codeBytes  Int
  /// Entry path inside the bundle, relative, validated on install.
  codeEntry  String

  /// The verified manifest, verbatim, and the detached signature over it.
  ///
  /// Kept so verification can be REDONE — on a protocol bump, on a key
  /// rotation, on the runner before it loads anything — rather than trusting
  /// the columns above, which are a convenience copy this row could in
  /// principle drift from. Order is not preserved by jsonb, which is exactly
  /// why the signature is over a canonical serialisation.
  manifest  Json
  signature String

  installedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publisherRow PluginPublisher    @relation(fields: [publisherRowId], references: [id], onDelete: Restrict)
  enablements  PluginEnablement[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([publisherRowId])
}

/// Whether an installed plugin may run against one project.
///
/// A row means a decision was made; no row means the default, which is OFF.
/// That is deliberate: absence has to read as "not enabled", because the
/// failure mode of the other convention is a plugin installed once and silently
/// live on every project created afterwards.
model PluginEnablement {
  id        String @id @default(cuid())
  orgId     String
  pluginId  String
  projectId String

  enabled   Boolean @default(true)
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plugin  Plugin  @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([pluginId, projectId])
  @@index([orgId])
  @@index([projectId, enabled])
}

// ─── Coverage of the application under test (the denominator) ────────────────

/// Which axis a surface item sits on. Mirrors SURFACE_KINDS in
/// packages/shared/src/surface.ts — the two lists must not drift, and
/// `check:wiring` asserts they do not.
enum SurfaceKind {
  ROUTE
  ENDPOINT
  FORM
  AUTH_SURFACE
  ROLE_CELL
  COMPONENT_STATE
  FLAG_COMBINATION
  BACKGROUND_JOB
  NOTIFICATION
  ERROR_STATE
  DEVICE_LOCALE
  DATA_VARIANT
}

/// Where an item came from. SOURCE_ONLY is the one no runtime-only tool can see:
/// the code declares it and no crawl has ever reached it.
enum SurfaceOrigin {
  SOURCE_ONLY
  CRAWL_ONLY
  BOTH
}

enum SurfaceStatus {
  COVERED
  ASSERTED_NOT_RUN
  UNCOVERED
  UNKNOWN
  WAIVED
}

/// Which declarer put an item in the inventory. Mirrors SURFACE_SOURCES in
/// packages/shared/src/surface.ts; `check:enums` diffs them.
///
/// `SurfaceOrigin` above is the two-source summary — source analysis, or a
/// crawl — and for two slices those were the only declarers that existed. That
/// is also why every surface NEITHER can see was absent from the denominator
/// rather than uncovered: a background job, an outbound email, a webhook
/// receiver, a feature flag, a role, a locale, an error path, a download.
/// Nothing crawls them and no route table declares them, so they were not
/// UNCOVERED — they were not THERE, and absent flatters the number while
/// uncovered lowers it.
///
/// REQUIREMENT, MANUAL and CATALOGUE are the three that can name an
/// uncrawlable surface at all, which is the entire reason this enum exists.
enum SurfaceSource {
  CRAWL
  SOURCE
  SITEMAP
  OPENAPI
  TRAFFIC
  REQUIREMENT
  MANUAL
  CATALOGUE
}

/// Whether a test can drive an item HERE, and the two reasons it cannot.
///
/// Not coverage, and never to be stored as coverage. An item in either of the
/// last two states stays in the inventory, is counted, and is NAMED in the
/// report — dropping it instead is the move that makes a coverage percentage go
/// up, because the surfaces we cannot drive are the hardest ones.
///
/// UNEXERCISABLE is a statement about the ENVIRONMENT (give it a disposable
/// account and it becomes exercisable). REFUSED is a statement about POLICY: we
/// did not look, and nothing is claimed in either direction. A refused surface
/// and a nonexistent surface must never be recorded the same way, which is
/// exactly what packages/agent/src/crawler.ts does today — /logout, /delete-*,
/// /destroy and __reset are dropped with no record at all.
enum SurfaceExercisability {
  EXERCISABLE
  UNEXERCISABLE
  REFUSED
}

/// The dimensions a surface item can be multiplied along. Mirrors
/// SURFACE_DIMENSION_KINDS in packages/shared/src/surface.ts.
///
/// These six exist as strings inside one JSONB blob today — `requiresRoles` on
/// a flow node, a locale list in a spec, a device name in a test title — and a
/// string inside a blob cannot be counted, so "route × role × locale" has never
/// been a denominator. There was nothing to divide by.
enum SurfaceDimensionKind {
  ROLE
  LOCALE
  DEVICE
  FLAG
  JOB
  EMAIL
}

/// One testable thing in the customer's application.
///
/// Rows, not a recomputed blob. The previous coverage implementation derived its
/// answer on every request from the flow map and threw it away, which meant no
/// trend, no gate, nothing to diff a release against, and no way to name an item
/// in a waiver. A denominator has to be addressable to be defensible.
///
/// `key` is the identity and is stable across runs by construction — derived
/// from the kind and the canonical identity only, never from a line number, so
/// reformatting a file does not retire an item and mint a new one.
model CoverageItem {
  id        String        @id @default(cuid())
  orgId     String
  projectId String
  kind      SurfaceKind
  /// `KIND:identity`, e.g. `ROUTE:/orders/:id`. Unique per project.
  key       String
  label     String
  /// Repo-relative file the source detector read it from.
  file      String?
  /// For the editor link only. Deliberately not part of `key`.
  line      Int?
  origin    SurfaceOrigin
  /// The sentence justifying the item's existence, in the customer's terms.
  /// This is what makes the denominator auditable rather than asserted.
  evidence  String
  detector  String?
  /// Kind-specific detail: a form's fields, an auth surface's kind.
  meta      Json          @default("{}")

  /// SurfaceSource[] — every declarer that put this item in the inventory.
  ///
  /// NULLABLE WITH NO DEFAULT, and the three states are the contract: null
  /// means this row predates the column and nobody recorded a declarer, `[]`
  /// would mean we looked and found none (which is not a thing that can happen
  /// to an item that exists), and a list is the fact. `origin` above stays and
  /// is DERIVED from this with `originFromSources` — never set independently,
  /// or an item's two provenance fields will disagree and only one of them is
  /// on screen.
  sources             Json?
  /// Whether a test may drive it here. Null means nobody classified it, and
  /// `exercisabilityCounts` deliberately COUNTS that case: reading "not
  /// classified" as "not allowed" would drop most of an existing install's
  /// denominator in one deploy and the percentage would jump with nothing to
  /// explain it.
  exercisability      SurfaceExercisability?
  /// UNEXERCISABLE_REASONS — set only when exercisability is UNEXERCISABLE.
  /// Text and not an enum: the domain is enforced at the producer
  /// (`surfaceExerciseSchema`), exactly as `Project.closureApprovalPolicy` and
  /// `MutationSurvivor.reason` are, so this does not add a sixth enum whose
  /// only job is to need a drift guard.
  unexercisableReason String?
  /// The policy rule that refused it, when exercisability is REFUSED. Required
  /// in spirit: "excluded by policy" with no rule named is indistinguishable
  /// from a bug in our crawler, and a customer's only possible response to that
  /// is to stop believing the number.
  refusedByRule       String?
  /// The sentence shown beside the state.
  exerciseDetail      String?
  /// The environment this item was OBSERVED in. Null for a source declaration,
  /// which is environment-independent.
  ///
  /// Without it a staging-only route enters a production project's denominator
  /// and is reported as an uncovered production gap — the same defect as the 13
  /// flow-map readers that order by `version` across every environment.
  environmentId       String?
  /// DimensionCoordinate[] — the cell coordinates for a multi-axis item, as
  /// `dimensionCellIdentity` encodes them into `key`. Carried separately so a
  /// reader need not parse the key, and so a cell with no coordinates is
  /// visibly wrong rather than quietly counted.
  coordinates         Json?

  status  SurfaceStatus @default(UNCOVERED)
  /// SurfaceMatch[] — which tests cover it, and on what basis.
  matches Json          @default("[]")

  /// Execution verification, kept apart from `matches` on purpose: a test
  /// existing and a test running are different claims, and conflating them is
  /// how a coverage number stops being true.
  lastRunId      String?
  lastStatus     TestResultStatus?
  executed       Boolean           @default(false)
  /// Whether a matched test has been shown to kill a mutant behind this item.
  /// Null until a mutation run has had an opinion. No competitor publishes this.
  mutationKilled Boolean?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  /// Set when the extractor stops finding it, rather than deleting the row — a
  /// disappearing denominator needs an audit trail as much as a growing one.
  retiredAt   DateTime?

  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  waiver           CoverageWaiver?
  /// Requirements claimed to be covered by this surface. The join that lets the
  /// spec side and the crawl side be reconciled at all: a requirement naming a
  /// route and a route the source declares are the same thing seen twice, and
  /// until this row existed there was nothing to say so.
  requirementLinks RequirementLink[]
  /// The route x role cells measured against this item. The join that lets the
  /// authorization axis be reported against the ONE reconciled inventory rather
  /// than against a second list of route strings nobody reconciled.
  accessCells      RouteAccessCell[]
  /// The provenance edges that make up this item's NUMERATOR — one per (test,
  /// source), so a regex and a run can disagree about the same test and the
  /// disagreement is a finding rather than a silent overwrite. `matches` above
  /// stays and is what the cockpit renders; these rows are the durable,
  /// diffable truth beneath it, and they are what lets a tier be computed and
  /// coverage be observed to DROP.
  coverageEdges    TestCoverageEdge[]
  /// What lives BELOW this item, and the reason this round exists. Each of the
  /// three is a SEPARATE denominator and they are never summed: a route's empty
  /// state, one of its form's fields and the ACCESSIBILITY test it owes are
  /// three things to test, and one blended per-item percentage over them would
  /// be the four-summed-denominators defect rebuilt one level down.
  states           CoverageItemState[]
  formFields       CoverageFormField[]
  typeObligations  CoverageTypeObligation[]

  @@unique([projectId, key])
  @@index([orgId])
  @@index([projectId, status])
  @@index([projectId, kind, status])
  @@index([projectId, origin])
  @@index([projectId, retiredAt])
  /// The environment-scoped denominator: "every item that applies to THIS
  /// environment", which is the read every coverage number has to make and
  /// could not. `environmentId` is null for the source-declared majority, and
  /// a btree indexes nulls, so the `environmentId IS NULL OR environmentId = $1`
  /// that a correct reader writes is answered from here.
  @@index([projectId, environmentId])
  /// The two held-out lists the report prints by name: "give us a disposable
  /// account and we will test these 14" and "your crawl policy refused these
  /// 31". Both are small slices of a large table, so the index is the
  /// difference between a section and a sequential scan.
  @@index([projectId, exercisability])
}

/// One value of one dimension: a role, a locale, a device, a flag, a job, an
/// outbound email.
///
/// ── WHY A TABLE ─────────────────────────────────────────────────────────────
///
/// Because "route × role × locale" is the denominator no competitor in this
/// market has, and it is not computable from strings in a blob. Today a role is
/// a string in `FlowNode.requiresRoles` (which nothing ever writes a value
/// into), a locale is a string in a localisation spec, a device is a string in
/// a test title. None of those can be listed, counted, scoped to a project or
/// traced to a declarer, so none of them can be part of a denominator.
///
/// ── WHY THE CROSS PRODUCT IS NOT THE ANSWER ─────────────────────────────────
///
/// 412 routes × 7 roles × 12 locales × 4 devices is 138,432, and printing that
/// as a denominator would be both useless and false — it asserts that every
/// role interacts with every locale on every route, which no declarer has said.
/// `dimensionDenominator` in packages/shared/src/surface.ts counts DECLARED
/// PAIRINGS and reports the cross product beside them, so the gap between what
/// is possible and what anybody has actually asserted is visible rather than
/// implied. `multiAxisDenominator` SUMS the dimensions and never multiplies
/// them: a route × role cell and a route × locale cell are two things to test,
/// not one combined thing.
///
/// ── WHY `available` IS A COLUMN ─────────────────────────────────────────────
///
/// A role we hold no credentials for makes every cell it appears in
/// DIMENSION_UNAVAILABLE, and saying that is far better than reporting those
/// cells as uncovered. "We cannot produce this role here" is a fact about our
/// harness; "nobody tested this role" is a fact about the customer, and only
/// one of them is true.
model SurfaceDimension {
  id        String               @id @default(cuid())
  orgId     String
  projectId String
  kind      SurfaceDimensionKind
  /// Identity within (project, kind), in the APPLICATION's own spelling.
  ///
  /// Never normalised on the way in. A role the app calls `Admin` and one it
  /// calls `admin` are two roles until the customer says otherwise, and
  /// case-folding here would merge two cells and shrink a denominator with
  /// nothing to show for it. `dimensionCellIdentity` builds cell keys from this
  /// value verbatim, so a change to it retires every cell it appears in.
  key       String
  label     String
  source    SurfaceSource
  /// The sentence that justifies the row, same contract as `CoverageItem`.
  evidence  String
  /// The value used when nothing selects one: the anonymous role, the default
  /// locale, the desktop viewport, the flag's off state. At most one per
  /// (project, kind) — enforced by the writer, because two defaults make
  /// `dimensionDenominator`'s default-cell arithmetic ambiguous.
  isDefault Boolean              @default(false)
  /// Whether THIS install can actually produce the value. See the note above.
  available Boolean              @default(true)
  /// DimensionDetail — the discriminated union in packages/shared/src/surface.ts.
  /// A locale's BCP-47 tag and text direction, a device's width and height, a
  /// flag's variants, a job's trigger and schedule, an email's template id.
  /// Flattened into one blob of strings none of those can be validated on the
  /// way in or used to drive anything: a device with no width cannot be
  /// emulated.
  detail    Json
  /// Repo-relative file, or a reference into the catalogue it was read from.
  file      String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  /// Set when the reader stops finding it, rather than deleting the row — same
  /// argument as `CoverageItem.retiredAt`. A role that disappears takes every
  /// cell it was part of with it, and a vanishing denominator needs an audit
  /// trail at least as much as a growing one.
  retiredAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// One row per value per dimension per project. This is also what makes the
  /// reader's upsert idempotent when two extractors find the same role.
  @@unique([projectId, kind, key])
  @@index([orgId])
  /// "Every role in this project" — the per-dimension list, and the input to
  /// every pairing count.
  @@index([projectId, kind])
}

/// A recorded decision not to test something.
///
/// Without waivers 100% is unreachable, and an unreachable target gets gamed
/// rather than met. `byUserId` is required in spirit: a waiver with no owner is
/// a silent exclusion, which is the failure mode this table has to avoid.
model CoverageWaiver {
  id        String    @id @default(cuid())
  orgId     String
  projectId String
  itemId    String    @unique
  reason    String
  byUserId  String?
  byEmail   String?
  /// A waiver with no expiry is how a denominator quietly shrinks forever, so
  /// the UI proposes one. Still nullable: some exclusions are permanent facts.
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  item CoverageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId, expiresAt])
}

/// A stored measurement, so a trend exists and a gate has something to compare.
///
/// The inputs are on the row beside the number because a percentage without its
/// inputs cannot be defended in a meeting. If the crawl was truncated at 60
/// pages, that belongs next to the figure it produced.
model CoverageSnapshot {
  id        String  @id @default(cuid())
  orgId     String
  projectId String
  commitSha String?

  /// The headline. Null, not zero, when there is nothing to divide — an empty
  /// denominator means our extractor found nothing, and printing 0% or 100%
  /// would be a claim about the customer's app made from our own silence.
  percent              Float?
  denominator          Int
  covered              Int
  assertedNotRun       Int    @default(0)
  uncovered            Int
  unknown              Int    @default(0)
  waived               Int    @default(0)
  /// Items the source declares that no crawl reached, and the mirror.
  declaredNeverReached Int    @default(0)
  reachedNeverDeclared Int    @default(0)

  /// SurfaceKindTotals[] — per-axis arithmetic, so the division is checkable.
  byKind Json @default("[]")

  /// What it was computed from.
  analysisId     String?
  flowMapVersion Int?
  testCount      Int     @default(0)
  runId          String?

  /// Things a reader must know before trusting the number.
  caveats     Json   @default("[]")
  /// Changes whenever the answer could change.
  fingerprint String

  /// ── WHAT MAKES A DELTA LEGITIMATE ─────────────────────────────────────────
  ///
  /// A delta is the number teams act on — it goes in the PR comment, the badge
  /// and the digest — and it is the easiest number in this product to compute
  /// wrongly, because subtracting two percentages always succeeds. Two
  /// snapshots taken against DIFFERENT crawls, or against different denominator
  /// definitions, measured different applications; "coverage fell 9 points"
  /// across them is an artefact of our own enumeration changing and will be read
  /// as a regression by everybody who sees it.
  ///
  /// All three are NULLABLE WITH NO DEFAULT, and null is load-bearing: every
  /// snapshot written before this migration has none of them, and that state is
  /// UNCOMPARABLE_FINGERPRINT_MISSING rather than comparable. Defaulting
  /// `crawlVersion` to the current build would claim an old snapshot was
  /// measured by today's enumerator.
  crawlVersion          String?
  crawlFingerprint      String?
  /// The sentence that says WHAT WAS DIVIDED BY: which axes, which waivers,
  /// which scope rules. Without it the percentage has no units, and a scope
  /// change between two snapshots is invisible.
  denominatorDefinition String?

  /// The snapshot this one was compared against, and the result of asking
  /// whether the comparison was allowed. `deltaPercent` is NULL unless
  /// `comparability` is COMPARABLE — the reason is rendered where the delta
  /// would have been. Domain: SNAPSHOT_COMPARABILITIES in
  /// packages/shared/src/coverage-dimensions.ts, enforced at the producer, TEXT
  /// for the same reason as `TestCoverageEdge.cappedBy`.
  previousSnapshotId  String?
  deltaPercent        Float?
  comparability       String  @default("NOT_COMPARED")
  comparabilityDetail String?

  createdAt DateTime @default(now())

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The per-dimension, per-feature and per-team breakdown — each row with ITS
  /// OWN numerator and denominator, never derived by apportioning this
  /// snapshot's global one.
  rollups CoverageRollup[]
  /// The direction of each of those subjects, with the comparability that says
  /// whether its delta is allowed to exist.
  history CoverageHistory[]

  @@index([orgId])
  @@index([projectId, createdAt])
  @@index([projectId, commitSha])
}

// ─────────────────────────────────────────────────────────────────────────────
// The dimensions: what lives BELOW a surface item, and the honesty around it
// ─────────────────────────────────────────────────────────────────────────────

/// The axes a coverage report may be broken down on. Mirrors
/// COVERAGE_DIMENSIONS in packages/shared/src/coverage-dimensions.ts;
/// `check:enums` diffs them.
///
/// Thirteen, because the previous slice could measure a route, an endpoint, a
/// form and an auth surface and NOTHING BELOW ONE. A route was one slot
/// whatever state it was in; a form was one boolean; a PERFORMANCE test marked
/// a route fully visited exactly as an E2E did. Those are not rounding errors:
/// an untested empty state, an untested 403 and an untested pagination boundary
/// were INVISIBLE rather than uncovered, and invisible raises the percentage
/// while uncovered lowers it.
///
/// A dimension in this enum with no extractor is reported as UNMEASURED by
/// name, never as 0%. `EXTRACTED_COVERAGE_DIMENSIONS` in the shared module is
/// the list of axes this build actually measures, and it starts EMPTY.
enum CoverageDimensionKind {
  PAGE_STATE
  ERROR_STATE
  DATA_VARIANT
  FORM_FIELD
  VALIDATION_RULE
  COMPONENT
  COMPONENT_STATE
  TEST_TYPE
  DEVICE_LOCALE
  FLAG_COMBINATION
  ROLE_CELL
  BACKGROUND_JOB
  NOTIFICATION
}

/// Every kind of cell that lives below a surface item. Mirrors
/// COVERAGE_CELL_KINDS in packages/shared/src/coverage-dimensions.ts.
///
/// ONE enum and not six, because six dimension modules are written against it
/// in parallel and the failure this vocabulary exists to prevent is two of them
/// inventing their own notion of "a page state". `CELL_KIND_DIMENSION` in the
/// shared module is a `Record` keyed on this union, so a kind cannot be added
/// without somebody naming the denominator it counts toward — and a kind
/// counted toward no denominator is counted nowhere, which is the invisible
/// state again.
///
/// PAGE_EMPTY and DATA_NONE are both "nothing here" and are deliberately NOT
/// one member: the first is a page that rendered with no content, the second is
/// the same page driven against a zero-row fixture, which is a test somebody
/// has to write on purpose. A shared spelling would have merged two
/// denominators the moment two modules wrote rows.
enum CoverageCellKind {
  PAGE_DEFAULT
  PAGE_LOADING
  PAGE_EMPTY
  PAGE_SLOW
  PAGE_INTERSTITIAL
  PAGE_REDIRECTED
  ERROR_UNAUTHENTICATED
  ERROR_FORBIDDEN
  ERROR_NOT_FOUND
  ERROR_SERVER
  ERROR_VALIDATION
  DATA_NONE
  DATA_ONE
  DATA_MANY
  DATA_PAGE_BOUNDARY
  DATA_MAXIMUM
  DATA_MALFORMED
  FORM_FIELD
  RULE_REQUIRED
  RULE_LENGTH
  RULE_RANGE
  RULE_STEP
  RULE_PATTERN
  RULE_SEMANTIC
  COMPONENT
  COMPONENT_DEFAULT
  COMPONENT_LOADING
  COMPONENT_EMPTY
  COMPONENT_ERROR
  COMPONENT_FORBIDDEN
  COMPONENT_SLOW
}

/// WHY A CELL CARRIES NO MEASUREMENT. Mirrors DIMENSION_UNMEASURED_REASONS.
///
/// THE honesty column of this whole slice. An unmeasured cell with no reason is
/// indistinguishable from an uncovered one, which moves the percentage down for
/// something the customer neither caused nor can fix; and an unmeasured
/// DIMENSION read as 0% is "0% of your component states are covered", a lie
/// about the customer's application assembled out of our own silence.
///
/// An enum and not TEXT — unlike `CoverageItem.unexercisableReason` and
/// `TestCoverageEdge.cappedBy`, which are TEXT precisely because nothing
/// filters on them. This one is filtered on and grouped by: the report lists
/// the axes we do not measure separately from the ones a cap truncated, because
/// the first is work for us and the second is a budget to raise.
enum DimensionUnmeasuredReason {
  NO_EXTRACTOR
  NOT_ENUMERATED
  EXTRACTOR_RETURNED_UNKNOWN
  HELD_OUT
  CAP_BIT
}

/// Whether this deployment can execute a test type at all. Mirrors
/// DEPLOYMENT_CAPABILITY_STATUSES.
///
/// The worker image has no k6, Lighthouse, Stryker, Maestro, Firefox or WebKit,
/// and the plugins for those types degrade to SKIPPED. So a pass rate and a
/// coverage percentage can both include tests that ALWAYS skip, and nothing
/// anywhere said which of the nineteen types a deployment can actually run.
///
/// NOT_CHECKED is the member a careless writer would collapse, and it must not
/// be: reporting an unprobed type as MISSING is a claim about an image nobody
/// looked at, and reporting it as AVAILABLE lets a cached tick stand in for a
/// binary that has since vanished. Same rule as `ApiOperationVerification`'s
/// NOT_PROBED.
enum DeploymentCapabilityStatus {
  AVAILABLE
  MISSING
  WRONG_VERSION
  NOT_CHECKED
}

/// Whether this deployment could run ONE CELL of a matrix. Mirrors
/// MATRIX_CELL_STATUSES in packages/shared/src/browser-matrix.ts.
///
/// ── WHY SIX WHERE DeploymentCapabilityStatus HAS FOUR ───────────────────────
///
/// That enum answers "can this deployment execute this TEST TYPE", where every
/// negative answer is an install or an upgrade. A CELL has two more ways to
/// fail, and neither has a remedy anybody can act on by installing something:
///
///   UNSUPPORTED_COMBINATION -- no deployment anywhere can run it, because the
///       combination does not exist. There is no Firefox beta channel and no
///       WebKit canary. Reporting it as MISSING sends a reader to install a
///       build that was never published; reporting it as SKIPPED hides an
///       authoring mistake inside a percentage.
///   NEEDS_BROWSER_GRID -- the request is coherent and this image can never
///       serve it. A pinned Safari or Firefox VERSION means a released consumer
///       browser, and Playwright ships one patched build of each with no
///       channels; its webkit is NOT Safari. The remedy is a hosted grid or a
///       device farm, which is a purchase.
///
/// NOT_CHECKED carries the same warning as its twin above and for the same
/// reason: an unprobed cell stays in the denominator, because dropping it would
/// let a deployment that never ran a preflight silently shed every cell it could
/// not prove it could run, and the percentage would rise for a probe nobody
/// executed.
///
/// An enum and not a TEXT column because it is GROUPED ON: "how many of this
/// run's cells did we refuse, and for which of the six reasons" is the question
/// that stops a matrix percentage from including cells that cannot run.
enum MatrixCellStatus {
  AVAILABLE
  MISSING
  WRONG_VERSION
  NOT_CHECKED
  UNSUPPORTED_COMBINATION
  NEEDS_BROWSER_GRID
}

/// WHY A RESULT DOES NOT CARRY THE ASSERTION IT IS SUPPOSED TO. Mirrors
/// UNASSERTED_REASONS in packages/shared/src/test-type-decl.ts.
///
/// ── The defect, which is the headline one of this round ─────────────────────
///
/// CHECKOUT COULD BE CLICKED THROUGH AND THE MONEY PATH COULD NOT BE ASSERTED:
/// no 3DS, no decline, no insufficient funds, no webhook transition, no refund,
/// no partial capture -- and the result of clicking through it was a PASS. The
/// same shape runs through every type this round adds. A plugin that cannot make
/// an assertion now records WHICH ONE and WHY, so a pass with a non-empty
/// `notAsserted` is a pass with a stated hole in it that the gate can refuse to
/// count. A pass with nothing recorded is the lie.
///
/// NOT_IMPLEMENTED is the weakest member and is deliberately distinct from
/// CAPABILITY_ABSENT: one is a roadmap item and the other is a Dockerfile line,
/// and a report that merged them would send a customer to install something that
/// does not exist.
///
/// An enum because the one question that makes the column useful -- "how often,
/// across this project, did we fail to assert the webhook transition" -- is a
/// GROUP BY and not a regex over a sentence. Same argument as the migration that
/// moved the mutation score out of a Step TITLE.
enum UnassertedReason {
  CAPABILITY_ABSENT
  PROVIDER_TEST_MODE_LIMIT
  UNREACHABLE_BEHIND_BOT_PROTECTION
  REQUIRES_PROVISIONED_SANDBOX
  WOULD_MUTATE_PROTECTED_DATA
  CAP_BIT
  SURFACE_UNREACHED
  NOT_IMPLEMENTED
}

/// Whether a seeded defect was found. Mirrors FAULT_DETECTION_OUTCOMES.
///
/// NOT_EXERCISED is the member that makes the benchmark worth running: a bench
/// that cannot tell "we had no test for this surface" from "our test ran and
/// passed anyway" reports both as MISSED and is useless in both directions. The
/// first is a coverage gap; the second says the tests we DO have are weak, and
/// that is the finding nobody else in this market can produce.
///
/// BASELINE_DIRTY is a refusal rather than a result. A fault left switched on
/// from a previous run makes every subsequent reading meaningless, so the bench
/// asserts the clean baseline before AND after and records this instead of a
/// detection rate it cannot stand behind.
enum FaultDetectionOutcome {
  DETECTED
  MISSED
  NOT_EXERCISED
  BASELINE_DIRTY
}

/// One state of one surface item: its empty state, its 403, its pagination
/// boundary.
///
/// ── THE DEFECT, VERBATIM ────────────────────────────────────────────────────
///
/// packages/agent/src/coverage.ts folds every state of a route into one entry
/// with the comment "because coverage is a property of the route". It is not. A
/// route serving an empty list, a 403 and a pagination boundary is three things
/// to test, and before this table the second and third were not UNCOVERED —
/// they were absent from the inventory, so they lowered nothing and the
/// percentage was computed as though they did not exist.
///
/// ── WHY `stateKey` AND NOT A COMPOSITE OF COLUMNS ───────────────────────────
///
/// Because `dimensionCellIdentity` in packages/shared/src/surface.ts is the ONE
/// cell-key format in this product and a second one would make two dimensions
/// silently uncomparable. The key is built from the item's identity plus the
/// state's coordinates, so it is stable across runs, readable in a log, and
/// pasteable into a waiver file — which is what makes a state diffable and
/// therefore trendable at all.
model CoverageItemState {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  itemId    String

  /// `dimensionCellIdentity(item.key, coordinates)`. Unique per item.
  stateKey String
  kind     CoverageCellKind
  label    String
  /// Which declarer said this state exists. The crawl saw it, the source
  /// declares a handler, the API document declares the status, or a human said
  /// so — and the three are different strengths of evidence, which is why this
  /// reuses `SurfaceSource` rather than a boolean.
  origin   SurfaceSource
  /// The sentence justifying the row, same contract as `CoverageItem.evidence`.
  evidence String

  /// The state this one is only reachable THROUGH, when there is one: a
  /// validation error behind a submit, a pagination boundary behind page one.
  /// Null for a state reachable directly.
  ///
  /// Not a foreign key to this table's own `id`: the parent may be enumerated
  /// after the child by a different reader, and a self-referential FK would
  /// make the write order load-bearing. The key is stable, so the join is safe.
  parentStateKey String?

  /// When a run or a crawl was OBSERVED in this state. NULL MEANS DECLARED AND
  /// NEVER OBSERVED, which is the same distinction `SurfaceVerification` draws
  /// between a test existing and a test running. Defaulting it to the row's
  /// creation time would turn every declared state into an observed one.
  observedAt DateTime?

  /// Whether a test may drive this state here, and why not. Same three columns
  /// and same contract as `CoverageItem`: a state the crawl REFUSED to reach
  /// (a destructive path, a policy exclusion) stays in the inventory, leaves
  /// the denominator, and is named — it is not a gap and not a pass.
  exercisability      SurfaceExercisability?
  unexercisableReason String?
  refusedByRule       String?
  exerciseDetail      String?

  /// The resolved rung for this state. NULL IS NOT `DECLARED` — it means
  /// nothing claims this state at all, exactly as `TestCoverageEdge`'s section
  /// header records. A default here would mint a claim nothing produced.
  tier               CoverageTier?
  /// Why `tier` is not higher. TEXT, domain `TIER_CAP_REASONS`, enforced at the
  /// producer — the same judgement as `TestCoverageEdge.cappedBy`.
  tierCappedBy       String?
  /// The run that last confirmed the tier. Required in spirit for any tier
  /// above DECLARED, enforced by `coverageItemStateSchema`.
  lastConfirmedRunId String?
  /// Set when this state was NOT measured, with the reason. Nullable because a
  /// measured state has nothing to explain, and the schema refuses the two
  /// contradictory combinations.
  unmeasuredReason   DimensionUnmeasuredReason?
  unmeasuredDetail   String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  /// Set when the enumerator stops finding it, rather than deleting the row —
  /// same argument as `CoverageItem.retiredAt`. A state that disappears is as
  /// much a change in the denominator as one that appears.
  retiredAt   DateTime?

  item CoverageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, stateKey])
  @@index([orgId])
  /// "every state of this item, by kind" — the read behind a route's state list.
  @@index([itemId, kind])
  /// The per-dimension denominator: every PAGE_STATE row in this project. The
  /// dimension is DERIVED from `kind` through `CELL_KIND_DIMENSION`, so the
  /// reader filters `kind IN (…)` from that record rather than storing the
  /// dimension twice and letting the two disagree.
  @@index([projectId, kind, retiredAt])
}

/// One field of one form, or one validation rule derived from one field.
///
/// ── THE DEFECT, VERBATIM ────────────────────────────────────────────────────
///
/// packages/agent/src/coverage.ts marks a whole form "exercised" if any test
/// mentions its submit label, or one field label near a `.fill()`. So a
/// fourteen-field checkout form with one test that types into the email box is
/// 100% of the FORM axis, and `required`, `semantic` and every boundary case
/// are counted by nobody.
///
/// ── WHY FIELDS AND RULES SHARE A TABLE AND NOT A DENOMINATOR ────────────────
///
/// The columns are the same — a rule has a key, an origin, evidence and a tier,
/// exactly as a field does — and `kind` separates the two denominators, with
/// `parentFieldKey` tying a rule to the field it was derived from. They are
/// NEVER summed: a field cell and a rule cell are two things to test, and
/// `FORM_FIELD` and `VALIDATION_RULE` are two entries in
/// `CoverageDimensionKind` for that reason. A single `formCoverage` percentage
/// over both would be the four-summed-denominators defect in miniature.
model CoverageFormField {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  itemId    String

  /// `dimensionCellIdentity(item.key, coordinates)` for the field, or for the
  /// rule. Unique per item.
  fieldKey       String
  /// FORM_FIELD for a field; one of the RULE_* members for a rule.
  /// `coverageFormFieldSchema` refuses a kind whose dimension is neither
  /// FORM_FIELD nor VALIDATION_RULE.
  kind           CoverageCellKind
  label          String
  /// Set on a RULE_* row: the FORM_FIELD row it was derived from. Null on a
  /// field row. The schema requires it for a rule, because a rule with no field
  /// is a cell nothing can ever assert against.
  parentFieldKey String?

  /// The input type as the reader found it: `email`, `number`, `tel`. NULL
  /// means the reader could not tell, which is not the same as `text`.
  inputType String?

  /// WHETHER THE FIELD IS REQUIRED — AND THE THREE STATES THAT MATTER.
  ///
  /// NULL means the reader could not tell. `false` means it looked and the
  /// field is optional. Collapsing null into false is the specific defect this
  /// column exists to avoid: `required` is one of the two boundary cases the
  /// register names as counted by nobody, and reading "we could not read the
  /// attribute" as "there is no rule here" removes the cell from the
  /// denominator and raises the percentage.
  required Boolean?

  /// What the field MEANS, when the reader could tell: EMAIL, PHONE, CARD,
  /// DATE, POSTCODE. TEXT and not an enum — nothing filters rows on it, the
  /// domain is enforced at the producer, and the same judgement is already
  /// recorded on `CoverageItem.unexercisableReason`. NULL is "not classified",
  /// which is why the semantic rules it implies are UNMEASURED rather than
  /// absent.
  semantic String?

  /// The constraints as the crawl or the source found them: maxlength,
  /// minlength, min, max, step, pattern.
  ///
  /// NULL MEANS THE CONSTRAINTS WERE NEVER READ, and that is a different fact
  /// from a field with no constraints. `detectForms` in
  /// packages/shared/src/codebase.ts reads none of them on the source path, so
  /// ten of twenty boundary classes are unreachable from there — a KNOWN open
  /// gap, and one the report must be able to NAME rather than present as a
  /// field with nothing to test. Inside the object every member is
  /// `number | null` and never absent, and `maxLength`/`minLength`/`step` are
  /// refused at 0: a maxlength of zero is not a constraint, it is an absent
  /// attribute that a writer turned into a number. `min` and `max` MAY be 0,
  /// because zero is a real bound.
  constraint      Json?
  /// Whether anything even tried to read the constraints. `false` with a NULL
  /// `constraint` is the honest state for the source path; `true` with a NULL
  /// constraint is a reader bug, and the schema refuses it.
  constraintsRead Boolean @default(false)

  origin   SurfaceSource
  evidence String

  exercisability      SurfaceExercisability?
  unexercisableReason String?
  refusedByRule       String?
  exerciseDetail      String?

  /// Same contract as `CoverageItemState` above: NULL is no claim, never
  /// DECLARED, and a rule is only ASSERTED when a test asserts the rule's
  /// OUTCOME rather than filling the input.
  tier               CoverageTier?
  tierCappedBy       String?
  lastConfirmedRunId String?
  unmeasuredReason   DimensionUnmeasuredReason?
  unmeasuredDetail   String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  retiredAt   DateTime?

  item CoverageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, fieldKey])
  @@index([orgId])
  @@index([itemId, kind])
  @@index([projectId, kind, retiredAt])
}

/// "THIS ROUTE OWES AN ACCESSIBILITY TEST" AS A FACT ABOUT THE ROUTE.
///
/// ── THE DEFECT ──────────────────────────────────────────────────────────────
///
/// Coverage is type-blind: a PERFORMANCE test marks /checkout fully visited
/// exactly as an E2E does, so "routes with an ACCESSIBILITY test: 3 of 14"
/// cannot be said. Nineteen test types against one boolean.
///
/// ── WHY A ROW PER OBLIGATION AND NOT A GLOBAL DEFAULT ───────────────────────
///
/// Because nineteen fabricated denominators is a worse defect than one boolean.
/// Defaulting every route to owing an E2E and an ACCESSIBILITY test would mint
/// 824 obligations for a 412-route project on the day of the migration, report
/// them all as uncovered, and present QAAI's own opinion about what a team
/// should test as the team's debt. So `DEFAULT_TYPE_OBLIGATIONS` in the shared
/// module is EMPTY for every axis, a project states its own in
/// `Project.typeObligationPolicy`, and an obligation nobody declared is NOT
/// OWED and has no row here.
///
/// An obligation that IS owed and cannot be measured — no extractor, or a test
/// type this deployment cannot execute — is UNMEASURED with the reason on the
/// row. It is never counted as covered and never silently dropped.
model CoverageTypeObligation {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  itemId    String
  testType  TestType

  /// Which declarer said this item owes this type. `SurfaceSource` rather than
  /// a new enum: a project policy a human configured is MANUAL, a requirement
  /// that demands an accessibility check is REQUIREMENT, and a detector that
  /// read it out of the repo is SOURCE. Reusing the declarer vocabulary means
  /// the strength of the claim is already ranked and already drift-guarded.
  declaredBy SurfaceSource
  evidence   String

  tier               CoverageTier?
  tierCappedBy       String?
  lastConfirmedRunId String?
  /// Set when the obligation could not be measured. HELD_OUT is the one to read
  /// carefully: an obligation this deployment cannot EXECUTE (see
  /// `DeploymentCapability`) leaves the denominator with a reason, which is the
  /// difference between "4 of 19 test types are not executable here" and a
  /// percentage quietly computed over tests that always skip.
  unmeasuredReason   DimensionUnmeasuredReason?
  unmeasuredDetail   String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  retiredAt   DateTime?

  item CoverageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, testType])
  @@index([orgId])
  /// "every route that owes an ACCESSIBILITY test, and which of them have one".
  @@index([projectId, testType, retiredAt])
}

/// ONE FEATURE'S OR ONE TEAM'S PERCENTAGE, WITH ITS OWN NUMERATOR AND
/// DENOMINATOR.
///
/// ── THE DEFECT ──────────────────────────────────────────────────────────────
///
/// Gaps carry a `feature` string and the totals are global only, so "Payments
/// is at 31%, owned by Team Billing" cannot be said and one global percentage
/// can be assigned to nobody.
///
/// ── THE TWO RULES THAT MAKE THIS HONEST ─────────────────────────────────────
///
/// 1. A FEATURE'S PERCENTAGE IS COMPUTED FROM ITS OWN NUMERATOR AND
///    DENOMINATOR, stored here, never by re-summing a global one. That is why
///    both columns are on the row rather than only a percent: a percentage
///    whose inputs are not beside it cannot be checked, and a rollup derived by
///    apportioning a global denominator is the four-summed-denominators defect
///    wearing a different hat.
/// 2. UNOWNED SURFACE IS A FINDING, NOT AN ERROR. "31% of the surface has no
///    owner" is the most useful sentence a rollup produces, so it gets the
///    named `UNOWNED` bucket rather than being distributed among the teams that
///    do own things or dropped — either of which makes the finding disappear.
///
/// ── WHY `scopeKey` IS A COLUMN ──────────────────────────────────────────────
///
/// PostgreSQL treats NULLs in a unique index as DISTINCT, so a unique on
/// (snapshotId, dimension, feature, teamId) would let the headline row — all
/// three null — be written an unbounded number of times and the writer's upsert
/// would silently stop being idempotent. Every duplicate is a second
/// denominator for the same subject, which is how one screen comes to disagree
/// with another about the same percentage. So the identity is the NOT NULL text
/// `rollupScopeKey` builds, and the three nullable columns stay beside it as
/// what a reader filters on.
model CoverageRollup {
  id         String @id @default(cuid())
  orgId      String
  projectId  String
  snapshotId String

  /// `rollupScopeKey({ dimension, feature, teamId })`. HEADLINE for the global
  /// row. Unique per snapshot.
  scopeKey  String
  /// Null for a rollup across every dimension.
  dimension CoverageDimensionKind?
  /// Null for a rollup not narrowed to a feature; `UNATTRIBUTED` for the
  /// surface no feature could be attributed to, spelled exactly as
  /// apps/api/src/routes/issues.ts already spells it.
  feature   String?
  /// Null for a rollup not narrowed to a team; `UNOWNED` for the surface nobody
  /// owns. NOT a foreign key: the bucket sentinel is not a team id, and the
  /// evidence of what was unowned must outlive a deleted team.
  teamId    String?

  /// Its OWN arithmetic. Both stored, so the division is checkable.
  numerator   Int
  denominator Int
  /// `numerator / denominator`, one decimal, or NULL when the denominator is
  /// zero. Null is not 0 and not 100 — an empty denominator means nothing on
  /// this axis was in scope for this bucket, and printing either number would
  /// be a claim about the customer's application made from our own silence.
  percent     Float?
  /// The rung the percentage was taken at, so two rollups cannot silently be
  /// one at PASSING and one at NAVIGATED. No default: a rollup that does not
  /// say which bar it cleared is not comparable to any other.
  tier        CoverageTier

  /// Cells not measured in this bucket, and why. The same pair as everywhere
  /// else in this slice, because a rollup is the surface a reader is most
  /// likely to quote and therefore the one that can least afford an unexplained
  /// shortfall.
  unmeasured       Int                        @default(0)
  unmeasuredReason DimensionUnmeasuredReason?
  unmeasuredDetail String?

  /// DimensionCapBite[] — every cap that BIT, as a count AND a reason.
  /// Defaulted to `[]` here and nowhere among the counts above: an empty cap
  /// list is a positive and verifiable claim that nothing was truncated,
  /// whereas an empty COUNT would be a claim about the customer's application.
  caps Json @default("[]")

  /// Items deliberately excluded from this bucket, as sentences. A rollup whose
  /// parts do not reconstruct the whole MUST say which items were excluded and
  /// why; without this column the only way to notice is to add the buckets up
  /// by hand and find they do not reach the total.
  exclusions Json @default("[]")

  createdAt DateTime @default(now())

  snapshot CoverageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, scopeKey])
  @@index([orgId])
  /// "this feature over time" and "this team over time" — the trend reads.
  @@index([projectId, scopeKey, createdAt])
  @@index([projectId, dimension, createdAt])
}

/// THE DIRECTION OF ONE SUBJECT'S NUMBER, AND WHETHER A DELTA IS ALLOWED TO
/// EXIST AT ALL.
///
/// ── WHY THIS IS NOT A PAIR OF COLUMNS ON CoverageSnapshot ───────────────────
///
/// Because "when did Payments first drop below 50%" is a question about a
/// SUBJECT, not about a snapshot, and first-seen on the snapshot would make it
/// unanswerable. The snapshot carries its own crawl fingerprint and its own
/// comparability (see the columns added to it in this migration); this table
/// carries one row per subject per snapshot so a feature, a team and a
/// dimension each have a history of their own.
///
/// ── THE RULE THAT MATTERS MORE THAN THE TABLE ───────────────────────────────
///
/// `deltaPercent` IS NULL UNLESS `comparability` IS COMPARABLE. A delta is the
/// number teams act on — it goes in the PR comment, the badge and the digest —
/// and it is the easiest number in this product to compute wrongly, because
/// subtracting two percentages always succeeds. Two snapshots taken against
/// different crawls measured different applications: "coverage fell 9 points"
/// across them is an artefact of our own enumeration changing, and it will be
/// read as a regression by everybody who sees it. So the reason is rendered
/// where the delta would have been.
model CoverageHistory {
  id         String @id @default(cuid())
  orgId      String
  projectId  String
  snapshotId String

  /// `rollupScopeKey` — the same format and the same function as
  /// `CoverageRollup.scopeKey`, so a feature's rollup and a feature's history
  /// are provably about the same bucket. Two key formats would be two features
  /// with the same name.
  scopeKey  String
  dimension CoverageDimensionKind?
  feature   String?
  teamId    String?

  numerator   Int
  denominator Int
  percent     Float?
  tier        CoverageTier

  /// The crawl this reading was taken against. NULL means the writer recorded
  /// none, which makes comparability UNPROVABLE rather than true — see
  /// UNCOMPARABLE_FINGERPRINT_MISSING.
  crawlFingerprint String?

  /// When this subject was first measured at all. The column that makes "it has
  /// been below 50% since the 3rd" a sentence the product can say.
  firstSeenAt DateTime @default(now())

  previousSnapshotId  String?
  previousPercent     Float?
  /// Percentage points. NULL whenever `comparability` is not COMPARABLE, and
  /// also NULL when either side has no percentage — a measurement with no
  /// figure has no change, and 0 would claim nothing changed between a number
  /// and an absence.
  deltaPercent        Float?
  /// SNAPSHOT_COMPARABILITIES in packages/shared/src/coverage-dimensions.ts.
  /// TEXT and not an enum: nothing filters rows on it and the domain is
  /// enforced at the producer, the same judgement as
  /// `TestCoverageEdge.cappedBy`. Defaulted to NOT_COMPARED, which is the
  /// honest default — a row written by a writer that never compared anything
  /// has not established comparability, and COMPARABLE as a default would
  /// produce confident deltas across unknown boundaries.
  comparability       String  @default("NOT_COMPARED")
  comparabilityDetail String?

  createdAt DateTime @default(now())

  snapshot CoverageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, scopeKey])
  @@index([orgId])
  @@index([projectId, scopeKey, createdAt])
}

/// WHICH OF THE NINETEEN TEST TYPES THIS DEPLOYMENT CAN ACTUALLY EXECUTE.
///
/// ── THE DEFECT ──────────────────────────────────────────────────────────────
///
/// The worker image has no k6, no Lighthouse, no Stryker, no Maestro, no
/// Firefox and no WebKit. Those plugins degrade to SKIPPED, so a pass rate and
/// a coverage percentage can both contain tests that can never fail, and
/// nothing anywhere tells anyone which types are in that state. A percentage
/// with un-failable tests in it is a pass that means "we did not check".
///
/// ── WHY `deploymentKey` IS TEXT WITH A SENTINEL ─────────────────────────────
///
/// The unique key is (deploymentKey, testType) and PostgreSQL treats NULLs as
/// DISTINCT, so a nullable column there would let the same probe be written
/// twice and the upsert would stop being idempotent. `<self>` is this
/// deployment's own image; `pool:<name>` is a customer's on-prem runner pool,
/// which genuinely has different binaries. Same angle-bracket convention as
/// `TestResultVariant`'s `<unvaried>`.
///
/// `orgId` IS NULLABLE here and nowhere else in this slice: the cloud image is
/// a property of the INSTALL and belongs to no org, while a runner pool belongs
/// to one. A btree indexes nulls, so the `orgId IS NULL OR orgId = $1` a
/// correct reader writes is answered from the index.
model DeploymentCapability {
  id            String                     @id @default(cuid())
  orgId         String?
  deploymentKey String                     @default("<self>")
  testType      TestType
  status        DeploymentCapabilityStatus

  /// What a human needs in order to fix it: the exact binary, the exact version
  /// range, the exact install line the image would need. Required, because
  /// "MISSING" with no detail is a status nobody can act on.
  ///
  /// NEVER A CREDENTIAL. This field is rendered in the coverage report and in
  /// the preflight summary, so a probe that embedded a token, a cookie or a
  /// storageState value here would be publishing it. Truncated and hashed both
  /// count as leaks.
  detail          String
  remedy          String?
  requiredBinary  String?
  /// The range the plugin needs, and what was found. Both nullable: a probe
  /// that could not read a version says so rather than writing `0.0.0`.
  requiredVersion String?
  observedVersion String?

  /// When the probe ran. NULL MEANS NEVER PROBED, and the schema refuses any
  /// status other than NOT_CHECKED beside a null — a cached AVAILABLE for a
  /// binary that has since vanished is exactly the lie this table exists to
  /// kill, so the age of the answer is part of the answer.
  checkedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deploymentKey, testType])
  @@index([orgId])
  /// "what can this deployment run" — the read the coverage denominator makes
  /// before it will score a type obligation.
  @@index([deploymentKey, status])
}

/// WHICH BROWSERS, CHANNELS AND DEVICE PRESETS THIS DEPLOYMENT ACTUALLY HAS.
///
/// The sibling of `DeploymentCapability`, one axis member at a time instead of
/// one test type at a time. `DeploymentBrowsers` in
/// packages/shared/src/browser-matrix.ts is the fact `resolveMatrixCell` resolves
/// every browser/device cell against, and nothing collected it: every cell in
/// the product resolved against an empty capability, so NOT_CHECKED was not the
/// usual answer, it was the ONLY answer six statuses could ever produce. These
/// rows are what that function now reads.
///
/// ── ABSENCE IS THE CARRIER OF "NOT PROBED", WHICH IS WHY THERE IS NO
///    `installed` NULL AND NO `checkedAt` NULL ──────────────────────────────
///
/// A row exists only when the probe ANSWERED. `installed` is NOT NULL and
/// `checkedAt` is NOT NULL, and that is deliberately different from
/// `DeploymentCapability`, where a NOT_CHECKED row is written for every type so
/// the nineteen are always all present. Here the vocabulary is 27 axis members
/// across three shared lists, and most of them are unanswerable on a given host
/// — Playwright resolves a browser CHANNEL by absolute per-platform paths, so a
/// PATH miss is not evidence of absence. Writing `installed = false` for those
/// would refuse a cell on a machine that has the browser, and writing a
/// NOT_CHECKED row for each would be 27 rows of nothing per deployment. So the
/// missing row IS the NOT_CHECKED, which is exactly what `DeploymentBrowsers`
/// documents: "EVERY FIELD IS OPTIONAL AND ABSENT MEANS NOT PROBED".
///
/// The reader (`deploymentBrowserCapabilities` in
/// apps/worker/src/processors/preflight.ts) therefore never fabricates a `false`,
/// and the writer DELETES a member's row when the probe stops being able to
/// answer for it — a stale `installed = true` for a browser that has since been
/// removed from the image is the same lie `DeploymentCapability.checkedAt`
/// exists to kill.
///
/// `axis` is TEXT and not an enum on purpose: a Prisma enum needs its TypeScript
/// twin in packages/shared/src/constants.ts and its pair in
/// apps/api/scripts/check-enums.ts — neither owned by the slice that added this
/// — and `check:enums` fails a value with no twin. The three values are
/// `'ENGINE'`, `'CHANNEL'` and `'DEVICE_PRESET'`, validated by
/// `isBrowserCapabilityAxis` in packages/runner/src/preflight.ts on the way in
/// and against the shared browser vocabularies on the way out; a row whose
/// `name` no longer appears in them is REJECTED by the reader rather than
/// resolved into a capability nobody can interpret.
model DeploymentBrowserCapability {
  id String @id @default(cuid())

  /// Null for the cloud image, which belongs to no org. A runner pool belongs to
  /// one — the same contract, and the same reason, as on DeploymentCapability.
  orgId String?
  /// `'<self>'` for this image; `pool:<name>` for a customer's own runner pool.
  /// A sentinel rather than a nullable column because the unique key is below
  /// and PostgreSQL treats NULLs there as DISTINCT, which would let one probe be
  /// written twice and stop the upsert being idempotent.
  deploymentKey String @default("<self>")

  /// `ENGINE` | `CHANNEL` | `DEVICE_PRESET`. See the note above on why this is
  /// TEXT.
  axis String
  /// The name from the SHARED vocabulary — `chromium`, `CHROME_BETA`,
  /// `IPHONE_14` — and never Playwright's own descriptor string. A stored
  /// `'iPhone 15 Pro'` breaks the moment the registry renames it, which is the
  /// same argument `DEVICE_PRESETS` makes for existing at all.
  name String

  /// The reading. A row is only written when the probe answered, so there is no
  /// third state in this column — the absence of the row is the third state.
  installed Boolean

  /// What was LOOKED AT, never what was assumed. Rendered into the capability
  /// sentence an operator reads, so: NEVER A CREDENTIAL, and never a path out of
  /// the environment.
  detail String

  /// When the probe ran. NOT NULL, because a row without a reading is not
  /// written at all — the age of the answer is part of the answer.
  checkedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deploymentKey, axis, name])
  @@index([orgId])
  /// "what can this deployment's browser matrix serve" — the read
  /// `resolveMatrixCell` is handed.
  @@index([deploymentKey, installed])
}

/// THE SIGNED, DATED, SCOPED EXPORT — the artefact a buyer is handed.
///
/// ── WHY THE SCOPE COLUMNS HAVE NO DEFAULTS ──────────────────────────────────
///
/// An attestation that does not say what was NOT measured is worse than no
/// attestation, because a reader given a percentage and no scope does not
/// conclude "scope unknown" — they conclude "87% of the application, and the
/// other 13% is ordinary untested code". If in fact nine axes were never
/// measured, four test types cannot execute here and a page budget truncated
/// the crawl at 1,000 URLs, the reader has been told something false by a
/// document containing no false sentence. Omission is the lie.
///
/// So `scopeStatement`, `unmeasured` and `caps` are NOT NULL WITH NO DEFAULT:
/// the INSERT fails without them. That is deliberately stricter than
/// `SuiteHealthSnapshot.caveats`, which defaults to `[]` correctly — there an
/// empty list is a verifiable claim that a scan truncated nothing, here it
/// would be a claim that nothing was unmeasured in a round that added thirteen
/// axes. The type-level half lives in packages/shared/src/attestation.ts, where
/// a module-private brand makes `attest()` the only way to construct one.
model CoverageAttestation {
  id         String  @id @default(cuid())
  orgId      String
  projectId  String
  snapshotId String?

  /// Stable over (denominator definition, crawl version, item set), so two
  /// attestations can be compared without reading them, and so a customer can
  /// recompute it and check our arithmetic. `attestationCanonicalText` names
  /// exactly what goes in and what deliberately does not — the clock and the
  /// issuer are OUT, because two exports of one measurement are one claim.
  fingerprint           String
  /// The enumerator that produced the inventory. Required: two attestations
  /// from different crawl versions are not comparable, and a document that does
  /// not say which crawl produced it cannot be checked against a later one.
  crawlVersion          String
  crawlFingerprint      String?
  /// THE SENTENCE THAT SAYS WHAT WAS DIVIDED BY: which axes are in the
  /// denominator, which waivers were applied, which scope rules the customer
  /// configured. Without it the percentage on this document has no units.
  denominatorDefinition String

  /// The headline. NULL, not zero, when there was nothing to divide.
  percent     Float?
  denominator Int
  covered     Int

  scopeStatement String
  /// AttestationUnmeasured[] — the axes NOT measured, each with its reason and
  /// its sentence.
  unmeasured     Json
  /// DimensionCapBite[] — every cap that BIT, as a count AND a reason.
  caps           Json

  issuedByUserId String?
  issuedAt       DateTime @default(now())
  /// The share token this attestation was published under, when one was
  /// minted. TEXT and not a relation: a share can be revoked and deleted, and
  /// the record that an attestation was published must outlive the link.
  shareId        String?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// One attestation per claim per project. Re-exporting an unchanged
  /// measurement returns the same row rather than minting a second document
  /// that says the same thing with a different id — which is what makes
  /// "is this the PDF you were sent?" answerable.
  @@unique([projectId, fingerprint])
  @@index([orgId])
  @@index([projectId, issuedAt])
}

/// DOES "COVERED" PREDICT QUALITY? — the back-test, with its n always beside
/// it.
///
/// ── WHY THE HONESTY RULES ARE COLUMNS AND NOT CONVENTIONS ───────────────────
///
/// This is the question a buyer actually asks, and it is the question most
/// easily answered with a flattering correlation computed over four defects. So
/// the sample size is stored, the threshold that was APPLIED is stored, and the
/// two rates are NULLABLE: with too few defects the answer is
/// INSUFFICIENT_DATA and both rates are null, never a number.
///
/// ── A BINDING NOTE ON WORDING ───────────────────────────────────────────────
///
/// Nothing in this product may present this as a CAUSAL claim. The columns are
/// named `escapedRate*` and the verdict says SUFFICIENT; there is no column
/// called `predicts` and there must not be one. A correlation between coverage
/// and escaped defects is evidence worth reporting and is not proof that the
/// coverage caused the quality.
model ValidityBacktest {
  id         String  @id @default(cuid())
  orgId      String
  projectId  String
  snapshotId String?

  /// The window the defects were counted over. Both required: a rate with no
  /// window is a rate over an unknown period.
  windowStartAt DateTime
  windowEndAt   DateTime

  /// THE n, ALWAYS. Every number below is meaningless without these four.
  defectCount           Int
  coveredSurfaceCount   Int
  uncoveredSurfaceCount Int
  defectsOnCovered      Int
  defectsOnUncovered    Int

  /// Defects per surface, on each side. NULL WHEN INSUFFICIENT — never 0. A
  /// zero escaped-defect rate on covered surface is the most flattering number
  /// this product could print, and it is exactly what a back-test over three
  /// tickets would produce.
  escapedRateCovered   Float?
  escapedRateUncovered Float?

  /// VALIDITY_VERDICTS in packages/shared/src/coverage-dimensions.ts. TEXT with
  /// the domain enforced at the producer — nothing filters rows on it, so an
  /// enum here would be a sixth new Postgres type whose only job is to need a
  /// drift guard. NOT_ATTEMPTED is distinct from INSUFFICIENT_DATA: one says we
  /// did not look, the other says we looked and there is not enough.
  verdict        String
  verdictDetail  String
  /// The threshold that was applied, disclosed rather than implied, so a reader
  /// can see why 29 defects produced INSUFFICIENT_DATA.
  minimumDefects Int
  /// Where the defect rows came from — which tracker, which query. A rate whose
  /// input nobody can name is a rate nobody can reproduce.
  defectSource   String

  fingerprint String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId, createdAt])
}

/// "WE FIND N% OF SEEDED DEFECTS" — the only ground truth any coverage claim
/// rests on.
///
/// ── WHY THIS TABLE EXISTS ───────────────────────────────────────────────────
///
/// Nothing in this product has ever compared a reported number to a known
/// truth, which is precisely why a catch-all route literal once gave 100%
/// coverage and survived. The demo application in this repo has a KNOWN
/// surface and a catalogue of individually switchable defects; this table is
/// the record of switching them on one at a time and finding out.
///
/// ── THE TWO COLUMNS THAT MAKE IT A BENCHMARK RATHER THAN A DEMO ─────────────
///
/// `seed` — a benchmark you cannot reproduce from a seed is not a benchmark.
/// `baselineCleanBefore` / `baselineCleanAfter` — a fault left switched on from
/// a previous run makes every subsequent reading meaningless, so the clean
/// baseline is asserted at both ends and `baselineCleanAfter` is NULLABLE
/// because a bench that crashed never re-asserted it. Null there means the run
/// did not finish, which is not the same as a dirty baseline.
model BenchmarkRun {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// Reproducibility. Taken as an argument, never generated inside the bench.
  seed    String
  suiteId String?
  /// The suite run the bench drove, when it drove one.
  runId   String?

  faultCount        Int
  /// NULL WHEN THE BENCH DID NOT COMPLETE. 0 detected is a result — a terrible
  /// one — and "we did not finish" is not a result at all; defaulting these to
  /// 0 would make a crashed bench report a 0% detection rate against the
  /// product's own test suite.
  detectedCount     Int?
  missedCount       Int?
  /// Faults whose surface no test exercised. Reported SEPARATELY and excluded
  /// from both halves of the detection rate: counting it as MISSED blames the
  /// assertions for a coverage gap, and counting it as DETECTED is fiction.
  notExercisedCount Int?

  baselineCleanBefore Boolean
  baselineCleanAfter  Boolean?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// Every cap that bit and every degradation that applied, as sentences.
  caveats     Json     @default("[]")
  fingerprint String
  createdAt   DateTime @default(now())

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  faultResults BenchmarkFaultResult[]

  @@index([orgId])
  @@index([projectId, createdAt])
}

/// One seeded defect, and what the suite did about it.
///
/// A ROW PER FAULT and not a count on the run, because the only useful form of
/// this number is PER FAULT CLASS: "we catch 90% of broken validations and 20%
/// of silent failures" is a finding a team acts on, and one blended percentage
/// is a marketing number. `faultClass` is what the rate is grouped by.
model BenchmarkFaultResult {
  id             String @id @default(cuid())
  orgId          String
  benchmarkRunId String

  /// The catalogue entry's stable id, so the same fault is comparable across
  /// runs and a regression in OUR detection is visible.
  faultId        String
  /// The class the rate is grouped by: a broken validation, a 500 on one path,
  /// a missing a11y label, a wrong total, an off-by-one page size, a silent
  /// failure, a flaky race. TEXT with the domain in the catalogue, because the
  /// catalogue is data in the demo app and a Postgres enum would need a
  /// migration every time somebody wrote a new fault.
  faultClass     String
  /// The `CoverageItem.key` the fault lives on. TEXT and not a relation: the
  /// evidence of what was benchmarked must outlive a retired item, the same
  /// argument `TestResultVariant.environment` records.
  surfaceItemKey String?

  outcome          FaultDetectionOutcome
  /// The sentence that justifies the outcome, in the terms a reader can check:
  /// which test went red, or why nothing exercised the surface.
  detail           String
  /// The test that caught it, when one did. TEXT for the same reason.
  detectedByTestId String?

  createdAt DateTime @default(now())

  /// `benchmarkRun` and not `run`, and the reason is a live collision rather
  /// than taste — the same judgement `Project.specRequirements` records. The
  /// nested-read heuristic in scripts/check-wiring.ts treats `run: true` in any
  /// production source as a read of whatever model a relation field called
  /// `run` points at, and `run: true` appears in three routes that have nothing
  /// to do with benchmarks. With this field named `run`, the checker reported
  /// BenchmarkRun as "read by agent.ts, dom-diff.ts and issues.ts" — which
  /// would have gone quiet about a benchmark table with no read path at all.
  benchmarkRun BenchmarkRun @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  /// One result per fault per run. The constraint is what makes the bench's
  /// write idempotent on a retry, and what stops one fault being counted twice
  /// in its class rate.
  @@unique([benchmarkRunId, faultId])
  @@index([orgId])
  /// "the detection rate per class" — the only honest shape of the number.
  @@index([benchmarkRunId, faultClass])
}

// ─────────────────────────────────────────────────────────────────────────────
// Closing the gaps: provenance, and the campaign that spends a budget doing it
// ─────────────────────────────────────────────────────────────────────────────

/// One gap, and the auditable story of whether it was ever actually closed.
///
/// ── THE DEFECT, VERBATIM ────────────────────────────────────────────────────
/// "Gap → plan item → test provenance and verified closure — the
/// gapId→planItemId map is returned in the HTTP response only and PlanItem has
/// no gap column, so QAAI cannot say 'this gap is closed by this test' or
/// notice that it is not."
///
/// Both halves of that sentence matter, and the second one is the expensive
/// half. A product that writes a test for a gap and never re-measures is not
/// wrong once — it is wrong forever, confidently, in the direction that
/// flatters it. The loop that made `Test.authProfileId` necessary is the exact
/// shape: a gap asked for an authenticated test, an anonymous test was written,
/// the gap re-opened on the next analysis, and nothing anywhere noticed that
/// the same gap had now been "closed" four times.
///
/// ── WHY A ROW PER GAP AND NOT A COLUMN ON PlanItem ──────────────────────────
/// `PlanItem.gapId` records an INTENTION ("this item was minted for that gap")
/// and is immutable. This table records a HISTORY, and the history is the
/// product: first seen, proposed, test written, closed, re-opened, re-opened
/// again. A gap can be attempted more than once, by more than one campaign,
/// and `reopenCount` is the number that tells a team their generator keeps
/// producing a test that does not assert what the gap asked for.
///
/// ── THE STATES, AND THE ONE THAT MUST NEVER BE A LIE ────────────────────────
/// `state` is text (see `Project.closureApprovalPolicy` for why not an enum);
/// the domain is `CLOSURE_STATES` in packages/agent/src/coverage.ts, which is
/// also where the transition rule lives, deterministically and with no model
/// call. Two of the seven exist purely so that the table cannot flatter itself:
///
///   NOT_CLOSED    re-measured, a test exists, and the gap is STILL reported.
///                 This is the finding. Folding it into OPEN would lose the
///                 fact that we already spent a generation on it.
///   UNVERIFIABLE  we could not re-measure. No readable crawl, or the gap
///                 report was a ranked PAGE and this gap's absence from that
///                 page is not evidence of anything. A gap that drops off a
///                 truncated list must never be recorded as closed — that is
///                 the single easiest way for this number to become fiction.
model GapClosure {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  /// `CoverageGap.id` — a stable hash of (kind, subject), so the same gap gets
  /// the same id from every later analysis. That stability is what makes this
  /// table possible at all.
  gapId     String
  /// Carried because `gapId` is a hash and a human reading this row needs to
  /// know what it was about even after the gap has stopped being reported.
  gapKind   String
  gapTitle  String

  /// The campaign that last worked on it. Null for a gap recorded by a human
  /// clicking propose rather than by the autopilot.
  campaignId String?
  /// The item minted for it, and the test that item produced. Both nullable and
  /// both separately meaningful: an item with no test is generation that has not
  /// landed (or a model key that was never set), which is a different state from
  /// a gap nobody has proposed anything for.
  planItemId String?
  testId     String?

  state String  @default("OPEN")
  /// The sentence behind the current state, written by `verifyClosure`. Stored
  /// rather than re-derived because the evidence it was decided on (which gaps
  /// the report held that minute) is gone by the time anyone reads the row.
  why   String?

  firstSeenAt   DateTime  @default(now())
  proposedAt    DateTime?
  testSeenAt    DateTime?
  closedAt      DateTime?
  reopenedAt    DateTime?
  /// How many times this gap has come back after being recorded closed. The
  /// number that says "stop generating; this item does not close this gap".
  reopenCount   Int       @default(0)
  /// When closure was last actually checked. Distinct from `updatedAt`: a row
  /// nothing has re-measured for a week is not a row whose state is current,
  /// and a reader has to be able to tell.
  lastCheckedAt DateTime?
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// One row per gap per project, which is what makes the upsert in the
  /// close-loop tick idempotent under a redelivered job.
  @@unique([projectId, gapId])
  @@index([orgId])
  @@index([projectId, state])
  @@index([campaignId])
  /// "Which gap did this test close?" — the reverse read, used when a test is
  /// deleted or disabled and the gaps it was holding closed have to re-open.
  @@index([testId])
}

/// One night's budgeted attempt to move a project's coverage number.
///
/// ── THE DEFECTS, VERBATIM ───────────────────────────────────────────────────
/// "Budgeted closure campaign with a project coverage target — caps are per
/// request (25 proposals, 12/40 plan items) and the overflow becomes prose
/// telling a human to click again." And: "Closure autopilot (scheduled
/// close-the-top-K with an approval policy and a nightly budget) — closure is
/// seven manual steps across three screens."
///
/// So the overflow becomes QAAI's problem. This row is the durable work queue
/// for that: the target, the money cap, the approval policy, how far it has
/// got, what the number was last time, and — the field that makes it a loop
/// rather than a cron job — `nextTickAt`.
///
/// ── WHY THE ROW IS THE QUEUE ────────────────────────────────────────────────
/// There is no `qaai.close-loop` BullMQ queue, and that is deliberate rather
/// than lazy. A re-queueing job whose own result decides whether to re-queue is
/// the shape that produces a worker that never idles, and this repo has already
/// paid for one queue with no consumer (see the bisect note in
/// apps/worker/src/queues.ts). The 60-second scheduler sweep
/// (`processScheduleTick`) advances whatever is due, so the pacing is a column
/// compared against a clock — inspectable in psql, survives every restart, and
/// structurally incapable of spinning faster than the sweep.
///
/// ── WHY ONE CAMPAIGN PER PROJECT PER UTC DAY ────────────────────────────────
/// `@@unique([projectId, dayKey])` IS the nightly budget. It is not a counter
/// that something has to remember to reset: a campaign that spends its budget,
/// settles, or gives up cannot be replaced until the day rolls over, because
/// the insert would collide. Budget enforcement by unique constraint is the
/// only kind that cannot be defeated by a retry.
model ClosureCampaign {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  /// `YYYY-MM-DD` in UTC. UTC and not the project's timezone, because the only
  /// thing this key has to do is be the same string for every worker in every
  /// region that might arm this campaign in the same night.
  dayKey    String

  state String @default("RUNNING")

  /// Resolved from `Project.coverageTargetPercent` when the campaign is armed,
  /// and then frozen. A target edited mid-campaign must not retroactively
  /// decide that last night's run met it.
  targetPercent     Int
  /// How many gaps one tick may propose, and how many the whole campaign may.
  topK              Int
  nightlyItemBudget Int
  approvalPolicy    String

  /// Ticks taken, and the hard ceiling's counter. Bounded by
  /// CLOSE_LOOP_MAX_TICKS so a bug in the stop rule runs out of ticks instead
  /// of running all night.
  tick          Int @default(0)
  itemsProposed Int @default(0)
  /// Consecutive ticks whose coverage delta was inside the settle threshold.
  /// Two in a row is what "the number has stopped moving" means here; one is
  /// what a tick taken before generation landed looks like.
  settledTicks  Int @default(0)

  /// The last two measurements and the gap between them, in PERCENTAGE POINTS.
  ///
  /// Nullable, and null means NOT MEASURED — never 0. A project with no source
  /// analysis and no crawl has an empty denominator and therefore no
  /// percentage, and recording that as 0.0 would make "we cannot see your app"
  /// indistinguishable from "nothing in your app is covered", then settle the
  /// campaign on a delta of zero between two numbers that never existed.
  lastPercent     Float?
  previousPercent Float?
  lastDeltaPoints Float?
  /// The snapshot row the last tick wrote, so the campaign's claim about the
  /// number is traceable to the stored measurement it came from.
  lastSnapshotId  String?

  /// When this campaign asked for a fresh crawl, if it did. At most once per
  /// campaign — so at most once per project per day — because a loop that
  /// re-crawls every tick is a browser farm running until morning.
  recrawlQueuedAt DateTime?

  startedAt     DateTime  @default(now())
  lastTickAt    DateTime?
  /// When the next tick is due, or null when the campaign has stopped. The
  /// scheduler sweep reads exactly this.
  nextTickAt    DateTime?
  /// Why it stopped, in a sentence meant to be shown verbatim. A campaign that
  /// stopped with no reason is a campaign nobody can argue with.
  stoppedReason String?
  finishedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, dayKey])
  @@index([orgId])
  /// The sweep's own query: "every RUNNING campaign whose tick is due". Both
  /// columns, in this order, so the 60-second sweep is an index range scan and
  /// not a scan of every campaign the install has ever armed.
  @@index([state, nextTickAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// The non-crawl half of enumeration (§ coverage)
//
// A crawl can only ever report what it REACHED. Everything below reports what
// EXISTS, read out of something that already says so: an acceptance criterion
// somebody wrote, a TestRail suite somebody has been running by hand for three
// years, an OpenAPI document, a component directory, a cron registration, a
// week of real traffic. None of it existed in this schema in any shape, which
// is why the sentence this product is built on — "your source declares 412
// routes, the crawl reached 25" — could not be said even though both halves
// were in the repository.
//
// Everything here writes into `CoverageItem`, which IS the surface registry.
// There is no second inventory: an API operation, a component state and a
// background job each become a `CoverageItem` on one of the twelve
// `SurfaceKind` axes, with `sources` naming the declarer. The tables below hold
// the DETAIL those rows cannot — a parameter's declared bounds, a requirement's
// acceptance criteria, what a probe actually saw — plus the one thing a blob
// cannot be: addressable.
// ─────────────────────────────────────────────────────────────────────────────

/// Where a requirement or a manual test case was read from. Mirrors
/// SPEC_SOURCE_SYSTEMS in packages/shared/src/requirements.ts; `check:enums`
/// diffs them.
///
/// One enum and not two. A tracker (Jira, Linear) and a test-management suite
/// (TestRail, Xray) are different products, but the column answers one question
/// — whose copy is authoritative, and where does a re-import go to ask again —
/// and splitting it would mean two drift guards for one fact.
/// `TEST_MANAGEMENT_SYSTEMS` narrows it where the distinction matters, which is
/// the sentence "your TestRail suite has 1,840 cases and 210 are automated".
enum SpecSourceSystem {
  JIRA
  LINEAR
  AZURE_DEVOPS
  GITHUB_ISSUES
  XRAY
  ZEPHYR
  TESTRAIL
  QTEST
  MARKDOWN
  CSV
  MANUAL
}

/// The NORMALISED status of a requirement. The source system's own word is kept
/// verbatim in `Requirement.statusRaw` and never thrown away.
///
/// UNMAPPED and NOT_STATED exist so that this normalisation cannot lie.
/// NOT_STATED means the import found no status field at all (a Markdown
/// criteria file usually has none); UNMAPPED means there WAS one and our
/// mapping table does not know the word. Without them, every unrecognised
/// workflow state in every customer's Jira would land on whichever member we
/// chose as a default — and that default decides whether the requirement enters
/// the coverage denominator, which is a percentage moved by a mapping table
/// nobody reviewed.
enum RequirementStatus {
  DRAFT
  READY
  IN_PROGRESS
  DONE
  OBSOLETE
  UNMAPPED
  NOT_STATED
}

/// The shape a criterion was written in, which decides whether a machine can do
/// anything with it. UNSTRUCTURED means we found no structure and fell back to
/// sentence splitting — reported rather than hidden, because a criterion count
/// derived that way is an estimate and must not be printed beside exact ones.
enum AcceptanceCriterionFormat {
  GIVEN_WHEN_THEN
  BULLET
  NUMBERED
  CHECKBOX
  TABLE_ROW
  UNSTRUCTURED
}

/// HOW a requirement came to be linked to a test or a surface. THE honesty
/// column of the traceability feature.
///
/// A person pointing at a test and saying "this covers AC-3" and a regex
/// noticing that a spec title contains the string `AC-3` are not the same fact.
/// A matrix that renders them identically launders a guess into an audit
/// artifact, which is worse than having no matrix. The confidence each method
/// may claim is CAPPED by the method in
/// `LINK_METHOD_CONFIDENCE_CEILING` (packages/shared/src/requirements.ts) —
/// SURFACE_MATCH at 0.5, below `TRACEABLE_LINK_CONFIDENCE`, so a guessed link
/// is named and shown and cannot move the number.
enum RequirementLinkMethod {
  MANUAL
  ID_IN_ANNOTATION
  ID_IN_TEST_NAME
  SURFACE_MATCH
}

/// Whether anything is linked to a requirement or a criterion, and how strong
/// the strongest link is. Derived from the link rows by `linkStateFrom` and
/// stored, never set independently.
///
/// ── WHY THIS IS A COLUMN AND NOT `count(links) = 0` ─────────────────────────
///
/// Because "requirements with no test" is THE report this entity exists to
/// produce, and the absence of rows cannot be indexed, cannot be ordered by,
/// and — the point — cannot be told apart from the absence of a LINKER. A
/// `LEFT JOIN … WHERE link.id IS NULL` silently includes every requirement
/// imported five minutes ago that nothing has looked at yet, and reports our
/// own silence as the customer's gap. NOT_SEARCHED is the default on insert
/// because the default then states the truth.
enum RequirementLinkState {
  NOT_SEARCHED
  NOT_LINKED
  INFERRED
  ASSERTED
}

/// Whether a manual test case has been automated, according to the suite that
/// holds it.
///
/// NOT_STATED is the member that makes the backlog number honest: TestRail's
/// automation field is optional and most installs leave it empty, so folding
/// empty into NOT_AUTOMATED would let us quote a backlog of 1,630 cases at a
/// customer whose suite never claimed anything about 1,400 of them.
/// `manualBacklogTotals` counts the two separately and never sums them.
///
/// CANNOT_AUTOMATE is the TEAM's waiver. The difference from
/// `SurfaceExercisability.UNEXERCISABLE` is whose limit it is: that one is ours.
enum ManualTestAutomationStatus {
  NOT_AUTOMATED
  AUTOMATION_PLANNED
  AUTOMATED
  CANNOT_AUTOMATE
  OBSOLETE
  NOT_STATED
}

/// What a DOCUMENT says about authentication on one operation. Never a claim
/// about the application — that is `ApiOperationProbe.authRequiredInFact`, and
/// the two disagreeing is a finding.
///
/// Five members, and the last two are why this is not a boolean. OpenAPI's
/// `security` can be global, overridden per operation, overridden to the empty
/// array (which MEANS "no auth here"), or omitted entirely; and we may never
/// have read a document at all, because the row came from a source detector or
/// from traffic. Collapsing those into `authRequired: boolean` produces the
/// most dangerous false negative in this product: every operation whose
/// document we did not read reads as public, a negative-auth test is generated,
/// it gets a 401, and the 401 is reported as the application correctly refusing
/// anonymous access — a passing test that asserted nothing.
enum ApiAuthDeclaration {
  REQUIRED
  OPTIONAL
  NONE
  UNSTATED
  NOT_READ
}

/// What we know about whether an operation EXISTS in the running application.
///
/// DECLARED     a document or detector declares it; no probe attempted.
/// NOT_PROBED   probing was CONSIDERED AND NOT DONE — no base URL, a policy
///              refusal, or the probe budget was spent. The reason is on the
///              row. It must never be rendered as "does not exist", and it is
///              the member most likely to be, because it will be the commonest
///              on the day this ships.
/// CONFIRMED    a probe got an answer that proves the path is routed.
/// NO_ANSWER    a probe was made and nothing answered. Unknown, not absent.
///
/// THERE IS DELIBERATELY NO `REFUTED`. A 404 does not prove absence: an
/// unreloaded gateway, a flag that is off, an authorisation wall that hides
/// existence, and a genuinely undeployed operation all return the same 404 and
/// cannot be told apart from outside. So a 404 leaves the state alone and the
/// PROBE ROW records what it saw; "your document declares an operation that
/// 404s" is then a statement about an observation instead of a claim baked into
/// the operation's state that we could not defend.
enum ApiOperationVerification {
  DECLARED
  CONFIRMED
  NO_ANSWER
  NOT_PROBED
}

/// What kind of exported thing a component row is — and, the load-bearing half,
/// WHETHER IT IS ALREADY COUNTED SOMEWHERE ELSE.
///
/// A Next.js `page.tsx` is both an exported component and a ROUTE. A
/// denominator that counts it twice is not a bigger measurement of the
/// application, it is the same application divided by a larger number. Three
/// disjoint inventories of one app on three screens is the defect this round
/// exists to end, and minting a fourth that double-counts the first would be an
/// expensive way to make it worse. `componentHasOwnAxis` in
/// packages/shared/src/api-surface.ts is the guard: PAGE and LAYOUT report the
/// ROUTE axis and must not be added to a denominator that already holds it.
enum ComponentItemKind {
  COMPONENT
  PAGE
  LAYOUT
  HOOK
  CONTEXT_PROVIDER
  UTILITY
}

/// The named states a component can be in, which is what turns "not just the
/// happy path" from an adjective into a count.
///
/// The five that are not DEFAULT are where every interesting frontend defect
/// lives: a spinner that never clears, an empty state that renders `undefined
/// results`, an error boundary nobody has ever seen, a forbidden state that
/// leaks the shape of what it hides, and a slow response the UI treats as a
/// failure. SLOW is in the list although it is not a render branch, because it
/// is the state a test can only reach by holding a response open and the one
/// nobody writes by hand.
enum ComponentStateKind {
  DEFAULT
  LOADING
  EMPTY
  ERROR
  FORBIDDEN
  SLOW
}

/// One requirement: a behaviour somebody specified.
///
/// ── WHY THIS ENTITY DID NOT EXIST AND WHAT THAT COST ────────────────────────
///
/// Two questions were unaskable without it. "Which acceptance criterion has no
/// test?" is the enterprise question and the whole of Xray's and Zephyr's
/// traceability product; QAAI could not ask it because there was nothing to ask
/// it about. And "what is specified and not yet built?" names the one surface
/// no extractor and no crawl can ever find — there is nothing to extract and
/// nothing to reach — which is also the only surface where a generated test is
/// useful BEFORE the feature lands.
///
/// ── THE STATUS IS NOT IN THE CONTENT HASH ───────────────────────────────────
///
/// `contentHash` covers the external id, title, body and criteria, in that
/// order, canonicalised by `requirementCanonicalText`. The status is excluded on
/// purpose: a ticket moving from READY to DONE is not an edit to the
/// specification, and hashing it would re-open every link in a project on the
/// day its sprint closed.
model Requirement {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// The id in the source system: `PROJ-412`, `#1884`. Unique per project per
  /// system — two trackers may both have a `PROJ-412` and they are not the same
  /// requirement.
  externalId   String
  sourceSystem SpecSourceSystem
  title        String
  /// Prose. Empty string is legal and common: plenty of tickets are a title and
  /// a list of criteria, which live in `criteria` as rows.
  body         String            @default("")
  status       RequirementStatus
  /// The source system's own word for the status, verbatim.
  ///
  /// REQUIRED IN SPIRIT when `status` is UNMAPPED: "we could not map it" with
  /// nothing to show is indistinguishable from a bug in our mapping table, the
  /// same argument `CoverageItem.refusedByRule` makes for REFUSED. Enforced at
  /// the producer by `requirementImportSchema`, since a conditional NOT NULL is
  /// not something a column can express.
  statusRaw    String?
  url          String?

  /// Hash of the canonical content, so a re-import can tell CHANGED from
  /// UNCHANGED — and, through `classifyReimport`, can tell both of those from
  /// NOT_COMPARABLE when a stored row carries no hash. Calling that UNCHANGED
  /// drops the customer's edit silently; calling it CHANGED churns every link on
  /// every import until people stop reading the matrix.
  contentHash      String
  /// When the content last actually differed. Null means no import has ever
  /// seen it change, which for a row imported once is simply the truth.
  contentChangedAt DateTime?

  /// Whether anything is linked, and how strongly. See the enum's note for why
  /// this is a column: NOT_SEARCHED (our silence) and NOT_LINKED (the finding)
  /// are opposite facts and `count(links) = 0` cannot tell them apart.
  linkState RequirementLinkState @default(NOT_SEARCHED)
  /// When a linker last ran over this requirement. Null whenever `linkState` is
  /// NOT_SEARCHED, and the pair is what makes "our silence" auditable rather
  /// than asserted.
  linkedAt  DateTime?

  firstImportedAt DateTime  @default(now())
  lastImportedAt  DateTime  @updatedAt
  /// Set when the source system stops returning it, rather than deleting the
  /// row — same argument as `CoverageItem.retiredAt`. A requirement that
  /// vanishes takes its links with it, and a shrinking denominator needs an
  /// audit trail at least as much as a growing one.
  retiredAt       DateTime?

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criteria AcceptanceCriterion[]
  links    RequirementLink[]

  @@unique([projectId, sourceSystem, externalId])
  @@index([orgId])
  /// THE REPORT: "every requirement in this project that no test covers",
  /// ordered and paged. Without it that is a scan of every requirement in the
  /// install on a screen a customer opens daily.
  @@index([projectId, linkState])
  /// The generation filter: a READY requirement's test is expected to FAIL and
  /// an OBSOLETE one is not a gap at all, so selection reads by status.
  @@index([projectId, status])
  @@index([projectId, retiredAt])
}

/// One acceptance criterion, as a ROW.
///
/// A row per criterion rather than one prose body is the entity's whole point:
/// "which acceptance criterion has no test?" is a question about rows, and a
/// paragraph holding four criteria is one uncoverable thing instead of four
/// coverable ones.
model AcceptanceCriterion {
  id            String @id @default(cuid())
  orgId         String
  requirementId String

  /// Position within the requirement, from 0. Part of the identity: criterion 3
  /// of PROJ-1 is something a test links to, so a re-import compares text at an
  /// ordinal and reports a MOVE rather than treating it as a delete plus an
  /// insert, which would retire a link somebody asserted.
  ordinal    Int
  text       String
  format     AcceptanceCriterionFormat
  /// The source system's own id, when it has one. Xray and Zephyr do; a
  /// Markdown bullet does not, and null is the honest answer rather than a
  /// synthesised id that changes when a bullet is inserted above it.
  externalId String?

  /// Per-criterion link state, derived by the same `linkStateFrom`. This is the
  /// column the enterprise question is actually asked against: a requirement
  /// can be ASSERTED through one criterion while three others are NOT_LINKED,
  /// and a matrix that only has requirement-level state reports that as covered.
  linkState RequirementLinkState @default(NOT_SEARCHED)
  linkedAt  DateTime?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  retiredAt   DateTime?

  requirement Requirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  links       RequirementLink[]

  @@unique([requirementId, ordinal])
  @@index([orgId])
  /// "Which criteria have no test?" across a project — the read the report
  /// pages through, and the reason `linkState` is stored on this table too.
  @@index([linkState])
}

/// One claim that a test or a surface covers a requirement.
///
/// ── THE PROVENANCE IS THE PRODUCT ───────────────────────────────────────────
///
/// `method` and `confidence` are not metadata. A link a human asserted and a
/// link a regex guessed must never read the same, because the second kind is
/// the only kind that scales and the first kind is the only kind that is
/// evidence. `clampLinkConfidence` caps what each method may claim and reports
/// the cap when it bites — an undisclosed cap on a confidence score is an
/// undisclosed change to the coverage number.
///
/// ── EXACTLY ONE TARGET ──────────────────────────────────────────────────────
///
/// `testId` XOR `coverageItemId`. Not expressible as a column constraint
/// without a CHECK (this schema has none anywhere, and Prisma's drift detection
/// does not model them), so it is enforced on the way in by
/// `requirementLinkTargetSchema` and on the way out by `linkTargetOfRow`, which
/// returns NULL for a row with both or neither rather than picking whichever
/// column happened to be non-null. A malformed row is reported, never silently
/// read as a test link.
model RequirementLink {
  id            String  @id @default(cuid())
  orgId         String
  projectId     String
  requirementId String
  /// Set when the link is about one criterion. Null means it is about the
  /// requirement as a whole, which is what a ticket id in a test name proves
  /// and all it proves — promoting that guess to criterion granularity would
  /// answer the enterprise question with a link nobody made.
  criterionId   String?

  /// The automated test claimed to cover it. Exactly one of this and
  /// `coverageItemId` is set.
  testId         String?
  /// The surface registry row claimed to cover it. A `CoverageItem.id`, which
  /// the linker resolves from a `key` — a key with no row is a dangling
  /// reference in OUR extractor, exactly like `dimensionDenominator`'s
  /// `undeclaredValues`, and must be reported as one rather than dropped.
  coverageItemId String?

  method     RequirementLinkMethod
  /// 0–1, already clamped to this method's ceiling by `clampLinkConfidence`.
  confidence Float
  /// The sentence that justifies the link, in the customer's terms — and the
  /// place the clamp's `rule` is recorded when a cap bit. Same contract as
  /// `CoverageItem.evidence`: this is what makes the matrix auditable rather
  /// than asserted.
  evidence   String

  /// Who asserted it, for a MANUAL link. Kept as a pair, like `CoverageWaiver`:
  /// `onDelete: SetNull` must not erase WHO made the claim, so the email
  /// survives the user row.
  byUserId String?
  byEmail  String?

  createdAt DateTime @default(now())

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement  Requirement          @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  criterion    AcceptanceCriterion? @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  test         Test?                @relation(fields: [testId], references: [id], onDelete: Cascade)
  coverageItem CoverageItem?        @relation(fields: [coverageItemId], references: [id], onDelete: Cascade)
  byUser       User?                @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  /// One claim per (requirement, criterion, target, method). The same test may
  /// be linked to one criterion by an annotation AND by a surface match, and
  /// those are two different pieces of evidence worth keeping apart; the same
  /// method asserting the same thing twice is a duplicate, and this makes the
  /// importer's upsert idempotent.
  /// `map:` is not cosmetic. Prisma's generated name for a five-column unique
  /// would be `RequirementLink_requirementId_criterionId_testId_coverageItemId_method_key`
  /// — 74 bytes, past PostgreSQL's 63-byte identifier limit, which the server
  /// silently TRUNCATES. A hand-written migration and Prisma's own introspection
  /// would then disagree about the constraint's name for ever, and every
  /// subsequent `migrate dev` would report drift it cannot fix.
  @@unique([requirementId, criterionId, testId, coverageItemId, method], map: "RequirementLink_claim_key")
  @@index([orgId])
  @@index([projectId, method])
  @@index([requirementId])
  @@index([criterionId])
  /// "Which requirements does this test cover?" — the reverse read, which the
  /// test detail page and the impact analysis both make.
  @@index([testId])
  @@index([coverageItemId])
}

/// One manual test case: the largest existing record of "what must be tested",
/// and the one QAAI could not read at all.
///
/// TestRail is WRITE-ONLY in this repo today — results are pushed and nothing
/// is ever read back — so a customer's 1,840-case suite was invisible to the
/// denominator while being the most concrete statement of intent they own.
/// With these rows the automation backlog is a NUMBER (`manualBacklogTotals`),
/// and `NOT_STATED` keeps that number from quietly including the cases their
/// suite never classified.
model ManualTestCase {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  externalId     String
  sourceSystem   SpecSourceSystem
  title          String
  /// The steps as ROWS, in order: `[{ ordinal, action, expected }]`. Prose in
  /// one blob cannot be counted, cannot be matched against a generated test's
  /// steps, and cannot show a human which step a conversion dropped.
  steps          Json             @default("[]")
  /// The case-level expected result. Null when the suite records only per-step
  /// ones.
  expectedResult String?
  url            String?

  automationStatus  ManualTestAutomationStatus
  /// The automated test that replaced it, when one exists.
  ///
  /// `onDelete: SetNull`: deleting a test must not delete the customer's manual
  /// case, and the pair (status AUTOMATED, id null) is then a visible,
  /// queryable inconsistency — a case marked automated whose test is gone —
  /// rather than a silent downgrade. Exactly the argument `Test.authProfileId`
  /// and `Test.authProfileRequired` record.
  automatedByTestId String?

  /// When a human last ran it, as the suite reports it. Null is "the suite does
  /// not say", which is NOT "never run": a case with no execution history and a
  /// case whose suite has no such field look identical in a CSV export, and one
  /// of them is a finding.
  lastExecutedAt DateTime?

  contentHash      String
  contentChangedAt DateTime?
  firstImportedAt  DateTime  @default(now())
  lastImportedAt   DateTime  @updatedAt
  retiredAt        DateTime?

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  automatedByTest Test?   @relation(fields: [automatedByTestId], references: [id], onDelete: SetNull)

  @@unique([projectId, sourceSystem, externalId])
  @@index([orgId])
  /// The backlog read: "every case in this project that is not automated",
  /// grouped by status. The one number this table exists to produce.
  @@index([projectId, automationStatus])
  @@index([automatedByTestId])
  @@index([projectId, retiredAt])
}

/// One HTTP operation the application declares.
///
/// ── WHY THIS IS NOT `HttpEndpoint` ──────────────────────────────────────────
///
/// `HttpEndpoint` (a shape inside a stored analysis blob) is a method and a
/// path, where the method is frequently 'UNKNOWN' and nothing ever verifies any
/// of it. OpenAPI — the richest declaration of an application's surface that
/// exists — is parsed today ONLY inside the CONTRACT runner and thrown away the
/// moment the run ends. So the request shapes, the declared auth and every
/// parameter bound were read and discarded on every run, which is why boundary
/// and negative-case generation had nothing to work from.
///
/// ── THE PARAMETER BOUNDS ARE THE POINT ──────────────────────────────────────
///
/// `parameters` is `ApiParameterBound[]`, and its min/max/maxLength/pattern/enum
/// are the single most useful numbers in the whole document: `boundaryEdges`
/// turns them into the values a negative test should send and what the document
/// ENTITLES the test to expect back. Each bound is three-state — absent means
/// this reader does not capture that constraint, explicit null means the
/// declaration states no bound — because a `maxLength` missing because our
/// reader ignores the keyword is a problem in US and must not be reported as
/// the application's.
model ApiOperation {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// GET…TRACE, or 'UNKNOWN' — carried over from `HttpEndpoint.method`
  /// verbatim. TEXT and not an enum: the domain is `API_OPERATION_METHODS`,
  /// enforced at the producer by `apiOperationSchema`, exactly as
  /// `Project.closureApprovalPolicy` and `CoverageItem.unexercisableReason`
  /// are. 'UNKNOWN' is a real answer and not a placeholder — an endpoint whose
  /// verbs are unreadable is still an endpoint, and saying GET would be a guess
  /// dressed as a fact.
  method         String
  /// `/orders/{id}`, as the document spells it. Canonicalised to the repo's
  /// `:param` form only when a `CoverageItem` key is built from it, so the
  /// document's own spelling survives for a human to match against.
  pathTemplate   String
  /// The document's own `operationId`. Null when it has none — most do not.
  operationId    String?
  /// Which document this came from: a URL, a repo-relative path, or a
  /// detector's name. Required: an operation with no provenance cannot be
  /// re-read, re-diffed or disputed.
  sourceDocument String
  /// The sentence that justifies the row, same contract as `CoverageItem`.
  evidence       String

  authDeclaration ApiAuthDeclaration
  /// ApiParameterBound[] — see the note above.
  parameters      Json               @default("[]")
  /// The declared request and response shapes, opaque. Null means the document
  /// declared none. A JSON-schema subset modelled as columns here would be a
  /// second, worse JSON-schema implementation, and the one consumer — boundary
  /// generation — needs the bounds rather than the whole tree.
  requestShape    Json?
  responseShapes  Json?

  verification    ApiOperationVerification @default(DECLARED)
  /// A `NOT_PROBED_REASONS` member, set only when `verification` is NOT_PROBED.
  /// Required in spirit for the same reason as `CoverageItem.refusedByRule`:
  /// NOT_PROBED with no reason is indistinguishable from a bug in the prober,
  /// and a reader's only response to that is to stop believing the number.
  /// BUDGET_SPENT in particular is a cap WE applied, and the report has to be
  /// able to say how many operations it hid.
  notProbedReason String?
  /// The newest probe's timestamp, for ordering without a join. Null while
  /// nothing has ever probed.
  lastProbedAt    DateTime?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  retiredAt   DateTime?

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  probes  ApiOperationProbe[]

  /// The identity. `sourceDocument` is NOT in it on purpose: the same operation
  /// declared by two documents is one operation, and keying on the document
  /// would double the denominator for every customer who publishes both a
  /// gateway spec and a service spec.
  @@unique([projectId, method, pathTemplate])
  @@index([orgId])
  /// "Which declared operations has nothing ever confirmed?" — the read that
  /// makes DECLARED-versus-CONFIRMED a report rather than a column.
  @@index([projectId, verification])
  /// "Which operations does the document say are public?" — the input to
  /// negative-auth generation, which must only run where the document took a
  /// position (OPTIONAL or NONE).
  @@index([projectId, authDeclaration])
  @@index([projectId, retiredAt])
}

/// What answered when we actually asked.
///
/// A row per probe rather than a column on the operation, because a probe is an
/// OBSERVATION with a time and a place, and the interesting findings are
/// differences between observations: an operation the document calls public
/// that 401s, a verb the document declares that 405s, an operation that
/// answered last week and does not now. A single overwritten column would erase
/// every one of those.
///
/// Every field that could be a guess is nullable and null means NOT DETERMINED.
model ApiOperationProbe {
  id          String @id @default(cuid())
  orgId       String
  operationId String

  /// Where it was probed. A BARE COLUMN with no foreign key, following
  /// `CoverageItem.environmentId`: an observation is a historical fact about a
  /// place that existed, and deleting the environment row must not delete the
  /// evidence. Null when the prober was given no environment.
  environmentId String?

  /// The status that came back. Null when nothing answered.
  status             Int?
  /// Whether the verb was allowed. Null when undetermined — a 404 says nothing
  /// about the verb, and only a 405 or an `Allow` header settles it.
  verbAllowed        Boolean?
  /// Whether authentication was required IN FACT: an anonymous request was
  /// refused and the same request with a credential was not.
  ///
  /// Null unless BOTH halves were sent. One anonymous 401 does not establish it
  /// — the operation may be 401-ing everybody, including us — and recording
  /// `true` from half the evidence is how the document and the application come
  /// to agree on paper about an operation that is broken.
  authRequiredInFact Boolean?
  /// True when anything at all answered. What separates CONFIRMED from
  /// NO_ANSWER, and the reason "we got no answer" is never stored as a status
  /// of 0.
  answered           Boolean
  /// The sentence shown beside the probe. Always written, never defaulted to ''.
  detail             String

  observedAt DateTime @default(now())

  operation ApiOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  /// "The newest probe for this operation", which is every read this table has.
  @@index([operationId, observedAt])
}

/// One exported component, hook or page in the customer's application.
///
/// There is no component inventory anywhere in this repo, which is why UNIT_GEN
/// and component-state coverage have no denominator at all — not a low one, an
/// ABSENT one. `kind` carries the guard against the obvious way to make that
/// worse: a PAGE is already counted on the ROUTE axis, and adding it again
/// divides the same application by a larger number.
model ComponentItem {
  id        String @id @default(cuid())
  orgId     String
  projectId String

  /// Repo-relative module path. Identity, with `exportName`.
  modulePath        String
  /// The exported name. `default` is a legal and common value.
  exportName        String
  kind              ComponentItemKind
  /// A one-line summary of the props, for a human and for a generator's prompt
  /// — never the full type. Null when the export takes none.
  propsSummary      String?
  /// Whether a story or catalogue entry exists. THREE STATES and all three are
  /// needed: null means NO CATALOGUE WAS READ, false means one was and this
  /// component is not in it, true means it is. Null read as false reports
  /// "nothing is in Storybook" about a project whose Storybook we never looked
  /// for, which is a measured claim about something not measured.
  hasCatalogueEntry Boolean?
  catalogueRef      String?
  /// The sentence that justifies the row, same contract as `CoverageItem`.
  evidence          String
  /// Which reader produced it, so a systematically wrong one can be found.
  detector          String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  retiredAt   DateTime?

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  states  ComponentState[]

  @@unique([projectId, modulePath, exportName])
  @@index([orgId])
  /// The UNIT_GEN denominator: "every COMPONENT in this project", excluding the
  /// kinds already counted on another axis.
  @@index([projectId, kind])
  @@index([projectId, retiredAt])
}

/// One named state of one component.
///
/// The row that makes "not just the happy path" countable. `source` is reused
/// from `SurfaceSource` rather than invented: a state found by reading a branch
/// on `isLoading` is SOURCE, one found in a Storybook entry is CATALOGUE, one a
/// person typed is MANUAL, and those are the same three distinctions the
/// surface registry already draws.
model ComponentState {
  id          String @id @default(cuid())
  orgId       String
  componentId String

  kind            ComponentStateKind
  source          SurfaceSource
  /// The sentence that justifies it: "renders `<Spinner/>` when `isLoading`".
  evidence        String
  /// The `CoverageItem.key` this state is counted as, on the COMPONENT_STATE
  /// axis. TEXT and not a foreign key, deliberately: the registry row is
  /// written by a different pass and may not exist yet, and a required FK would
  /// make the order of two independent readers load-bearing. A key with no row
  /// is reported as a dangling reference, which is a fact about our own
  /// extractor and the kind we refuse to hide.
  coverageItemKey String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  retiredAt   DateTime?

  component ComponentItem @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, kind])
  @@index([orgId])
  /// "How many non-DEFAULT states does this project declare, and how many are
  /// covered?" — the claim this table exists to make checkable.
  @@index([kind])
}

/// One traffic ingest, and what it cost the denominator.
///
/// ── WHY THE ACCOUNTING IS A ROW ─────────────────────────────────────────────
///
/// `POST /traffic/:projectId/analyze` applies at least four caps today — 50,000
/// entries, 500 tests compared, a `maxJourneys` of up to 40, and a per-session
/// step limit — and EVERY ONE of them is a lever that makes the coverage
/// percentage go UP, because truncating shrinks the denominator while the
/// numerator (the tests that already exist) does not move. All four currently
/// vanish with the HTTP response, so a number computed from a truncated upload
/// is indistinguishable afterwards from one computed from a complete one.
///
/// `journeysDroppedByCap` is a FLOOR and never an estimate: journeys the
/// analysis actually held, ranked and dropped. Same contract as
/// `FlowMap.atLeastMoreUrls`, and inventing a number in the alarming direction
/// is the same sin as inventing one in the flattering direction.
///
/// NOTHING RAW IS STORED HERE, for the same reason routes/traffic.ts never
/// persists its upload: the analysis redacts on ingest, the paths are already
/// parameterised and PII-classified, and the only content-shaped column on this
/// table is a count.
model TrafficIngest {
  id            String  @id @default(cuid())
  orgId         String
  projectId     String
  /// A bare column, as on `ApiOperationProbe`. Null when the uploader did not
  /// say which environment the traffic came from — which is common for a log
  /// file and is why it is nullable rather than defaulted to production.
  environmentId String?

  /// HAR | ACCESS_LOG | OTLP, as detected or declared. TEXT, with the domain
  /// enforced at the producer (`analyzeOptionsSchema` already validates it), so
  /// this does not add an enum whose only job is to need a drift guard.
  format        String
  /// The connector this came from, when it came from one rather than an upload.
  /// An `Integration.id` — a row the customer owns, which is where a
  /// connector's credentials belong; never an environment variable.
  integrationId String?

  /// The window the traffic was observed in, from the entries themselves and
  /// not from the clock. Null when the source carried no timestamps at all, in
  /// which case frequencies are counts without a rate and the report says so.
  observedFrom DateTime?
  observedTo   DateTime?

  entriesParsed        Int
  entriesSkipped       Int  @default(0)
  sessions             Int
  journeysStored       Int
  /// Journeys held, ranked and dropped because a cap bit. The floor behind "at
  /// least N more existed".
  journeysDroppedByCap Int  @default(0)
  /// `[{ cap, limit, droppedAtLeast }]` — every cap that ACTUALLY bit, named,
  /// with the number it was set to. Empty means none did, which is a different
  /// and far better fact than an empty list because nobody looked.
  capsThatBit          Json @default("[]")

  createdAt   DateTime @default(now())
  requestedBy String?

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  journeys ObservedJourney[]

  @@index([orgId])
  @@index([projectId, createdAt])
}

/// One journey real users actually took, made durable.
///
/// The third enumeration source. A crawl reports what it could reach and a
/// source detector reports what the repository declares; this reports what
/// people DO — including the paths nothing in the repo suggests and no crawler
/// would find, because they depend on data only production has.
///
/// One row per journey per project, carrying the LATEST measurement plus the
/// window it was seen in. Not one row per observation: the frequencies move
/// every time a log is uploaded, and keeping every sample would make this table
/// the largest in the product in exchange for a trend nobody asked for.
/// `firstObservedAt`/`lastObservedAt` and `ingestCount` keep the shape of its
/// history; `TrafficIngest` keeps the accounting of each upload.
model ObservedJourney {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  /// The ingest that last updated this row, so every number here is traceable
  /// to the upload and the caps it was computed under.
  ingestId  String

  /// `journeyIdOf`'s deterministic hash of the step sequence (packages/agent/
  /// src/traffic.ts). THE identity, and computed there rather than here so a
  /// journey the client round-trips and a journey we stored cannot disagree.
  journeyKey String
  name       String
  feature    String
  /// `JourneyStep[]` — `[{ method, route, status, errorRate, count, repeats }]`.
  /// Parameterised and PII-classified by the analyser; never a raw URL.
  steps      Json

  /// Sessions whose whole canonical path is exactly this, and that as a share
  /// of all sessions in the window — the headline number, and the reason this
  /// source outranks a crawl for prioritisation.
  sessionCount     Int
  sessionShare     Float
  requestCount     Int
  /// Share of this journey's requests that failed IN PRODUCTION. A journey with
  /// a real error rate and no test is the most valuable row in the table.
  errorRate        Float
  /// Median wall-clock. Null when the source carried no timings — not 0, which
  /// would read as instantaneous.
  medianDurationMs Int?

  firstObservedAt DateTime
  lastObservedAt  DateTime
  /// How many ingests have seen it. 1 is a journey seen once, which is a weaker
  /// claim than one seen in every upload for a month.
  ingestCount     Int      @default(1)

  /// The cross-reference against the existing suite, recomputed on every
  /// ingest: COVERED | PARTIAL | UNCOVERED, and the best test's share of the
  /// steps. TEXT and a Float rather than reusing `SurfaceStatus`, because this
  /// is a STEP-SEQUENCE match and not the registry's item-level verdict —
  /// borrowing the registry's vocabulary for a different computation is how two
  /// screens come to report two coverage numbers.
  coverageStatus String
  matchedRatio   Float
  /// `"POST /checkout"` for every step no test mentions. The named list, which
  /// is the part a customer forwards.
  missingSteps   Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ingest  TrafficIngest @relation(fields: [ingestId], references: [id], onDelete: Cascade)

  @@unique([projectId, journeyKey])
  @@index([orgId])
  /// "The journeys most users take that no test covers" — ordered by share,
  /// filtered by status. The one read this table exists for.
  @@index([projectId, coverageStatus, sessionShare])
  @@index([ingestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// The wall at the edge of the map (§ coverage)
//
// Five tables, for five sentences that could not be said. Every one of them is
// a whole class of customer whose authenticated surface was reported as small
// when it was actually UNMEASURED:
//
//   · RouteAccessCell      "a member gets 403 on /admin". The security half of
//                          enumeration, which had no denominator at all.
//   · RoleCrawlAttempt     "we could not sign in as admin" — as opposed to
//                          "admin sees nothing extra". Opposite facts, and both
//                          produce zero cells.
//   · EnvironmentAccess    "your coverage is zero because a WAF refuses us",
//                          instead of a confident 100% of nothing.
//   · ReEnumerationTrigger "the denominator is four months old and nothing is
//                          scheduled to refresh it".
//   · SurfaceDriftRecord   "four routes appeared and none has a test" — the one
//                          number anyone acts on, which nothing computed.
// ─────────────────────────────────────────────────────────────────────────────

/// One cell of the route x role access matrix: what one identity got when it
/// asked for one route, durably, so it can be queried.
///
/// ── Why a table and not `FlowNode.access` alone ──────────────────────────────
///
/// `FlowNode.access` holds the same fact in the serialised graph, and that is
/// the right place for the crawl to assemble it. It is the wrong place to ask
/// the question from: "every route an authenticated member is forbidden from,
/// across this environment" is a filter and an order over tens of thousands of
/// cells, and against a JSON blob it means deserialising every map version to
/// find out. A security answer that cannot be indexed is an answer nobody runs.
///
/// ── The honesty rules this table enforces ───────────────────────────────────
///
///   · `outcome` HAS NO DEFAULT. A default of ALLOWED would be the lie; a
///     default of NOT_PROBED would let a real probe's result be dropped by a
///     buggy writer and read as "we did not ask", which hides the bug. With no
///     default the insert fails and somebody finds out.
///   · `status` is NULL and never 0. Zero is not an HTTP status; it is what a
///     null becomes when somebody reaches for a non-null column.
///   · `basis` DECLARED means a source said so and nothing asked. It is not a
///     measurement — `isRouteAccessMeasured` requires OBSERVED — because a
///     declared restriction the application does not enforce is the defect
///     itself.
model RouteAccessCell {
  id             String             @id @default(cuid())
  orgId          String
  projectId      String
  environmentId  String
  /// The normalised route template, spelled exactly as the surface registry
  /// spells the identity half of `CoverageItem.key` — `/orders/:id`, not a
  /// concrete URL. A second spelling of the same route would make the
  /// authorization axis unjoinable to the denominator it is supposed to be an
  /// axis of.
  routeTemplate  String
  /// The role, or the reserved `<anonymous>` spelling for a logged-out visitor.
  ///
  /// NOT NULL, and `roleKey()` in packages/shared/src/auth-profiles.ts is the
  /// only writer. A nullable role would break the unique index below in the
  /// quietest possible way: PostgreSQL treats every NULL as distinct, so the
  /// one cell that matters most — what a logged-out visitor gets on /admin —
  /// would be re-inserted on every crawl and counted once per crawl. The angle
  /// brackets are what make the sentinel safe; no role system spells an
  /// identifier that way.
  role           String
  /// What happened. See the enum: NOT_PROBED is the honesty value, ERRORED is
  /// "we asked and learned nothing about authorization".
  outcome        RouteAccessOutcome
  /// Whether we asked or a source told us. Default OBSERVED is wrong often
  /// enough to be worth refusing, so there is no default here either.
  basis          RouteAccessBasis
  /// The HTTP status observed. NULL when `basis` is DECLARED or `outcome` is
  /// NOT_PROBED — there is no status to report, and writing 403 there would be
  /// inventing a measurement.
  status         Int?
  /// Where the browser ended up. The only evidence of a SOFT redirect: a
  /// single-page application answers 200 and renders the login form, so the
  /// navigation "succeeded" and `status` alone would read as ALLOWED.
  finalUrl       String?
  /// NULL when nothing asked. A timestamp on an unprobed cell would make it
  /// look measured.
  probedAt       DateTime?
  /// Which identity did the asking, and which attempt produced this. The
  /// second is the link that distinguishes "no cells because the login failed"
  /// from "no cells because the route does not exist" — without it a reader
  /// sees an absence and cannot tell which.
  authProfileId  String?
  attemptId      String?
  /// The registry item this route is, when it could be resolved. NULL is a
  /// DANGLING REFERENCE in our own enumeration and must be reported as one
  /// rather than dropped: a cell about a route we failed to enumerate is
  /// evidence about us.
  coverageItemId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment       Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  authProfile       AuthProfile?      @relation(fields: [authProfileId], references: [id], onDelete: SetNull)
  /// Named `producedByAttempt` and not `attempt`: `scripts/check-wiring.ts`
  /// treats `<relationField>: true` anywhere in the repo as a nested READ of
  /// this model, and `attempt: true` occurs in unrelated selects — so the short
  /// name made an unwired table report "read by runners.ts, written by
  /// nothing", which sends the next person hunting a missing writer when what
  /// is missing is both doors.
  producedByAttempt RoleCrawlAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  coverageItem      CoverageItem?     @relation(fields: [coverageItemId], references: [id], onDelete: SetNull)

  /// One cell per (environment, route, role). The crawl UPSERTS on it, so a
  /// re-crawl replaces the observation instead of appending a second opinion.
  @@unique([environmentId, routeTemplate, role])
  @@index([orgId])
  /// "Everything this role was refused", and "every route nobody has probed as
  /// this role" — the two reads the report is made of.
  @@index([environmentId, role, outcome])
  /// "Every FORBIDDEN cell in the environment", across roles, for the security
  /// section. Small slice of a large table.
  @@index([environmentId, outcome])
  @@index([attemptId])
  @@index([coverageItemId])
}

/// What became of the attempt to enumerate as one role.
///
/// ── The lie this table exists to prevent ────────────────────────────────────
///
/// "The admin crawl found no routes a member cannot see." That is a finding if
/// the admin crawl RAN and a fabrication if the admin login FAILED, and with no
/// record of the attempt the two are indistinguishable, because both produce
/// zero RouteAccessCell rows. `roleHadNoExtraSurface` in
/// packages/shared/src/auth-profiles.ts reads this row and returns NULL rather
/// than answering when the attempt did not succeed.
///
/// ── Why every count here is nullable ────────────────────────────────────────
///
/// Because a failed login has NO count, and 0 is the answer "we got in and
/// found nothing", which is the single most misleading value this table could
/// hold. A PARTIAL crawl may still say it found extra surface — finding a route
/// is positive evidence and a budget cannot take it away — but it can never say
/// it found none, because the routes it did not reach are the ones in question.
model RoleCrawlAttempt {
  id                  String           @id @default(cuid())
  orgId               String
  projectId           String
  environmentId       String
  /// `roleKey()`-spelled, the same as RouteAccessCell.role, so the two join.
  role                String
  /// The identity used. NULL for the anonymous attempt, which needs no profile
  /// and is the one attempt that always can be made.
  authProfileId       String?
  outcome             RoleCrawlOutcome
  /// The safe sentence: what happened, in words a customer can act on. NEVER a
  /// credential, a selector value that embeds one, or a session cookie — this
  /// column is rendered on screen and included in exports.
  detail              String?
  /// What to do about it, when the outcome is ours or theirs to fix. The
  /// difference between a report and an accusation.
  remedy              String?
  /// NULL when `outcome` is NEVER_ATTEMPTED. A timestamp on an attempt that
  /// never happened is the same lie as a status on an unprobed cell.
  attemptedAt         DateTime?
  /// The map this attempt contributed to, when it got that far.
  flowMapId           String?
  /// How much surface this identity reached, and how much of it NO other role
  /// reached. Both NULL unless the crawl ran: see the note above.
  routesReached       Int?
  routesNewToThisRole Int?
  /// THE DISCLOSURE PAIR, named after `FlowMap.truncatedReason` /
  /// `atLeastMoreUrls` because it is the same obligation: a budget that BIT
  /// must be reported as a reason AND as a count, so the report can say "at
  /// least 240 more routes existed for this role" instead of presenting a
  /// truncated crawl as a complete one. Both NULL when nothing was capped;
  /// `cappedBy` set with `atLeastMoreRoutes` null means a cap bit and its size
  /// is unknown, which is still better than silence.
  cappedBy            String?
  atLeastMoreRoutes   Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  authProfile AuthProfile?      @relation(fields: [authProfileId], references: [id], onDelete: SetNull)
  flowMap     FlowMap?          @relation(fields: [flowMapId], references: [id], onDelete: SetNull)
  /// The cells this attempt produced. Zero of them is meaningful ONLY together
  /// with `outcome`, which is the whole point of the table.
  cells       RouteAccessCell[]

  /// The CURRENT state per role per environment, upserted. History lives in
  /// SurfaceDriftRecord; a log here would make "what is the admin situation
  /// right now" a windowed query over a growing table for no benefit.
  @@unique([environmentId, role])
  @@index([orgId])
  /// "Which roles could we not get into" — the first question when a coverage
  /// number looks too small.
  @@index([environmentId, outcome])
  @@index([flowMapId])
}

/// What makes an environment reachable at all: the bot defence in front of it,
/// the legitimate way past, and the headers every request carries.
///
/// ── The defect ──────────────────────────────────────────────────────────────
///
/// An application behind reCAPTCHA, Turnstile or a WAF cannot be logged into by
/// ANY profile kind, and QAAI reported it as an application with nothing in it.
/// A customer whose coverage is zero because their edge refuses us has a
/// completely different problem from one whose tests are bad, and only one of
/// the two is theirs to fix.
///
/// ── Nothing here defeats a challenge ────────────────────────────────────────
///
/// Every `bypassMode` is an action the OWNER of the environment took on their
/// own system: their test keys on their own non-production site, their signed
/// header accepted by their own edge, or their allowlist. There is no solver,
/// no token forger and no replay. When none of the three is configured the
/// honest answer is UNREACHABLE_BEHIND_BOT_PROTECTION with `remedy` set, which
/// is what `reachabilityFromPolicy` returns.
///
/// ── Why 1:1 with Environment and not columns on it ─────────────────────────
///
/// Because an environment with no row has made no claim, and a column set would
/// have to encode that as `provider = NONE` — a positive assertion that nothing
/// is in the way, which is the one thing we must not say on a customer's
/// behalf. The absence of the row is NOT_PROBED.
model EnvironmentAccess {
  id               String                  @id @default(cuid())
  orgId            String
  environmentId    String                  @unique
  provider         BotProtectionProvider   @default(UNKNOWN)
  bypassMode       BotBypassMode           @default(NOT_CONFIGURED)
  /// The header name the customer's edge accepts. Required in spirit when
  /// `bypassMode` is SIGNED_BYPASS_HEADER — `botProtectionSchema` refuses the
  /// combination, because a row claiming a bypass with nothing to send would
  /// read as reachable and then fail on every request.
  bypassHeaderName String?
  /// A `Secret.name` REFERENCE, never the value. A bypass token is a credential
  /// and this row is rendered on an environment settings screen.
  bypassSecretName String?
  /// EnvironmentExtraHeader[] — validated by `environmentExtraHeadersSchema`.
  /// A header that carries a credential by definition (Authorization, Cookie,
  /// X-Api-Key, ...) is REFUSED with an inline value and must name a secret
  /// instead, so the settings screen cannot end up rendering a bearer token.
  ///
  /// NULLABLE WITH NO DEFAULT: null means nobody configured headers, `[]` means
  /// somebody looked and chose none. `[]` as a default would erase a decision.
  extraHeaders     Json?
  reachability     EnvironmentReachability @default(NOT_PROBED)
  /// Why coverage is zero, in the customer's terms, with what to do about it.
  /// Set whenever `reachability` is UNREACHABLE_BEHIND_BOT_PROTECTION — the
  /// state without the sentence is the confident 100%-of-nothing this table
  /// exists to replace.
  remedy           String?
  /// What was actually seen — `cf-mitigated: challenge`, or the selector of the
  /// challenge iframe. Evidence, so "we think a WAF blocked us" is auditable.
  /// NEVER a challenge token: that is a credential.
  observedSignal   String?
  /// NULL while `reachability` is NOT_PROBED.
  observedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// A reason the surface gets enumerated again, and what its last run found.
///
/// ── The defect ──────────────────────────────────────────────────────────────
///
/// The only crawl trigger is a human clicking a button. `Schedule` and `Monitor`
/// both exist and both can only run a SUITE, so nothing re-enumerates on its
/// own: the application grows four routes, the denominator does not, and the
/// coverage percentage RISES. It fails silently and in the flattering
/// direction, which for a product whose whole claim is the denominator is the
/// worst available failure.
///
/// ── Why NEVER_RUN is a stored state ────────────────────────────────────────
///
/// Because the alternative is a null `lastRunAt` that a dashboard renders as a
/// clean bill of health. "This has never run" and "this ran and found no drift"
/// are opposite facts. `triggerHasRun` is the only predicate that separates
/// them, and there is no code path that may skip it.
model ReEnumerationTrigger {
  id                  String                   @id @default(cuid())
  orgId               String
  projectId           String
  environmentId       String
  name                String
  kind                ReEnumerationTriggerKind
  enabled             Boolean                  @default(true)
  /// SCHEDULE only: the cron expression and the zone it is read in. NULL for
  /// every other kind, rather than a `* * * * *` placeholder that a scheduler
  /// would happily obey.
  cron                String?
  timezone            String?
  /// DEPLOY only: a `Secret.name` REFERENCE to the shared secret that
  /// authenticates the inbound webhook. Never the value, and deliberately not
  /// an environment variable — a webhook secret is per-environment customer
  /// data, and one env var would arm one answer for every environment in the
  /// install at once.
  webhookSecretName   String?
  lastRunState        ReEnumerationRunState    @default(NEVER_RUN)
  /// NULL while NEVER_RUN. Together with the state above, this is the pair a
  /// staleness banner reads.
  lastRunAt           DateTime?
  /// The map the last run produced, when it produced one.
  lastFlowMapId       String?
  /// The safe sentence for a FAILED run. Never a credential.
  lastFailureMessage  String?
  /// Consecutive failures since the last success. 0 is honest here — it is a
  /// count of events, not a measurement of the application — and it is what a
  /// "this has been broken for six days" notice reads.
  consecutiveFailures Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  lastFlowMap FlowMap?             @relation(fields: [lastFlowMapId], references: [id], onDelete: SetNull)
  /// Every diff this trigger produced. The latest one is "the drift it found";
  /// a denormalised `lastDriftRecordId` was deliberately not added, because two
  /// pointers at the same fact are two things that can disagree and only one of
  /// them would be on screen.
  drifts      SurfaceDriftRecord[]

  @@unique([environmentId, name])
  @@index([orgId])
  /// "Which triggers are due" and "which have never run" — the scheduler's read
  /// and the staleness banner's read.
  @@index([environmentId, kind, enabled])
  @@index([lastFlowMapId])
}

/// What changed between two crawls of one environment.
///
/// ── The defect ──────────────────────────────────────────────────────────────
///
/// `FlowMap.version` has existed since the beginning and the cockpit implies
/// versions are diffed. NO DIFF CODE EXISTS anywhere in the repo, so four new
/// routes with zero tests produce no event at all — a doc comment and a screen
/// both claiming a computation that was never written.
///
/// ── UNCOMPARABLE is not "no drift" ─────────────────────────────────────────
///
/// Every count below is NULLABLE, and that is the entire design. Zero is the
/// value that means "nothing new is untested"; it is what a dashboard renders
/// as a green tick; and once written it is indistinguishable from "we never
/// looked". So a diff with no baseline, a diff against a degraded crawl, and a
/// diff that did not run all store NULL and report their reason
/// (`driftCountsAreMeaningful`, `newSurfaceWithoutTests`).
model SurfaceDriftRecord {
  id                     String                    @id @default(cuid())
  orgId                  String
  projectId              String
  environmentId          String
  /// The map being compared, and what it was compared against. The baseline is
  /// NULL for UNCOMPARABLE_NO_BASELINE — the first crawl of an environment, in
  /// which every route is "new", which is true and useless.
  currentFlowMapId       String
  baselineFlowMapId      String?
  comparability          SurfaceDriftComparability
  /// The counts. All NULL unless `comparability` is COMPARABLE.
  routesAdded            Int?
  routesRemoved          Int?
  routesChanged          Int?
  controlsAdded          Int?
  controlsRemoved        Int?
  /// THE NUMBER ANYONE ACTS ON: new surface with no test against it. Read
  /// through `newSurfaceWithoutTests`, which returns null rather than this
  /// column whenever the comparison was not a comparison — including when a
  /// writer claims COMPARABLE and leaves this null, because that row is a bug
  /// and reporting it as 0 would hide the bug behind a green tick.
  newSurfaceWithoutTests Int?
  /// The named lists — which route templates were added, removed and changed,
  /// and which controls. The part a customer forwards; a bare count of four is
  /// not actionable and is not checkable either.
  ///
  /// NULLABLE WITH NO DEFAULT for the same reason as the counts: `{}` would
  /// claim an empty diff was computed.
  detail                 Json?
  /// Which trigger produced it. NULL for a diff somebody asked for by hand.
  triggerId              String?
  /// NULL when `comparability` is NOT_COMPARED. A timestamp on a comparison
  /// that did not run is how "no drift since the last crawl" gets claimed by a
  /// code path that never looked.
  comparedAt             DateTime?
  createdAt              DateTime                  @default(now())

  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment       Environment           @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  currentFlowMap    FlowMap               @relation("SurfaceDriftCurrent", fields: [currentFlowMapId], references: [id], onDelete: Cascade)
  baselineFlowMap   FlowMap?              @relation("SurfaceDriftBaseline", fields: [baselineFlowMapId], references: [id], onDelete: SetNull)
  /// `producedByTrigger` for the same reason as
  /// RouteAccessCell.producedByAttempt: `trigger: true` appears in unrelated
  /// selects, and a false "this model has a reader" signal is the wrong
  /// remediation on the one check that exists to notice an unwired table.
  producedByTrigger ReEnumerationTrigger? @relation(fields: [triggerId], references: [id], onDelete: SetNull)

  @@index([orgId])
  /// "What changed, most recent first" — the drift feed. `comparedAt` is
  /// nullable and a btree indexes nulls, so a NOT_COMPARED row still sorts.
  @@index([environmentId, comparedAt])
  @@index([currentFlowMapId])
  @@index([baselineFlowMapId])
  @@index([triggerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Measurement: the ladder, the provenance edges, the per-variant evidence,
// the metric channel, suite-health history, and the scope its owner declares
//
// ── WHAT WAS WRONG, AND WHY ALL OF IT IS ONE ROUND ──────────────────────────
//
// The ENUMERATE slices built the denominator. Nothing built the measurement.
// Concretely, and every one of these is a lie inside the only sentence this
// company has:
//
//   1. "COVERED" WAS A BOOLEAN MEANING "SOME TEST MENTIONS IT". There was no
//      requirement that the test ASSERTS anything, that it PASSED, that it RAN,
//      or that it is not quarantined — so a test that always fails closed a gap
//      while every gate in the product excluded it from every rule.
//      "CoverageTier" is the ladder that separates those five situations.
//   2. THE NUMERATOR LINK WAS A REGEX RECOMPUTED PER REQUEST, with no identity
//      and no history, so coverage could not FALL when a test was deleted or
//      quarantined. The number was structurally incapable of going down for the
//      most common reason it should. "TestCoverageEdge" is that identity.
//   3. "TestResult" IS UNIQUE ON (runId, testId) AND REDUCES WORST-WINS, so
//      "passes in Chromium, fails in WebKit" stored as "failed", and the
//      DEVICE_LOCALE and ROLE_CELL axes of the denominator had no per-variant
//      evidence to rest on at all. "TestResultVariant" is that evidence, and
//      the roll-up is UNCHANGED — this is additional, not a replacement.
//   4. EVERY NUMBER A PLUGIN PRODUCES SURVIVED ONLY AS PROSE INSIDE A STEP
//      TITLE. The mutation score got five columns last round because it is the
//      metric no competitor ships; LCP, CLS, INP, k6's p95 and the visual diff
//      ratio did not, so `MAX_VITAL_BREACHES` and `MAX_P95_LATENCY_MS` are
//      saveable gate rules with no stored number to read. "TestMetricSample" is
//      the open channel.
//   5. "Test"."flakeRate" IS OVERWRITTEN ON EVERY RUN and the health score is
//      recomputed per request, so rot has no DIRECTION — the premise of the
//      whole suite-health lens was unmeasurable. "TestFlakeHistory" fixed the
//      per-test half and cannot fix this one: weak assertions, duplicates and
//      obsolete tests are properties of the SUITE, not aggregates of per-test
//      flake. "SuiteHealthSnapshot" is the trend.
//   6. RISK RANKING IS AN ENGLISH MONEY-WORD REGEX, `\b`-bounded, so `/pay_now`
//      and `/checkoutConfirm` both miss — and a code comment invited the
//      customer to "tell us so" with nowhere in the product to do it.
//      "Project"."coverageConfig" is that somewhere.
//
// ── THE HONESTY RULES THIS DDL ENCODES ──────────────────────────────────────
//
//   · "TestCoverageEdge"."tier" AND ."source" HAVE NO DEFAULT. A default tier
//     of DECLARED would mint a claim nothing produced; a default source would
//     let a writer's bug read as a regex match. With no default the INSERT
//     fails and somebody finds out.
//   · EVERY MEASUREMENT ON "SuiteHealthSnapshot" IS NULLABLE AND NONE DEFAULTS
//     TO 0. `weakAssertions: 0` means we scanned every test and found none —
//     the best possible result — and writing it for a scan that never ran is
//     the most flattering lie this product could tell about itself. Same rule
//     as "SurfaceDriftRecord"'s six counts and "TestResult"."mutationScore".
//   · "TestMetricSample"."value" IS NULLABLE AND CARRIES A REQUIRED REASON WHEN
//     NULL. An LCP of 0 ms is a page that painted instantly; a p95 of 0 is a
//     load test that never ran.
//   · EVERY DIMENSION OF A VARIANT KEY IS NOT NULL, with '<unvaried>' and
//     '<anonymous>' as the sentinels. A nullable dimension would break the
//     unique index in the quietest possible way — PostgreSQL treats every NULL
//     as distinct, so the default cell, which is the one almost every test runs
//     in, would re-insert on every run and be counted once per run. This is
//     the same defect "RouteAccessCell"."role" records, and it is repeated here
//     because it is repeatable.
//   · "Project"."coverageConfig" IS NULLABLE WITH NO DEFAULT. `{}` would claim
//     a customer had reviewed their scope and declared nothing out of it.
// ─────────────────────────────────────────────────────────────────────────────

/// The coverage ladder. See packages/shared/src/coverage-tiers.ts, which owns
/// the rank, the per-source ceiling and the promotion rule.
///
/// MONOTONIC: every rung implies the ones below it, which is what lets a report
/// say "34% passing, 61% navigated" as two readings of one measurement. It also
/// forces the thing that matters commercially — ASSERTED sits above NAVIGATED,
/// so asserting implies having been reached, so STATIC extraction can never
/// exceed DECLARED no matter how confidently a regex spots an `expect()`.
enum CoverageTier {
  DECLARED
  NAVIGATED
  ASSERTED
  PASSING
  FRESH
}

/// How a test came to be linked to a surface item.
///
/// RUNTIME OUTRANKS SPEC OUTRANKS STATIC when two disagree: one is a record of
/// what a browser did, one is a person or a generator stating an intention, one
/// is a regular expression's opinion about a string in a file.
enum CoverageEdgeSource {
  STATIC
  SPEC
  RUNTIME
}

/// What a metric's number is measured in.
///
/// A closed list of UNITS and a free-form metric NAME, which is the split that
/// lets a plugin that does not exist yet record a reading without a migration
/// while keeping the value comparable and renderable. A unitless reading is
/// RATIO or SCORE, never an absent unit — a bare number beside numbers that
/// have units is the thing a reader misreads.
enum MetricUnit {
  MILLISECONDS
  SECONDS
  BYTES
  COUNT
  PERCENT
  RATIO
  SCORE
  REQUESTS_PER_SECOND
  PIXELS
}

/// Which way is better. Stored per sample and never looked up from a table of
/// known metric names: the channel is open, and a lookup would default an
/// unknown metric to one direction and gate the wrong way.
enum MetricDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

/// One test → surface-item provenance edge: the NUMERATOR, with an identity.
///
/// ── WHY A ROW AND NOT A RECOMPUTED MATCH ────────────────────────────────────
///
/// `CoverageItem.matches` is a Json blob of `SurfaceMatch[]` rewritten wholesale
/// on every analysis, and before that the link was a regex run per request. Both
/// have the same fatal property: the link has no identity, so it cannot be
/// observed to DISAPPEAR. A test deleted, renamed, disabled or quarantined does
/// not lower coverage — the match simply stops being derived, and an item that
/// was covered yesterday becomes indistinguishable from one never covered at
/// all. A coverage number that cannot fall for the most common reason it should
/// is not a measurement.
///
/// `matches` stays. It is what the cockpit renders today and every reader of it
/// keeps working; this table is the durable, diffable, per-source truth beneath
/// it, exactly as `TestFlakeHistory` sits beneath `Test.flakeRate`.
///
/// ── WHY THE UNIQUE KEY INCLUDES `source` ────────────────────────────────────
///
/// So that a STATIC edge and a RUNTIME edge for the same (test, item) can
/// COEXIST AND DISAGREE. That disagreement is a finding, not a conflict to be
/// resolved on write: a regex that claims a test covers /checkout beside a run
/// that never reached /checkout is how you discover a test that mentions a route
/// it never visits. `resolveCoverageEdges` ranks them at read time and reports
/// `conflicting`.
model TestCoverageEdge {
  id        String @id @default(cuid())
  orgId     String
  projectId String
  testId    String
  itemId    String

  /// NO DEFAULT on either. See the section header: a defaulted tier mints a
  /// claim nothing produced, and a defaulted source lets a writer's bug read as
  /// a regex match.
  source CoverageEdgeSource
  tier   CoverageTier

  /// Why `tier` is not higher. TEXT and not an enum, the same judgement as
  /// `MutationSurvivor.reason` and `CoverageItem.unexercisableReason`: the
  /// domain is `TIER_CAP_REASONS`, enforced at the producer by
  /// `tierCapReasonSchema`, and nothing filters rows on it — so an enum here
  /// would be this round's FIFTH new Postgres type, added purely so that it
  /// could need a drift guard of its own.
  ///
  /// NULL means nothing capped it, which is the honest reading for a FRESH edge:
  /// there is no rung above it to be held back from.
  cappedBy String?

  /// 0-1, with a CEILING PER SOURCE enforced by `testCoverageEdgeSchema`:
  /// STATIC 0.8, SPEC 0.95, RUNTIME 1. Same pattern and same reason as
  /// `LINK_METHOD_CONFIDENCE_CEILING` — a regex able to write 1 is a regex whose
  /// guess reads on screen as certainty.
  confidence Float
  /// The sentence that justifies the edge, in the customer's terms. Same
  /// contract as `CoverageItem.evidence`: this is what makes the NUMERATOR
  /// auditable rather than asserted, which until now only the denominator was.
  evidence   String

  /// The run that last confirmed it. NULL is only legitimate for a DECLARED
  /// edge — `testCoverageEdgeSchema` refuses a higher tier without one, because
  /// a tier claiming an observation with no run to point at is the one thing a
  /// provenance edge may not be.
  lastConfirmedRunId String?
  lastConfirmedAt    DateTime?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  /// Set when the producer stops finding it, rather than deleting the row —
  /// same argument as `CoverageItem.retiredAt`, and here it is the entire
  /// point: a retired edge is how coverage GOES DOWN with an audit trail,
  /// instead of a number quietly shrinking with nothing to explain it.
  retiredAt   DateTime?

  test Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  item CoverageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// One edge per (item, test, source). The constraint IS the coexistence rule
  /// above, and it is what makes a producer's upsert idempotent.
  ///
  /// Prisma's derived name is used, deliberately. It is 41 bytes, comfortably
  /// inside PostgreSQL's 63-byte identifier limit, so a `map:` here would be
  /// decoration — and a hand-named constraint that did not NEED naming makes
  /// the one below look like a style choice rather than the requirement it is.
  @@unique([itemId, testId, source])
  @@index([orgId])
  /// "Every edge on this item, strongest first" — the read behind every tier.
  @@index([itemId, tier])
  /// "What does this test cover?" — the read behind a test detail page, and the
  /// one the deletion path makes before coverage is allowed to fall.
  @@index([testId])
  /// The live denominator's own query: "every un-retired edge in this project".
  @@index([projectId, retiredAt])
}

/// One cell of the matrix a test actually ran in: browser x viewport x locale x
/// role x environment.
///
/// ── WHAT THIS DOES NOT CHANGE ───────────────────────────────────────────────
///
/// "TestResult" KEEPS ITS (runId, testId) UNIQUE CONSTRAINT AND ITS WORST-WINS
/// ROLL-UP, untouched, and this migration adds NO COLUMN to it. Every existing
/// reader of `TestResult.status` keeps the contract it was written against.
/// This table is evidence underneath that contract: a reader asking "did it
/// pass?" wants the roll-up, a reader asking "where did it pass?" wants these
/// rows, and reconciling the two by overwriting either one is how a matrix
/// becomes a single wrong answer.
///
/// A run with no variation writes NO ROWS HERE. Absent means "this execution
/// was not varied"; one synthetic row duplicating the roll-up would make an
/// unvaried run indistinguishable from a deliberate one-browser matrix.
model TestResultVariant {
  id           String @id @default(cuid())
  orgId        String
  testResultId String
  /// Denormalised from the parent so the two reads this table exists for —
  /// "this run's WebKit failures" and "this test's de-DE history" — do not have
  /// to join through "TestResult" to filter. Copied on insert and never
  /// updated; the parent is immutable once written.
  runId        String
  testId       String

  /// THE FIVE DIMENSIONS. ALL NOT NULL. See the section header for why a
  /// nullable dimension would silently count the default cell once per run.
  /// '<unvaried>' means nobody varied this dimension; on `role`, '<anonymous>'
  /// additionally means "ran as a logged-out visitor", which is a real answer
  /// and not a missing one.
  browser     String
  viewport    String
  locale      String
  role        String
  /// The environment id this cell ran against, or '<unvaried>'. TEXT rather
  /// than a foreign key: an environment is deletable and the evidence of what
  /// was measured where must outlive it, which is the same argument
  /// `CoverageItem.environmentId` records.
  environment String

  status           TestResultStatus
  durationMs       Int              @default(0)
  errorMessage     String?
  /// §5 — a retry that passes is not a pass, per cell as well as per test.
  retriedAndPassed Boolean          @default(false)
  /// Why this cell measured nothing. NULL IS A FIFTH STATE AND IT IS NOT
  /// NOT_RUN — identical contract to `TestResult.notRunKind`, including that
  /// defaulting it would put a claim in the database that nothing produced.
  notRunKind       NotRunKind?

  /// THE RESOLVED CELL, in full.
  ///
  /// The five TEXT dimensions above cannot express a browser CHANNEL, a device
  /// scale factor, a colour scheme, a reduced-motion preference or a
  /// forced-colors mode — and those are precisely the axes a widened matrix
  /// varies. `variantBrowserKey` and `variantViewportKey` in
  /// packages/shared/src/browser-matrix.ts pack what fits into `browser` and
  /// `viewport`, which stay the IDENTITY and keep the six-column unique index
  /// doing its job; this column is the detail behind that identity.
  ///
  /// Json and not twelve columns, on the same judgement `TestMetricSample`
  /// records: the axis set is open — a cell kind nobody has thought of yet is a
  /// migration per axis — and nothing filters rows on a cell's interior. The
  /// reads are "this run's failures by cell" and "this test's history in this
  /// cell", and both go through the indexed TEXT keys.
  ///
  /// NULL means the run was not varied, matching the table's own rule that an
  /// unvaried execution writes no rows here at all.
  matrixCell        Json?
  /// WHETHER THIS DEPLOYMENT COULD RUN THIS CELL — the cell-level twin of
  /// `DeploymentCapability.status`, and a different question from it.
  ///
  /// ── The defect ─────────────────────────────────────────────────────────────
  ///
  /// `notRunKind.UNSUPPORTED` answers "this deployment cannot execute this TEST
  /// TYPE". It cannot answer "chromium ran and chrome-beta is not installed", so
  /// a four-cell matrix with one unavailable channel recorded three real results
  /// and one SKIPPED — indistinguishable from a placeholder nobody reached. A
  /// matrix percentage then included a cell that can never fail.
  ///
  /// Six values where the type-level enum has four, because a CELL has two more
  /// ways to fail and neither is an install: UNSUPPORTED_COMBINATION (no build
  /// of that engine has that channel — there is no Firefox beta) and
  /// NEEDS_BROWSER_GRID (a released consumer version, which only a hosted grid
  /// can serve; Playwright's webkit is not Safari). Collapsing either into
  /// MISSING sends a reader to install something that was never published.
  ///
  /// NULLABLE WITH NO DEFAULT, exactly like `notRunKind`: null means nobody
  /// recorded a cell status, which is the honest reading of every row written
  /// before this column existed and of any writer that made no claim. Defaulting
  /// it to AVAILABLE would assert that every historical cell ran.
  cellStatus        MatrixCellStatus?
  /// What a human needs in order to fix it. Required beside MISSING,
  /// WRONG_VERSION, UNSUPPORTED_COMBINATION and NEEDS_BROWSER_GRID — four
  /// different next actions — and refused beside NOT_CHECKED, because there is
  /// no remedy for a question nobody asked. Enforced by
  /// `testResultVariantCellSchema`.
  ///
  /// NEVER A CREDENTIAL. This string is rendered in the run report and the
  /// matrix view, so a remedy that embedded a token, a cookie or a storageState
  /// value would be publishing it. Truncated and hashed both count as leaks.
  cellRemedy        String?
  /// WHAT THIS CELL DID NOT ASSERT.
  ///
  /// ── The headline defect of the round ───────────────────────────────────────
  ///
  /// CHECKOUT COULD BE CLICKED THROUGH AND THE MONEY PATH COULD NOT BE ASSERTED:
  /// no 3DS, no decline, no insufficient funds, no webhook transition, no
  /// refund, no partial capture — and the result of clicking through it was a
  /// PASS. The same shape runs through every new type: a PWA result with no
  /// service worker reached, a PUSH result with no transport, a DOCUMENT result
  /// that downloaded a file and asserted nothing about its bytes. Every one of
  /// them was a green row.
  ///
  /// So a pass with a non-empty `notAsserted` is a pass WITH A STATED HOLE IN
  /// IT, and the gate can refuse to count it. A pass with nothing recorded is
  /// the lie.
  ///
  /// `String[] @default([])`, and the empty default is honest here where it
  /// would not be on a count: `[]` is the claim that this cell made every
  /// assertion it was supposed to, which is exactly what a passing E2E cell is
  /// claiming. There is no fourth state between "asserted everything" and "named
  /// what it did not".
  notAsserted       String[]          @default([])
  /// WHY, as a groupable value.
  ///
  /// The one question that makes the column above useful is "how often, across
  /// this project, did we fail to assert the webhook transition" — and that is a
  /// GROUP BY, not a regex over a sentence. The same argument the migration that
  /// moved the mutation score out of a Step TITLE makes at length.
  ///
  /// Required exactly when `notAsserted` is non-empty, enforced by
  /// `testResultVariantCellSchema`: a hole with no reason cannot tell a missing
  /// binary (a Dockerfile line) from a feature nobody has built (a roadmap item),
  /// and a report that merged them would send a customer to install something
  /// that does not exist.
  notAssertedReason UnassertedReason?

  createdAt DateTime @default(now())

  testResult TestResult         @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  metrics    TestMetricSample[]

  /// "How many of this run's cells did we refuse, and for which of the six
  /// reasons" -- the one read that makes `cellStatus` a GROUP BY instead of a
  /// regex over a sentence, and therefore the one thing standing between a
  /// matrix percentage and a percentage with cells in it that cannot run.
  ///
  /// Added alongside `[runId, status]` rather than widened into it: that index
  /// serves "this run's failures by cell" and is the matrix view's own query, and
  /// a three-column index is not the same read.
  ///
  /// NO INDEX FOR `notAssertedReason` yet, and the omission is deliberate rather
  /// than forgotten. The rollup it wants is project-wide, this table has no
  /// `projectId`, and a speculative index on a column whose reader does not
  /// exist is dead weight on the largest evidence table in the product. The
  /// per-run question is answered through this same index plus a filter. Add the
  /// project-wide one with the surface that asks it.
  @@index([runId, cellStatus])
  /// The cell's identity. THE ONE CONSTRAINT IN THIS ROUND THAT MUST BE NAMED
  /// EXPLICITLY: Prisma's derived name for a six-column unique is
  /// "TestResultVariant_testResultId_browser_viewport_locale_role_environment_key",
  /// which is 75 bytes, and PostgreSQL TRUNCATES at 63 SILENTLY. A truncated
  /// name is one Prisma's introspection disagrees with for ever — an earlier
  /// round paid for exactly that with permanent phantom drift on every
  /// `migrate dev`. The two other uniques in this round are left to Prisma
  /// because they fit.
  @@unique([testResultId, browser, viewport, locale, role, environment], map: "TestResultVariant_cell_key")
  @@index([orgId])
  /// "This run's failures, by cell" — the matrix view's own query.
  @@index([runId, status])
  /// "Where has this test passed over time?" — the per-cell trend.
  @@index([testId, createdAt])
  @@index([testResultId])
}

/// One numeric reading, from one plugin, about one test — or one cell of it.
///
/// ── WHY A ROW PER READING AND NOT MORE COLUMNS ON "TestResult" ──────────────
///
/// The mutation score got five scalar columns last round, correctly: it is ONE
/// known metric with a known denominator and the `(testId, createdAt)` index
/// already answers its trend from the index alone. This is the opposite problem.
/// The channel is OPEN — LCP, CLS, INP, k6's p95 and error rate, a visual diff
/// ratio, and whatever a plugin nobody has written yet measures — so a column
/// per metric is a migration per metric, and a Json blob would make every trend
/// query a sequential scan plus a per-row parse and would let a writer put a
/// string where the number goes.
///
/// Adding this table adds NO COLUMN to "TestResult", which is the largest table
/// in the product.
model TestMetricSample {
  id           String  @id @default(cuid())
  orgId        String
  projectId    String
  runId        String
  testId       String
  testResultId String
  /// The cell this reading belongs to, when it belongs to one. NULL for a
  /// reading about the whole test; `variantKey` below carries the sentinel so
  /// the unique index still holds — see the note there.
  variantId    String?

  /// The metric's identity in the plugin's own spelling: `lcp`,
  /// `http_req_duration_p95`, `visual_diff_ratio`. Validated as an identifier
  /// by `testMetricSchema` because it is the key a trend query GROUPs on, and a
  /// sentence cannot be grouped on. Never derived from a step title.
  name String

  /// THE NUMBER, OR NULL FOR "WE TRIED AND COULD NOT MEASURE IT".
  ///
  /// Not zero. An LCP of 0 ms is a page that painted instantly, a p95 of 0 is a
  /// load test that never ran, a visual diff ratio of 0 is a pixel-perfect
  /// match — a product that writes 0 for "not measured" reports its own blind
  /// spots as its best results. Same three-state contract as
  /// `TestResult.mutationScore`.
  value             Float?
  /// Required exactly when `value` is NULL, enforced by `testMetricSchema`. A
  /// null with no reason is indistinguishable from a writer's bug and will be
  /// read as zero by the first consumer that forgets to check.
  unavailableReason String?
  unit              MetricUnit
  direction         MetricDirection

  /// The cell this reading came from, as TEXT, with '<unvaried>' for a
  /// whole-test reading.
  ///
  /// IT IS DELIBERATELY BOTH THIS AND `variantId`. The id is the join; this is
  /// the identity, and it is NOT NULL so that the unique index below actually
  /// constrains the common case. A unique over a nullable `variantId` would
  /// treat every whole-test reading as distinct — PostgreSQL's NULLs again —
  /// and the same metric would be inserted once per run for ever.
  variantKey String

  createdAt DateTime @default(now())

  testResult TestResult         @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  variant    TestResultVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// One reading per metric per cell per result. The producer's upsert key.
  /// Prisma's derived name is 49 bytes — inside the limit, so no `map:`.
  @@unique([testResultId, variantKey, name])
  @@index([orgId])
  /// THE TREND QUERY, and the reason this table exists: "this project's `lcp`
  /// over time". Without it every trend is a sequential scan of every reading
  /// the install has ever taken.
  @@index([projectId, name, createdAt])
  /// "This test's readings for one metric" — the per-test trend.
  @@index([testId, name, createdAt])
  /// "Everything this run measured" — the run report's own read.
  @@index([runId])
  @@index([variantId])
}

/// A stored suite-health reading, so rot has a direction.
///
/// ── WHY "TestFlakeHistory" DOES NOT COVER THIS ──────────────────────────────
///
/// That table is one row per TEST per UTC day and it correctly fixed the
/// per-test half. The suite-level numbers are not aggregates of it, and not for
/// want of a GROUP BY: weak assertions, near-duplicates, obsolete tests and the
/// quarantine budget are properties of the SUITE, computed by
/// packages/agent/src/suite-health.ts from test SOURCE. Nothing has ever stored
/// one of them, so "is this suite getting worse?" — the premise of the entire
/// suite-health lens — had no answer.
///
/// ── ONE ROW PER MEASUREMENT, NOT PER DAY ───────────────────────────────────
///
/// Unlike "TestFlakeHistory", which aggregates per day because its write volume
/// is tests x runs. This is one row per SUITE per measurement: an hourly schedule
/// writes 24 rows a day for a project regardless of suite size, which is three
/// orders of magnitude less than the per-test table it sits beside. Aggregating
/// it per day would throw away exactly the intra-day resolution that table had
/// to give up, for no saving worth having.
model SuiteHealthSnapshot {
  id        String  @id @default(cuid())
  orgId     String
  projectId String
  commitSha String?
  /// The run the pass-rate and duration halves were taken from. NULL for a
  /// source-only scan, which measures the other six and honestly reports NULL
  /// for these two rather than 0.
  runId     String?

  /// EVERY ONE OF THESE IS NULLABLE AND NONE HAS A DEFAULT. 0 is a measurement
  /// — "we scanned every test and found none" — and it is the BEST possible
  /// result for five of them. A snapshot whose scan never ran, or was truncated
  /// by a budget, or could not parse the dialect, has no number. See the
  /// section header; this is the rule the whole table turns on.
  testCount          Int?
  quarantinedCount   Int?
  flakyCount         Int?
  weakAssertionCount Int?
  duplicateCount     Int?
  obsoleteCount      Int?
  passRatePercent    Float?
  medianDurationMs   Int?
  p95DurationMs      Int?
  /// The composite, 0-100. NULL WHEN NOT COMPUTED: a 0 would read as a suite
  /// with no value whatsoever, which is the opposite of "we did not score it".
  /// Stored beside its inputs because a composite nobody can decompose is a
  /// number nobody can argue with, which is the same as one nobody believes.
  score              Float?

  /// Every cap that BIT, as a sentence — a scan budget, a file take, a dialect
  /// the parser could not read. Defaulted to `[]` here and nowhere among the
  /// counts above, and the difference is exact: an empty caveat list is a
  /// positive claim that nothing was truncated, which is the ordinary and
  /// verifiable case, whereas an empty count would be a claim about the
  /// customer's suite.
  caveats     Json     @default("[]")
  /// Changes whenever the answer could change, so an unchanged score and an
  /// unchanged measurement are distinguishable.
  fingerprint String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId])
  /// The trend, which is the only reason the table exists.
  @@index([projectId, createdAt])
  @@index([projectId, commitSha])
}
