# QAAI deployment configuration.
#
#   cp deploy/.env.example .env      # compose reads .env from the repo root
#
# Then fill in the five REQUIRED secrets below. Every one of them is blank on
# purpose and there is no default anywhere in docker-compose.yml: `docker
# compose up` fails with a named error until you generate real values.
#
# That is not friction for its own sake. A default committed to a public repo is
# not a default, it is a published credential — and for VAULT_MASTER_KEY it is
# the key that decrypts every stored customer secret in every install that ever
# copied it. A stack that refuses to boot is recoverable in thirty seconds. A
# stack that booted with a key from GitHub is not recoverable at all.
#
# Generate all five at once:
#
#   {
#     echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
#     echo "MINIO_ROOT_USER=qaai-$(openssl rand -hex 4)"
#     echo "MINIO_ROOT_PASSWORD=$(openssl rand -hex 24)"
#     echo "SESSION_SECRET=$(openssl rand -base64 48)"
#     echo "VAULT_MASTER_KEY=$(openssl rand -base64 32)"
#   } >> .env
#
# This file must never contain a real value. Keep .env out of version control
# (the root .gitignore already ignores it) and out of images (.dockerignore
# already excludes it).

# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED SECRETS — all blank; the stack will not start until they are set.
# ═════════════════════════════════════════════════════════════════════════════

# Postgres superuser password for the bundled database.
# Generate:  openssl rand -hex 24
# Hex on purpose: it is embedded in a postgresql:// URL, so it must not contain
# characters that need percent-encoding (@ : / ? # are all fatal there).
POSTGRES_PASSWORD=

# MinIO (S3-compatible artifact storage) root credentials. These double as
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY for the API and worker.
# Generate:  MINIO_ROOT_USER=qaai-$(openssl rand -hex 4)
#            MINIO_ROOT_PASSWORD=$(openssl rand -hex 24)
# MinIO rejects a root password shorter than 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Signs session cookies. Rotating it logs everybody out — that is the whole
# blast radius, so rotate freely if you suspect exposure.
# Generate:  openssl rand -base64 48
# Rejected at boot if shorter than 32 characters (apps/api/src/env.ts).
SESSION_SECRET=

# ── VAULT_MASTER_KEY — the one to get right ─────────────────────────────────
# AES-256-GCM master key for the secrets vault: every credential a customer
# stores (their app logins, integration tokens, the GitHub App private key) is
# sealed with this. It is not a session secret. Rotating it does not log people
# out, it makes every sealed secret in the database permanently unreadable, so
# treat it as backup-critical: store it in your password manager or KMS *before*
# the first boot, and back it up alongside — never inside — the database dump.
#
# Generate:  openssl rand -base64 32
#
# Must decode to exactly 32 bytes. apps/api/src/env.ts checks this at boot and
# exits non-zero otherwise, so a truncated or placeholder value fails fast
# rather than surfacing as a decryption error weeks later. Verified: the old
# placeholder string decodes to 28 bytes and is rejected.
#
# In production, prefer injecting this from KMS/Secrets Manager at run time over
# storing it in a file on disk.
VAULT_MASTER_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# OPTIONAL — every value below is safe to leave as-is.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Where browsers reach the stack ─────────────────────────────────────────
# NEXT_PUBLIC_API_URL is compiled into the cockpit's JS bundle at image build
# time, so changing it requires `docker compose build web`, not just a restart.
# Behind a domain, set both to the public URL:
#   NEXT_PUBLIC_API_URL=https://qaai.example.com/api
#   WEB_PUBLIC_URL=https://qaai.example.com
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Host interface the published ports bind to. 127.0.0.1 keeps the stack on this
# machine. Set to 0.0.0.0 only behind a reverse proxy that terminates TLS —
# these services expect to sit behind one and do not serve HTTPS themselves.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
DEMO_BIND=127.0.0.1

# ─── The front door (TLS) ───────────────────────────────────────────────────
# Only read by deploy/docker-compose.tls.yml (the Caddy override); a plain
# `docker compose up` ignores it. Set it to the DNS name that points at this
# host and Caddy obtains and renews the certificate on its own. Remember the
# companion settings above: NEXT_PUBLIC_API_URL=https://<domain>/api and
# WEB_PUBLIC_URL=https://<domain>, then `docker compose build web`.
QAAI_DOMAIN=

# ─── Runtime tuning ─────────────────────────────────────────────────────────
LOG_LEVEL=info
# Parallel test runs per worker container. Each one drives a Chromium instance,
# so this is bounded by RAM (budget ~500MB per slot), not CPU.
WORKER_CONCURRENCY=4
# The worker container's memory ceiling. Sized as ~500MB × WORKER_CONCURRENCY
# plus the 1GB /dev/shm (tmpfs counts against the same cgroup); raise or lower
# the two together. WORKER_CONCURRENCY=2 fits in 2g.
WORKER_MEM_LIMIT=4g

# ─── Artifact storage ───────────────────────────────────────────────────────
S3_BUCKET=qaai-artifacts
S3_REGION=us-east-1
# true writes screenshots/videos/traces to the qaai-artifacts docker volume
# instead of MinIO. Useful for a single-node install; the API and worker share
# the volume so both see the same files.
ARTIFACTS_LOCAL=false

# ─── LLM ────────────────────────────────────────────────────────────────────
# Optional. Without it the LLM-backed features (generation, triage) degrade
# rather than crash; runs of already-generated suites work fine.
ANTHROPIC_API_KEY=
QAAI_MODEL_CHEAP=claude-haiku-4-5
QAAI_MODEL_STRONG=claude-opus-5
# Hard ceiling per org per calendar month. 0 disables the check.
QAAI_MONTHLY_TOKEN_BUDGET=0

# ─── Demo store ─────────────────────────────────────────────────────────────
# Flips the planted checkout bug the onboarding walkthrough finds.
DEMO_PLANTED_BUG=true

# ─── Billing (optional; blank means "not purchasable online") ───────────────
# A self-hosted install normally leaves all four blank and manages plans by
# hand. Set them only if this deployment sells subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# ─── GitHub (optional) ──────────────────────────────────────────────────────
# The App puts check runs on the merge box. Without it, pull-request feedback
# still arrives as a comment through the personal-access-token integration —
# nothing breaks, one surface is missing.
GITHUB_APP_ID=
# The PEM, or the same PEM sealed with VAULT_MASTER_KEY (_ENC). Prefer the
# sealed form: a leaked env file is then not a leaked signing key.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_ENC=
# Unset means the App's webhook endpoint REFUSES every delivery rather than
# trusting it, so the check runs simply never appear.
GITHUB_APP_WEBHOOK_SECRET=
# Signs the plain pull-request webhook (the non-App path).
GITHUB_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
# Password reset and team invites are links that have to reach a person who is
# not looking at the app. Set SMTP_HOST and they are emailed; leave it blank and
# the API writes each message — link included — to its log at info level, so a
# self-hosted install with no mail server still works and says so. There is no
# separate on/off flag: a boolean that can disagree with the host it guards is
# one more way for mail to be silently dead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QAAI <no-reply@example.com>

# ─── Retention ──────────────────────────────────────────────────────────────
# The only switch that makes the artifact sweep DELETE. Anything other than
# `true` and every sweep is a dry run that reports what it would have removed.
QAAI_RETENTION_APPLY=false

# ─── Backups ────────────────────────────────────────────────────────────────
# Set QAAI_BACKUP_DIR and the worker takes a nightly `qaai backup create`
# (pg_dump + manifest — see deploy/backup.md) into a timestamped subdirectory
# there, keeping the newest QAAI_BACKUP_KEEP and deleting older ones only after
# the new one succeeded. Leave it blank and NO backup runs — the worker logs a
# warn line each day saying so, because an unconfigured backup must be loud.
# Point it at a bind mount on storage that does NOT share a disk with the
# postgres volume, and note the caveat in deploy/README.md's unproven list:
# the worker image does not yet ship pg_dump, so an in-container backup fails
# loudly with an install hint until the postgresql-17 client is added to the
# image (running the backup on the host against the published port works today).
QAAI_BACKUP_DIR=
QAAI_BACKUP_KEEP=7

# ─── Observability ──────────────────────────────────────────────────────────
# SENTRY_DSN used to be listed here and forwarded by docker-compose.yml. No
# Sentry SDK exists in this repo, so setting it reported nothing to anyone; it
# has been removed rather than left as a promise nothing keeps.
