{
  "//name": "NOT `qaai` \u2014 that name belongs to packages/cli, the package customers install to run suites from their CI. When both this file and a workspace claimed it, `npm run <script> --workspaces` deduped by name and silently ran 9 of the 10 workspaces: packages/cli was excluded from typecheck, test and every other sweep, and the omission was invisible because the sweep still exited 0. This root is private and never published, so its name is cosmetic; the CLI's is not.",
  "name": "qaai-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "QAAI \u2014 the AI QA engineer",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "check:wiring": "tsx scripts/check-wiring.ts",
    "db:generate": "npm run db:generate -w @qaai/api",
    "db:migrate": "npm run db:migrate -w @qaai/api",
    "db:seed": "npm run db:seed -w @qaai/api",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @qaai/api",
    "dev:worker": "npm run dev -w @qaai/worker",
    "dev:demo": "npm run dev -w @qaai/demo",
    "dev:web": "npm run dev -w @qaai/web",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
