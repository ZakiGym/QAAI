{
  "name": "qaai",
  "private": true,
  "version": "0.1.0",
  "description": "QAAI \u2014 the AI QA engineer",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w @qaai/api",
    "db:migrate": "npm run db:migrate -w @qaai/api",
    "db:seed": "npm run db:seed -w @qaai/api",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @qaai/api",
    "dev:worker": "npm run dev -w @qaai/worker",
    "dev:demo": "npm run dev -w @qaai/demo",
    "dev:web": "npm run dev -w @qaai/web",
    "postinstall": "prisma generate --schema apps/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
