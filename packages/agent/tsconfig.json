{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The crawler's page.evaluate() callbacks are typechecked as browser code
    // even though this package runs on Node, so both libs are needed.
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
