{
  "name": "@qaai/cli",
  "version": "0.1.0",
  "description": "The QAAI command-line client: run suites in your own CI, and back up a self-hosted install.",
  "type": "module",
  "bin": {
    "qaai": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@qaai/shared": "^0.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
