node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo

.env
.env.local
.env.*.local
!.env.example

# Runtime artifacts (screenshots, videos, traces) — these go to S3/MinIO in prod
.artifacts/
playwright-report/
test-results/
.generated/

# Local infra data dirs (docker-compose volumes are named, this is the no-docker path)
.localdev/

.DS_Store
*.log
npm-debug.log*
coverage/
# …but /insights/coverage is a ROUTE, not a coverage report. The unanchored
# pattern above swallowed the whole directory, so the screen behind the first
# Insights tab was never committed — it existed only in working trees where
# somebody had written it. `/insights` now redirects there, so on a fresh clone
# the section's landing page would 404.
!apps/web/app/insights/coverage/

# Ephemeral Playwright workspaces created by the runner
.qaai-runs/

# Prisma client output — regenerate with: npm run db:generate -w @qaai/api
apps/api/src/generated/

# Next.js regenerates this on every build AND on every dev start, and writes a
# DIFFERENT import each time (.next/types vs .next/dev/types). Tracked, it shows
# up as a spurious modification in every diff depending on which ran last — and
# the file itself says "This file should not be edited".
apps/web/next-env.d.ts
