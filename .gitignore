node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo

.env
.env.local
.env.*.local
!.env.example

# Runtime artifacts (screenshots, videos, traces) — these go to S3/MinIO in prod
.artifacts/
playwright-report/
test-results/
.generated/

# Local infra data dirs (docker-compose volumes are named, this is the no-docker path)
.localdev/

.DS_Store
*.log
npm-debug.log*
coverage/
# …but /insights/coverage is a ROUTE, not a coverage report. The unanchored
# pattern above swallowed the whole directory, so the screen behind the first
# Insights tab was never committed — it existed only in working trees where
# somebody had written it. `/insights` now redirects there, so on a fresh clone
# the section's landing page would 404.
!apps/web/app/insights/coverage/

# Ephemeral Playwright workspaces created by the runner
.qaai-runs/

# Prisma client output — regenerate with: npm run db:generate -w @qaai/api
apps/api/src/generated/

# Next.js regenerates this on every build AND on every dev start, and writes a
# DIFFERENT import each time (.next/types vs .next/dev/types). Tracked, it shows
# up as a spurious modification in every diff depending on which ran last — and
# the file itself says "This file should not be edited".
apps/web/next-env.d.ts

# Agent probe scratch: a one-off `it()` that proves a hole exists, a driver that
# calls a function nobody has a caller for. They are written to establish a fact
# and are throwaway by design, NOT durable regression coverage — the test that
# stops a defect returning belongs beside the code it guards.
#
# IGNORED AND NOT DELETED, and the glob is `.probe*` rather than `.probe`
# because the name is not stable: four different spellings appeared in one week
# (.probe, .probe-auth-adversary, .probe-authz-r5, .probe-egress-adv). An ignore
# that matches only the spelling somebody used last time works once.
#
# vitest.config.ts excludes the same glob, for a different reason worth keeping
# separate: one session's scratch put ~29 tests into `npx vitest run` and moved
# the suite count twice, so a number compared against a baseline was comparing
# two denominators. Both lines are needed — this one keeps them out of history,
# that one keeps them out of the count.
.probe*/
.verify-probes/
