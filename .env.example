# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Datastores ──────────────────────────────────────────────────────────────
# docker-compose provides both. For the no-docker local path see README §Local dev.
DATABASE_URL=postgresql://qaai:qaai@localhost:5432/qaai?schema=public
REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Session signing. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-openssl-rand-base64-48
SESSION_TTL_HOURS=72

# ─── Secrets vault (§1) ──────────────────────────────────────────────────────
# AES-256-GCM master key, 32 bytes base64. Generate with: openssl rand -base64 32
# In production this should come from KMS, not env.
VAULT_MASTER_KEY=replace-me-with-openssl-rand-base64-32

# ─── LLM (§0 — all calls route through packages/agent/llm.ts) ────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Cheap model: exploration, triage first-pass. Strong model: generation, ambiguous verdicts.
QAAI_MODEL_CHEAP=claude-haiku-4-5
QAAI_MODEL_STRONG=claude-opus-5
QAAI_LLM_MAX_RETRIES=3
# Hard ceiling per org per calendar month; 0 disables the check.
QAAI_MONTHLY_TOKEN_BUDGET=0

# ─── Artifact storage (S3-compatible; MinIO in docker-compose) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qaai-artifacts
S3_ACCESS_KEY_ID=qaaiminio
S3_SECRET_ACCESS_KEY=qaaiminio
S3_FORCE_PATH_STYLE=true
# When true, artifacts are written to ./.artifacts instead of S3 (no-docker local path).
ARTIFACTS_LOCAL=false

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
# Reuse one Chromium across jobs instead of launching per test. Set to 0 to
# disable pooling entirely (packages/runner/src/browser-pool.ts).
QAAI_BROWSER_POOL=1
QAAI_BROWSER_POOL_MAX=4
QAAI_BROWSER_POOL_IDLE_MS=30000

# Flake automation (apps/worker/src/processors/flake.ts). Set to `off` to stop
# the sweep confirming and quarantining suspects; anything else leaves it on.
QAAI_FLAKE_AUTOMATION=on
QAAI_FLAKE_MAX_INVESTIGATIONS=3

# How long a build bisect may keep enqueuing probe runs before it gives up.
QAAI_BISECT_DEADLINE_MINUTES=60

# ─── Retention (apps/worker/src/processors/retention.ts) ─────────────────────
# The deployment-level opt-in for DESTRUCTIVE sweeps. Unset or anything other
# than `true` means every sweep is a dry run that reports what it would delete
# and deletes nothing. Read once at start-up, so flipping it needs a restart.
QAAI_RETENTION_APPLY=false
# How far past expiry a row must be before it is a candidate, and how long a
# triage decision counts as "someone is still working on this".
QAAI_RETENTION_GRACE_HOURS=24
QAAI_RETENTION_TRIAGE_WINDOW_DAYS=30
QAAI_RETENTION_BATCH_SIZE=500
QAAI_RETENTION_MAX_BATCHES=20

# ─── Demo store (apps/demo) ──────────────────────────────────────────────────
DEMO_PORT=5050
DEMO_PUBLIC_URL=http://localhost:5050
# Flips the planted checkout bug used by the DoD walkthrough (§12.2).
DEMO_PLANTED_BUG=true
DEMO_SMTP_PORT=5051

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── GitHub App (all optional; PR feedback falls back to a PAT comment) ──────
GITHUB_APP_ID=
# The app's PEM. Prefer the _ENC form: the same value sealed with
# VAULT_MASTER_KEY, so a leaked env file is not a leaked signing key. When both
# are set the sealed one wins (apps/api/src/routes/github.ts).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_ENC=
# Signs the App's own webhook deliveries. With this unset, POST
# /webhooks/github-app REFUSES every delivery rather than trusting it — the
# check runs simply never appear.
GITHUB_APP_WEBHOOK_SECRET=
# Signs the plain (non-App) pull-request webhook.
GITHUB_WEBHOOK_SECRET=

# Slack, Linear and Jira are NOT configured here. They are per-organisation
# rows in the Integration table, with their credentials sealed in the vault, so
# two orgs on one install can point at two different Slack workspaces — which an
# env var cannot express. Settings → Integrations is the only place they are set.

# ─── CLI (packages/cli — `qaai run`, `qaai runner`, `qaai backup`) ───────────
# Read by the CLI wherever it runs, which is usually somebody's CI, not this
# .env. Documented here because the flags that override them (--api-url,
# --api-key) are otherwise the only way to discover they exist.
QAAI_API_URL=http://localhost:4000
QAAI_API_KEY=
# The on-prem runner's enrolment token. Passed by env or --token-file, never in
# the runner config file — the CLI refuses a config that contains one.
QAAI_RUNNER_TOKEN=

# ─── Billing (§9) ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# ─── Ops (§11) ───────────────────────────────────────────────────────────────
# Stamped into GET /health and /health/live so a deploy can be identified from
# outside the container. Defaults to the package version.
QAAI_VERSION=

# NOTHING WAS REMOVED FROM THIS FILE LIGHTLY, so here is the list and the reason:
# SENTRY_DSN, POSTHOG_KEY, POSTHOG_HOST, GITHUB_OAUTH_CLIENT_ID/SECRET,
# GOOGLE_OAUTH_CLIENT_ID/SECRET, SLACK_WEBHOOK_URL, LINEAR_API_KEY,
# JIRA_BASE_URL/EMAIL/API_TOKEN and PLAYWRIGHT_BROWSERS were all listed here and
# read by no line of code in this repo. There is no Sentry or PostHog SDK in any
# package.json; there is no OAuth route on authRouter; Slack/Linear/Jira are
# per-org Integration rows; and the variable Playwright actually reads is
# PLAYWRIGHT_BROWSERS_PATH, which the Dockerfiles set. Setting any of them did
# nothing at all, which is worse than not offering them — an operator who set
# SENTRY_DSN believed errors were being reported.
#
# `npm run check:wiring` fails if a variable is added back here without a reader,
# or read anywhere without being documented here.
